enum ComplaintUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintLifecycleStatus {
  ACTIVE
  RESOLVED
  // V4.6.76 Rental Health V1 — richer lifecycle so operators can triage
  // complaints before they either get confirmed (→ feeds rental_blocked
  // if impact=SAFETY) or dismissed. ACTIVE remains the legacy default so
  // historic rows stay valid without a data-migration.
  OPEN
  IN_REVIEW
  CONFIRMED
  REJECTED
  // V4.9.68 — canonical technical observation lifecycle
  NEW
  CONVERTED
  DISMISSED
}

enum ComplaintSource {
  FIELD_AGENT
  MANUAL
  OPERATOR_RETURN
  OPERATOR_HANDOVER
  CUSTOMER_REPORT
  STAFF_INSPECTION
  AI_UPLOAD
  SYSTEM_IMPORT
}

// V4.6.76 Rental Health V1 — impact classification drives the
// rental_blocked gate. A complaint with impact=SAFETY that is currently
// OPEN / IN_REVIEW / CONFIRMED / ACTIVE hard-blocks new bookings.
// DRIVABILITY / ENVIRONMENT / COMFORT only surface as warning state.
// `impact` is nullable so existing rows (pre-migration) stay valid.
enum ComplaintImpact {
  SAFETY
  DRIVABILITY
  ENVIRONMENT
  COMFORT
}

enum TechnicalObservationCategory {
  EXTERIOR
  INTERIOR
  LIGHTS
  WIPERS_WINDOWS
  WHEELS_TIRES
  ELECTRONICS_CONTROLS
  NOISE_VIBRATION
  DRIVING_BEHAVIOR
  COMFORT
  OTHER
}

enum TechnicalObservationAffectedArea {
  FRONT
  REAR
  LEFT
  RIGHT
  INTERIOR
  DASHBOARD
  LIGHTS
  WHEELS
  TIRES
  ENGINE_BAY
  TRUNK
  UNKNOWN
}

/// Canonical finding lifecycle (VW WP-02) — bridges domain alerts without replacing them yet.
enum VehicleFindingStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  SUPERSEDED
  EXPIRED
}

enum VehicleFindingSourceType {
  TIRE_ALERT
  BRAKE_ALERT
  BATTERY_ALERT
  DTC
  COMPLAINT
  INSIGHT
  CONNECTIVITY
  OTHER
}

model VehicleComplaint {
  id                   String                            @id @default(uuid())
  organizationId       String                            @map("organization_id")
  vehicleId            String                            @map("vehicle_id")
  createdByUserId      String?                           @map("created_by_user_id")
  createdByWorkerId    String?                           @map("created_by_worker_id")
  title                String?
  description          String
  urgency              ComplaintUrgency                  @default(MEDIUM)
  region               String?
  category             TechnicalObservationCategory?
  affectedArea         TechnicalObservationAffectedArea? @map("affected_area")
  status               ComplaintLifecycleStatus          @default(ACTIVE)
  source               ComplaintSource                   @default(MANUAL)
  // V4.6.76 Rental Health V1 — nullable so existing rows migrate
  // without backfill; Rental-Health evaluator treats null as "no impact
  // classification", which keeps the legacy complaint severity (urgency)
  // out of the rental_blocked gate.
  impact               ComplaintImpact?
  blocksRental         Boolean                           @default(false) @map("blocks_rental")
  bookingId            String?                           @map("booking_id")
  customerId           String?                           @map("customer_id")
  driverId             String?                           @map("driver_id")
  handoverProtocolId   String?                           @map("handover_protocol_id")
  stationId            String?                           @map("station_id")
  locationContext      String?                           @map("location_context")
  resolvedAt           DateTime?                         @map("resolved_at")
  resolvedByUserId     String?                           @map("resolved_by_user_id")
  dismissedAt          DateTime?                         @map("dismissed_at")
  dismissedByUserId    String?                           @map("dismissed_by_user_id")
  convertedToTaskId    String?                           @map("converted_to_task_id")
  linkedDamageId       String?                           @map("linked_damage_id")
  linkedServiceEventId String?                           @map("linked_service_event_id")
  linkedServiceCaseId  String?                           @map("linked_service_case_id")
  linkedServiceTaskId  String?                           @map("linked_service_task_id")
  notes                String?
  /// Idempotency key for create dedupe (VW-F-025).
  dedupeKey            String?                           @map("dedupe_key")
  createdAt            DateTime                          @default(now()) @map("created_at")
  updatedAt            DateTime                          @updatedAt @map("updated_at")

  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([organizationId])
  @@index([organizationId, vehicleId, status])
  @@index([bookingId])
  @@index([organizationId, dedupeKey])
  @@map("vehicle_complaints")
}

model VehicleFinding {
  id             String                   @id @default(uuid())
  organizationId String                   @map("organization_id")
  vehicleId      String?                  @map("vehicle_id")
  sourceType     VehicleFindingSourceType @map("source_type")
