// ------------------------------------------------
// BOOKING DOCUMENT LIFECYCLE
// ------------------------------------------------
// Central document engine: business modules (bookings, invoices, handover)
// own the data; these models own document rendering metadata, uploaded legal
// versions, and the per-booking bundle that tracks which documents exist.
// Status fields use plain strings (values documented inline) to keep the
// migration small and consistent with other recent additions. Cross-entity
// Booking/Customer/Vehicle/Invoice/Handover links on GeneratedDocument stay scalar.
// Legal snapshot pointers on BookingDocumentBundle and RentalContract use explicit
// relations to GeneratedDocument with onDelete: SetNull (historical evidence preserved).

model GeneratedDocument {
  id                   String       @id @default(uuid())
  organizationId       String       @map("organization_id")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType         String       @map("document_type") // BOOKING_INVOICE, … CONSUMER_INFORMATION, PRIVACY_POLICY (+ legacy)
  legalVariant         String?      @map("legal_variant")
  origin               String       @default("GENERATED") // GENERATED, STATIC_LEGAL, UPLOADED_REFERENCE
  status               String       @default("GENERATED") // DRAFT, GENERATED, SENT, VOID, FAILED
  bookingId            String?      @map("booking_id")
  customerId           String?      @map("customer_id")
  vehicleId            String?      @map("vehicle_id")
  invoiceId            String?      @map("invoice_id")
  handoverProtocolId   String?      @map("handover_protocol_id")
  rentalContractId     String?      @map("rental_contract_id")
  depositId            String?      @map("deposit_id")
  legalDocumentId      String?      @map("legal_document_id")
  title                String
  documentNumber       String?      @map("document_number")
  fileName             String       @map("file_name")
  mimeType             String       @default("application/pdf") @map("mime_type")
  storageProvider      String       @default("local") @map("storage_provider")
  objectKey            String       @map("object_key")
  sizeBytes            Int?         @map("size_bytes")
  checksum             String?
  templateKey          String?      @map("template_key")
  templateVersion      String?      @map("template_version")
  legalVersionLabel    String?      @map("legal_version_label")
  generatedAt          DateTime?    @map("generated_at")
  generatedByUserId    String?      @map("generated_by_user_id")
  sentAt               DateTime?    @map("sent_at")
  signedAt             DateTime?    @map("signed_at")
  voidedAt             DateTime?    @map("voided_at")
  metadata             Json?
  snapshot             Json?
  retentionClass       String       @default("BOOKING_SNAPSHOT") @map("retention_class")
  retainUntil          DateTime?    @map("retain_until")
  legalHold            Boolean      @default(false) @map("legal_hold")
  legalHoldReason      String?      @map("legal_hold_reason")
  legalHoldSetAt       DateTime?    @map("legal_hold_set_at")
  legalHoldSetByUserId String?      @map("legal_hold_set_by_user_id")
  deletionEligibleAt   DateTime?    @map("deletion_eligible_at")
  deletedAt            DateTime?    @map("deleted_at")
  storagePurgedAt      DateTime?    @map("storage_purged_at")
  storagePurgeError    String?      @map("storage_purge_error")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  outboundEmailAttachments            OutboundEmailAttachment[]
  activeForInvoice                    OrgInvoice?                     @relation("InvoiceActiveDocument")
  invoiceRecord                       OrgInvoice?                     @relation("InvoiceDocuments", fields: [invoiceId], references: [id], onDelete: SetNull)
  bookingBundlesAsTermsDocument       BookingDocumentBundle[]         @relation("BookingBundleTermsDocument")
  bookingBundlesAsWithdrawalDocument  BookingDocumentBundle[]         @relation("BookingBundleWithdrawalDocument")
  bookingBundlesAsPrivacyDocument     BookingDocumentBundle[]         @relation("BookingBundlePrivacyDocument")
  rentalContractsAsTermsDocument      RentalContract[]                @relation("RentalContractTermsDocument")
  rentalContractsAsWithdrawalDocument RentalContract[]                @relation("RentalContractWithdrawalDocument")
  rentalContractsAsPrivacyDocument    RentalContract[]                @relation("RentalContractPrivacyDocument")
  legalDocumentDeliveryEvidence       LegalDocumentDeliveryEvidence[]

  @@index([organizationId])
  @@index([bookingId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([invoiceId])
  @@index([documentType])
  @@index([status])
  @@index([organizationId, retentionClass, deletionEligibleAt], map: "generated_documents_org_retention_eligible_idx")
  @@index([organizationId, legalHold], map: "generated_documents_org_legal_hold_idx")
  @@map("generated_documents")
}

model OrganizationLegalDocument {
  id                         String                @id @default(uuid())
  organizationId             String                @map("organization_id")
  organization               Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType               String                @map("document_type") // TERMS_AND_CONDITIONS, CONSUMER_INFORMATION, PRIVACY_POLICY (+ legacy values)
  legalVariant               String?               @map("legal_variant") // CONSUMER_INFORMATION variants only
  title                      String
  versionLabel               String                @map("version_label")
  language                   String                @default("de")
  status                     String                @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, SCHEDULED, ACTIVE, SUPERSEDED, REVOKED, ARCHIVED
  fileName                   String                @map("file_name")
  mimeType                   String                @default("application/pdf") @map("mime_type")
  storageProvider            String                @default("local") @map("storage_provider")
  objectKey                  String                @map("object_key")
  checksum                   String?
  sizeBytes                  Int?                  @map("size_bytes")
  validFrom                  DateTime?             @map("valid_from")
  validUntil                 DateTime?             @map("valid_until")
  jurisdictionCountry        String                @default("DE") @map("jurisdiction_country") // ISO 3166-1 alpha-2
  customerSegment            LegalCustomerSegment  @default(BOTH) @map("customer_segment")
  bookingChannel             LegalBookingChannel   @default(ALL) @map("booking_channel")
  productScope               BusinessType?         @map("product_scope") // null = all business types
  stationScopeMode           LegalStationScopeMode @default(ORGANIZATION_WIDE) @map("station_scope_mode")
  priority                   Int                   @default(0)
  isMandatory                Boolean               @default(true) @map("is_mandatory")
  noticePurpose              LegalNoticePurpose    @default(GENERAL_NOTICE) @map("notice_purpose")
  submittedForReviewAt       DateTime?             @map("submitted_for_review_at")
  submittedForReviewByUserId String?               @map("submitted_for_review_by_user_id")
  approvedAt                 DateTime?             @map("approved_at")
  approvedByUserId           String?               @map("approved_by_user_id")
  activatedAt                DateTime?             @map("activated_at")
  activatedByUserId          String?               @map("activated_by_user_id")
  revokedAt                  DateTime?             @map("revoked_at")
  revokedByUserId            String?               @map("revoked_by_user_id")
  statusReason               String?               @map("status_reason")
  changeSummary              String?               @map("change_summary")
  legalOwnerName             String?               @map("legal_owner_name")
  uploadedByUserId           String?               @map("uploaded_by_user_id")
  scanStatus                 String                @default("UPLOADED") @map("scan_status")
  pageCount                  Int?                  @map("page_count")
  validationErrorCode        String?               @map("validation_error_code")
  validationErrorDetail      String?               @map("validation_error_detail")
  validatedAt                DateTime?             @map("validated_at")
  malwareScannedAt           DateTime?             @map("malware_scanned_at")
  malwareScannerId           String?               @map("malware_scanner_id")
  malwareEngineVersion       String?               @map("malware_engine_version")
  malwareThreatName          String?               @map("malware_threat_name")
  malwareScanDetail          String?               @map("malware_scan_detail")
  malwareScanAttempts        Int?                  @default(0) @map("malware_scan_attempts")
  quarantineObjectKey        String?               @map("quarantine_object_key")
  integrityStatus            String                @default("UNVERIFIED") @map("integrity_status")
  integrityCheckedAt         DateTime?             @map("integrity_checked_at")
  integrityDetail            String?               @map("integrity_detail")
  integrityUnavailable       Boolean               @default(false) @map("integrity_unavailable")
  retentionClass             String                @default("LEGAL_MASTER") @map("retention_class")
  retainUntil                DateTime?             @map("retain_until")
  legalHold                  Boolean               @default(false) @map("legal_hold")
  legalHoldReason            String?               @map("legal_hold_reason")
  legalHoldSetAt             DateTime?             @map("legal_hold_set_at")
  legalHoldSetByUserId       String?               @map("legal_hold_set_by_user_id")
  deletionEligibleAt         DateTime?             @map("deletion_eligible_at")
  deletedAt                  DateTime?             @map("deleted_at")
  storagePurgedAt            DateTime?             @map("storage_purged_at")
  storagePurgeError          String?               @map("storage_purge_error")
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")

  events           OrganizationLegalDocumentEvent[]
  deliveryEvidence LegalDocumentDeliveryEvidence[]
  stations         OrganizationLegalDocumentStation[]

  // Scope-aware ACTIVE uniqueness is enforced via conflict detection at activation
  // (Prompt 7/32) — legacy partial index `organization_legal_documents_single_active_key`
  // is dropped in migration 20260722150000.

  @@index([organizationId])
  @@index([organizationId, documentType, status], map: "organization_legal_documents_org_type_status_idx")
  @@index([organizationId, documentType, language, status], map: "organization_legal_documents_org_type_lang_status_idx")
  @@index([organizationId, documentType, legalVariant], map: "organization_legal_documents_org_type_variant_idx")
  @@index([organizationId, status, documentType, language, jurisdictionCountry, customerSegment, bookingChannel], map: "organization_legal_documents_resolver_scope_idx")
  @@index([organizationId, scanStatus], map: "organization_legal_documents_org_scan_status_idx")
  @@index([organizationId, integrityStatus], map: "organization_legal_documents_org_integrity_status_idx")
  @@index([organizationId, retentionClass, deletionEligibleAt], map: "organization_legal_documents_org_retention_eligible_idx")
  @@index([organizationId, legalHold], map: "organization_legal_documents_org_legal_hold_idx")
  @@map("organization_legal_documents")
}

/// Normalized station scope for legal documents (STATION_SPECIFIC mode only).
model OrganizationLegalDocumentStation {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  legalDocumentId String   @map("legal_document_id")
  stationId       String   @map("station_id")
  createdAt       DateTime @default(now()) @map("created_at")

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalDocument OrganizationLegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)
  station       Station                   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([legalDocumentId, stationId], map: "organization_legal_document_stations_doc_station_key")
  @@index([organizationId, stationId], map: "organization_legal_document_stations_org_station_idx")
  @@index([legalDocumentId], map: "organization_legal_document_stations_doc_idx")
  @@map("organization_legal_document_stations")
}

/// Append-only audit log for organization legal document lifecycle transitions.
