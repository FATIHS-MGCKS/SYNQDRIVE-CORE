// ── Trip Repair / Reconciliation Audit Trail ──────────────────────────────────
//
// Records every proposed or applied repair action taken by the reconciliation
// and repair layer. Provides full auditable history of what changed and why.
// The repair layer may never directly create trips — it always goes through
// TripDecisionEngine, which stamps tripSource: REPAIRED on the resulting trip.

/// Audit record for one repair action proposed or applied by the reconciliation layer.
model TripRepair {
  id        String  @id @default(uuid())
  vehicleId String  @map("vehicle_id")
  // Linked to an existing trip when repairing an end-time or merge.
  // Null when creating a brand-new trip from a gap.
  tripId    String? @map("trip_id")

  // MISSING_TRIP | MISSING_END | SPLIT_MERGE | DUPLICATE | STALE_ONGOING
  repairType String   @map("repair_type")
  // PROPOSED | APPLIED | REJECTED | EXPIRED | SUPPRESSED
  // SUPPRESSED records a proposal that was evaluated and withheld as already
  // represented. It is written before the suppression decision takes effect, so
  // withheld proposals leave the same audit trail as accepted ones.
  status     String   @default("PROPOSED")
  reason     String
  // LOW | MEDIUM | HIGH
  confidence String
  windowFrom DateTime @map("window_from")
  windowTo   DateTime @map("window_to")

  // Full detector evidence payload (findings array from all detectors that ran)
  detectorEvidence Json?     @map("detector_evidence")
  appliedAt        DateTime? @map("applied_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  vehicle Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trip    VehicleTrip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([tripId])
  @@index([status])
  @@index([repairType])
  @@index([createdAt])
  @@map("trip_repairs")
}

// ── Driving Impact Engine V1 ──────────────────────────────────────────────────
//
// These two models form the shared normalization layer between
// HF post-trip enrichment and the Tire Health / Brake Health modules.
// Neither Tire nor Brake stores driving aggressiveness on their own tables;
// they read from these shared structures instead.

/// One row per finalized trip. Computed after HF enrichment, never overwritten.
model TripDrivingImpact {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  vehicleId      String    @map("vehicle_id")
  tripId         String    @unique @map("trip_id")
  tripStartedAt  DateTime  @map("trip_started_at")
  tripEndedAt    DateTime? @map("trip_ended_at")
  distanceKm     Float     @map("distance_km")

  // Usage split (from VehicleTrip city/highway/country percent fields)
  citySharePct        Float? @map("city_share_pct")
  highwaySharePct     Float? @map("highway_share_pct")
  countryRoadSharePct Float? @map("country_road_share_pct")

  // Normalized per-100 km event rates
  hardAccelPer100Km    Float? @map("hard_accel_per_100km")
  extremeAccelPer100Km Float? @map("extreme_accel_per_100km")
  hardBrakePer100Km    Float? @map("hard_brake_per_100km")
  extremeBrakePer100Km Float? @map("extreme_brake_per_100km")
  fullBrakingPer100Km  Float? @map("full_braking_per_100km")
  kickdownPer100Km     Float? @map("kickdown_per_100km")
  launchLikePer100Km   Float? @map("launch_like_per_100km")

  // Braking behavior metrics (derived from TripBehaviorEvent rows)
  brakesPer100Km            Float? @map("brakes_per_100km")
  stopDensity               Float? @map("stop_density")
  highSpeedBrakeShare       Float? @map("high_speed_brake_share")
  meanBrakeEnergyPerKm      Float? @map("mean_brake_energy_per_km")
  p95NegativeDecel          Float? @map("p95_negative_decel")
  // P42 — measured/reconstructed vs ESTIMATED_PROXY braking kinematics (nullable for legacy rows)
  p95NegativeDecelMeasured  Float? @map("p95_negative_decel_measured")
  p95NegativeDecelProxy     Float? @map("p95_negative_decel_proxy")
  meanBrakeEnergyProxyPerKm Float? @map("mean_brake_energy_proxy_per_km")

  // Normalized stress scores 0–100
  longitudinalStressScore Float? @map("longitudinal_stress_score")
  brakingStressScore      Float? @map("braking_stress_score")
  stopGoStressScore       Float? @map("stop_go_stress_score")
  highSpeedStressScore    Float? @map("high_speed_stress_score")
  thermalBrakeStressScore Float? @map("thermal_brake_stress_score")
  /// Composite vehicle stress / Fahrbelastung (0–100). Higher = more load/stress, NOT driver quality.
  /// DB column kept as `driving_style_score` for non-destructive rename (V4.8.24).
  drivingStressScore      Float? @map("driving_style_score")
  /// @deprecated Retired from rental surfaces; no longer written on recompute. Column retained for history.
  safetyScore             Float? @map("safety_score")
  speedingExposurePct     Float? @map("speeding_exposure_pct")
  // V4.6.95 — `speedingSeverityScore` was deprecated in V4.6.83 (no consumer
  // ever read it; canonical speeding-related scalar is `safetyScore`). The
  // column is now dropped via the V4.6.95 migration to remove the dead path.
  speedingSectionCount    Int?   @map("speeding_section_count")

  // Traceability
  modelVersion      String @map("model_version")
  sourceSummaryJson Json?  @map("source_summary_json")

  // P41 — source provenance (nullable for legacy rows; readers use driving-impact-provenance.reader)
  primarySource           String? @map("primary_source")
  measuredShare           Float?  @map("measured_share")
  providerClassifiedShare Float?  @map("provider_classified_share")
  reconstructedShare      Float?  @map("reconstructed_share")
  estimatedProxyShare     Float?  @map("estimated_proxy_share")
  contextOnlyShare        Float?  @map("context_only_share")
  nativeEventCount        Int?    @map("native_event_count")
  hfEventCount            Int?    @map("hf_event_count")
  measurementCoverage     Float?  @map("measurement_coverage")
  hardwareProfile         String? @map("hardware_profile")
  capabilityVersion       String? @map("capability_version")
  healthEligibility       String? @map("health_eligibility")
  provenanceMaturity      String? @map("provenance_maturity")
  provenanceVersion       String? @map("provenance_version")

  // P43 — structured vehicle load components (nullable for legacy rows)
  loadComponentsJson Json? @map("load_components_json")

  /// Canonical distance used by brake/tire wear models (from finalized VehicleTrip.distanceKm).
  authoritativeDistanceKm Float?                          @map("authoritative_distance_km")
  /// Model version + distance policy version fingerprinted together.
  sourceVersion           String?                         @map("source_version")
  /// Deterministic hash of trip inputs — idempotent recompute guard.
  sourceFingerprint       String?                         @map("source_fingerprint")
  analysisStatus          TripDrivingImpactAnalysisStatus @default(PENDING) @map("analysis_status")
  calculatedAt            DateTime?                       @map("calculated_at") @db.Timestamptz(6)
  /// 0–1 score of input completeness (behavior events, usage split, etc.).
  sourceCompleteness      Float?                          @map("source_completeness")
  /// Snapshot of VehicleTrip.distanceKm at compute time for drift detection.
  tripDistanceKmAtSource  Float?                          @map("trip_distance_km_at_source")
  /// |trip.distanceKm − authoritativeDistanceKm| when stale.
  distanceDiscrepancyKm   Float?                          @map("distance_discrepancy_km")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, tripStartedAt])
  @@index([organizationId, vehicleId])
  @@index([analysisStatus])
  @@index([sourceFingerprint])
  @@map("trip_driving_impact")
}

/// Unified analysis status for TripDrivingImpact coverage (Prompt 13).
enum TripDrivingImpactAnalysisStatus {
  PENDING
  COMPLETE
  PARTIAL
  UNSUPPORTED
  FAILED
  STALE
}

