  vehicleId        String   @map("vehicle_id")
  trigger          String
  forced           Boolean  @default(false)
  forceReason      String?  @map("force_reason")
  actorId          String?  @map("actor_id")
  inputFingerprint String?  @map("input_fingerprint")
  result           String
  skipReason       String?  @map("skip_reason")
