  rentalDrivingAnalysesAsAssignedDriver  RentalDrivingAnalysis[]         @relation("RentalAnalysisAssignedDriver")
  rentalDrivingAnalysesAsActualDriver    RentalDrivingAnalysis[]         @relation("RentalAnalysisActualDriver")
  rentalDrivingAnalysesLegacyDriver      RentalDrivingAnalysis[]         @relation("RentalAnalysisLegacyDriver")
  documents                              CustomerDocument[]
