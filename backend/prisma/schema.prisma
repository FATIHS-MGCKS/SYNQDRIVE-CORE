model VoiceConversation {
  id               String          @id @default(uuid())
  organizationId   String          @map("organization_id")
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voiceAssistantId String?         @map("voice_assistant_id")
  voiceAssistant   VoiceAssistant? @relation(fields: [voiceAssistantId], references: [id], onDelete: SetNull)

  providerConversationId String?                         @map("provider_conversation_id")
  elevenLabsConvId       String?                         @map("elevenlabs_conv_id")
  twilioCallSid          String?                         @map("twilio_call_sid")
  providerAgentId        String?                         @map("provider_agent_id")
  callerNumber           String?                         @map("caller_number")
  direction              VoiceConversationDirection      @default(INBOUND)
  durationSeconds        Int?                            @map("duration_seconds")
  status                 VoiceConversationStatus         @default(COMPLETED)
  lifecycleState         VoiceConversationLifecycleState @default(CREATED) @map("lifecycle_state")
  outcome                VoiceConversationOutcome        @default(PENDING)
  transcript             String?                         @db.Text
  summary                String?
  escalationReason       String?                         @map("escalation_reason")
  actionsPerformed       String[]                        @map("actions_performed")
  errorMessage           String?                         @map("error_message")
  metadata               Json?

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")
