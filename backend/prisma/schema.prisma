  customer     Customer?           @relation("DriverAttributionBookingCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  driver       Customer?           @relation("DriverAttributionDriver", fields: [driverId], references: [id], onDelete: SetNull)
