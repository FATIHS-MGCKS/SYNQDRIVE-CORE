  @@index([organizationId, vehicleId], map: "tire_ds4_shadow_input_org_vehicle_idx")
  @@index([tripId], map: "tire_ds4_shadow_input_trip_idx")
  @@index([tireSetupId], map: "tire_ds4_shadow_input_setup_idx")
  @@map("tire_ds4_motion_shadow_input_v1")
}

/// Tire Wear V3 P3A distance-prior shadow output (not read by productive tire health / V2).
model TireWearV3PriorShadowV1 {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  vehicleId        String   @map("vehicle_id")
