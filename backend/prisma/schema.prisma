// =================================================================
// HIGH MOBILITY — Compatibility Matrix (V4.6.77)
// Internal Master-Admin compatibility intelligence for Health APP and
// Telemetry APP. Brand + model + model-year → signal coverage, app
// suitability, onboarding mode. Reusable later for landing-page
// compatibility checker, onboarding assistance, and feature gating.
// App status is computed deterministically from signal coverage in
// the service; the optional *AppStatus / overallStatus columns are
// manual override/cache slots for rare edge cases.
// =================================================================

enum HmCompatibilityEligibilityMode {
  AVAILABLE
  NOT_AVAILABLE
  SUPPORT_REQUEST
  VIN_DEPENDENT
}

enum HmCompatibilityOnboardingMode {
  PRECHECK_CONNECT
  DIRECT_CONNECT
  MANUAL_REVIEW
}

enum HmCompatibilityAppStatus {
  SUPPORTED
  PARTIAL
  NOT_RECOMMENDED
}

enum HmCompatibilityOverall {
  GOOD
  LIMITED
  WEAK
}

enum HmCompatibilityConfidence {
  HIGH
  MEDIUM
  LOW
}

enum HmCompatibilityApp {
  HEALTH
  TELEMETRY
}

enum HmSignalCoverage {
  CONFIRMED
  EXPECTED
  UNVERIFIED
  MISSING
}

model HighMobilityCompatibilityRecord {
  id               String  @id @default(uuid())
  // Normalized lowercase brand (aligned with high-mobility-oem-routing.normalizeToHmBrand)
  brand            String
  // Original/preferred display form (e.g. "Volkswagen", "Mercedes-Benz")
  brandDisplayName String  @map("brand_display_name")
  // Normalized lowercase model key (e.g. "golf", "a-class")
  model            String
  // Original/preferred display form (e.g. "Golf", "A-Class")
  modelDisplayName String  @map("model_display_name")
  modelYearFrom    Int?    @map("model_year_from")
  modelYearTo      Int?    @map("model_year_to")
  // Free-form support basis note (e.g. "MY 2019+", "from Nov 2020")
  supportFromText  String? @map("support_from_text")

  eligibilityMode HmCompatibilityEligibilityMode @map("eligibility_mode")
  onboardingMode  HmCompatibilityOnboardingMode  @map("onboarding_mode")

  // Optional manual override/cache — when null, the service derives these
  // from signal coverage (Product rule 2: derive from signal groups, not OEM name).
  healthAppStatus    HmCompatibilityAppStatus? @map("health_app_status")
  telemetryAppStatus HmCompatibilityAppStatus? @map("telemetry_app_status")
  overallStatus      HmCompatibilityOverall?   @map("overall_status")

  supportSource  String?                   @map("support_source")
  confidence     HmCompatibilityConfidence @default(MEDIUM)
  notes          String?
  lastReviewedAt DateTime?                 @map("last_reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  signals HighMobilityCompatibilitySignal[]

  @@unique([brand, model, modelYearFrom, modelYearTo], name: "uq_hm_compat_record")
  @@index([brand])
  @@index([brand, model])
  @@index([eligibilityMode])
  @@map("hm_compatibility_records")
}

model HighMobilityCompatibilitySignal {
  id                    String @id @default(uuid())
  compatibilityRecordId String @map("compatibility_record_id")

  app         HmCompatibilityApp
  // Stable machine key (e.g. "odometer", "gps_latitude") — used for de-duplication + API grouping
  signalKey   String             @map("signal_key")
  // Human-readable label (e.g. "Odometer")
  signalLabel String             @map("signal_label")
  // Product-oriented signal group (e.g. "Core Metrics", "Energy", "Location")
  signalGroup String             @map("signal_group")

  required     Boolean                   @default(true)
  coverage     HmSignalCoverage
  confidence   HmCompatibilityConfidence @default(MEDIUM)
  notes        String?
  displayOrder Int                       @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  record HighMobilityCompatibilityRecord @relation(fields: [compatibilityRecordId], references: [id], onDelete: Cascade)

  @@unique([compatibilityRecordId, app, signalKey], name: "uq_hm_compat_signal")
  @@index([compatibilityRecordId])
  @@index([app])
  @@index([coverage])
  @@map("hm_compatibility_signals")
}

// ── Communication Center canonical persistence (C1) ──
// Operational envelope + cross-channel timeline projection.
// Provider-native tables (WhatsAppConversation, VoiceConversation, etc.) remain authoritative.

/// Cross-channel operational medium — not provider identity.
enum CommunicationChannel {
  WHATSAPP
  VOICE
  SMS
  EMAIL
}

/// Canonical operational conversation state (projection-only).
/// Does not replace WhatsAppConversationStatus or VoiceConversationLifecycleState.
enum CommunicationConversationStatus {
  AI_ACTIVE
  WAITING_CUSTOMER
  HUMAN_REQUIRED
  HUMAN_ACTIVE
  RESOLVED
  FAILED
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum CommunicationActorType {
  CUSTOMER
  AI_AGENT
  USER
  SYSTEM
  PROVIDER
}

/// Infrastructure provider identity at event level — channel-agnostic integrations.
enum CommunicationProviderIdentity {
  META_WHATSAPP
  SENT_DM
  TWILIO
  ELEVENLABS
  RESEND
}

enum CommunicationEventType {
  MESSAGE_RECEIVED
  MESSAGE_SENT
  MESSAGE_DELIVERED
  MESSAGE_READ
  MESSAGE_FAILED
  CALL_STARTED
  CALL_CONNECTED
  CALL_ENDED
  CALL_FAILED
  AI_INTENT_DETECTED
  AI_ACTION_STARTED
  AI_ACTION_COMPLETED
  AI_ACTION_FAILED
  HUMAN_REQUIRED
  HUMAN_ASSIGNED
  HUMAN_TAKEOVER
  CONVERSATION_RESOLVED
  CONVERSATION_REOPENED
  PROVIDER_ERROR
}

/// Provider-neutral canonical message content type (C7.2).
enum CommunicationMessageContentType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  CONTACT
  MIXED
  UNSUPPORTED
}

model CommunicationConversation {
  id                   String                          @id @default(uuid())
  organizationId       String                          @map("organization_id")
  channel              CommunicationChannel
  /// Authoritative native row id (WhatsAppConversation.id, VoiceConversation.id, …).
  nativeConversationId String                          @map("native_conversation_id")
  status               CommunicationConversationStatus @default(AI_ACTIVE)
  customerId           String?                         @map("customer_id")
  bookingId            String?                         @map("booking_id")
  vehicleId            String?                         @map("vehicle_id")
  stationId            String?                         @map("station_id")
  assignedUserId       String?                         @map("assigned_user_id")
  /// Opaque agent reference — no brittle FK across AI provider models.
  assignedAgentRef     String?                         @map("assigned_agent_ref")
  assignedAgentType    String?                         @map("assigned_agent_type")
  lastActivityAt       DateTime                        @default(now()) @map("last_activity_at")
  unreadCount          Int                             @default(0) @map("unread_count")
  /// Bounded plain-text preview of latest canonical message content (C7.2).
  lastMessagePreview   String?                         @map("last_message_preview")
  lastContentAt        DateTime?                       @map("last_content_at")
  lastContentId        String?                         @map("last_content_id")
  metadata             Json?
  createdAt            DateTime                        @default(now()) @map("created_at")
  updatedAt            DateTime                        @updatedAt @map("updated_at")

  organization    Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer?                     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  booking         Booking?                      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  vehicle         Vehicle?                      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  station         Station?                      @relation(fields: [stationId], references: [id], onDelete: SetNull)
  /// Human handoff assignee — canonical User.id; org membership validated at service boundary.
  assignedUser    User?                         @relation("CommunicationConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  events          CommunicationEvent[]
  messageContents CommunicationMessageContent[]
  replyCommands   CommunicationReplyCommand[]
  attachments     CommunicationAttachment[]

  @@unique([organizationId, channel, nativeConversationId], name: "communication_conversations_org_channel_native")
  @@index([organizationId, lastActivityAt])
  @@index([organizationId, status, lastActivityAt])
  @@index([organizationId, channel, lastActivityAt])
  @@index([organizationId, stationId, lastActivityAt])
  @@index([organizationId, assignedUserId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, bookingId])
  @@index([organizationId, vehicleId])
  @@map("communication_conversations")
}

/// Append-oriented canonical timeline row — metadata-minimal, no raw provider payloads.
model CommunicationEvent {
  id                 String                         @id @default(uuid())
  organizationId     String                         @map("organization_id")
  conversationId     String                         @map("conversation_id")
  channel            CommunicationChannel
  eventType          CommunicationEventType         @map("event_type")
  direction          CommunicationDirection?
  providerIdentity   CommunicationProviderIdentity? @map("provider_identity")
  /// Stable provider webhook/event identifier for dedupe (distinct from message id).
  providerEventId    String?                        @map("provider_event_id")
  /// Provider message identifier — multiple delivery lifecycle events may share this.
  providerMessageId  String?                        @map("provider_message_id")
  /// Canonical idempotency key for projection upsert (computed at ingest in C3+).
  idempotencyKey     String?                        @map("idempotency_key")
  actorType          CommunicationActorType?        @map("actor_type")
  actorId            String?                        @map("actor_id")
  customerId         String?                        @map("customer_id")
  bookingId          String?                        @map("booking_id")
  vehicleId          String?                        @map("vehicle_id")
  occurredAt         DateTime                       @map("occurred_at")
  metadata           Json?
  redactedPayloadRef String?                        @map("redacted_payload_ref")
  createdAt          DateTime                       @default(now()) @map("created_at")

  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   CommunicationConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer       Customer?                    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  booking        Booking?                     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  vehicle        Vehicle?                     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  messageContent CommunicationMessageContent?

  @@unique([organizationId, idempotencyKey], name: "communication_events_org_idempotency_key")
  @@unique([organizationId, channel, providerIdentity, providerEventId], name: "communication_events_org_provider_event")
  @@index([organizationId, conversationId, occurredAt])
  @@index([organizationId, eventType, occurredAt])
  @@index([organizationId, channel, occurredAt])
  @@index([organizationId, providerMessageId])
  @@map("communication_events")
}

/// Canonical provider-neutral message body projection (C7.2).
/// One logical message per MESSAGE_RECEIVED / MESSAGE_SENT canonical event.
model CommunicationMessageContent {
  id                   String                          @id @default(uuid())
  organizationId       String                          @map("organization_id")
  conversationId       String                          @map("conversation_id")
  communicationEventId String                          @unique @map("communication_event_id")
  channel              CommunicationChannel
  direction            CommunicationDirection
  providerIdentity     CommunicationProviderIdentity?  @map("provider_identity")
  providerMessageId    String?                         @map("provider_message_id")
  /// Native message row id (WhatsAppMessage.id / SmsMessage.id) for backfill matching.
  nativeMessageId      String                          @map("native_message_id")
  contentType          CommunicationMessageContentType @map("content_type")
  text                 String?
  truncated            Boolean                         @default(false)
  hasAttachments       Boolean                         @default(false) @map("has_attachments")
  attachmentCount      Int                             @default(0) @map("attachment_count")
  occurredAt           DateTime                        @map("occurred_at")
  idempotencyKey       String                          @map("idempotency_key")
  contentPurgedAt      DateTime?                       @map("content_purged_at")
  createdAt            DateTime                        @default(now()) @map("created_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  event        CommunicationEvent        @relation(fields: [communicationEventId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey], name: "communication_message_contents_org_idempotency")
  @@index([organizationId, conversationId, occurredAt])
  @@index([organizationId, channel, nativeMessageId])
  @@index([organizationId, occurredAt, contentPurgedAt])
  @@map("communication_message_contents")
}

enum CommunicationReplySendState {
  PENDING
  ACCEPTED
  FAILED
  UNKNOWN
}

enum CommunicationReplyContentType {
  TEXT
  IMAGE
  DOCUMENT
  TEMPLATE
}

enum CommunicationAttachmentState {
  UPLOADING
  READY
  FAILED
  PURGED
}

enum CommunicationAttachmentMediaType {
  IMAGE
  DOCUMENT
}

/// Durable canonical outbound reply idempotency (C11.2).
model CommunicationReplyCommand {
  id                       String                        @id @default(uuid())
  organizationId           String                        @map("organization_id")
  conversationId           String                        @map("conversation_id")
  clientIdempotencyKey     String                        @map("client_idempotency_key")
  text                     String                        @default("")
  contentType              CommunicationReplyContentType @default(TEXT) @map("content_type")
  attachmentId             String?                       @map("attachment_id")
  templateId               String?                       @map("template_id")
  templateVariables        Json?                         @map("template_variables")
  payloadHash              String?                       @map("payload_hash")
  channel                  CommunicationChannel
  sendState                CommunicationReplySendState   @default(PENDING) @map("send_state")
  nativeMessageId          String?                       @map("native_message_id")
  canonicalEventId         String?                       @map("canonical_event_id")
  failureCode              String?                       @map("failure_code")
  actorUserId              String                        @map("actor_user_id")
  processingLeaseExpiresAt DateTime?                     @map("processing_lease_expires_at")
  contentPurgedAt          DateTime?                     @map("content_purged_at")
  createdAt                DateTime                      @default(now()) @map("created_at")
  updatedAt                DateTime                      @updatedAt @map("updated_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, conversationId, clientIdempotencyKey], name: "communication_reply_commands_org_conversation_key")
  @@index([organizationId, conversationId, createdAt])
  @@index([organizationId, sendState, createdAt])
  @@map("communication_reply_commands")
}

/// Org/conversation-scoped media attachment for Communication replies (C11.4).
model CommunicationAttachment {
  id                String                           @id @default(uuid())
  organizationId    String                           @map("organization_id")
  conversationId    String                           @map("conversation_id")
  mediaType         CommunicationAttachmentMediaType @map("media_type")
  state             CommunicationAttachmentState     @default(UPLOADING)
  fileName          String                           @map("file_name")
  mimeType          String                           @map("mime_type")
  sizeBytes         Int                              @map("size_bytes")
  contentHash       String                           @map("content_hash")
  objectKey         String                           @map("object_key")
  storageProvider   String                           @map("storage_provider")
  uploaderUserId    String?                          @map("uploader_user_id")
  reservedCommandId String?                          @map("reserved_command_id")
  nativeMessageId   String?                          @map("native_message_id")
  sealedAt          DateTime?                        @map("sealed_at")
  purgedAt          DateTime?                        @map("purged_at")
  createdAt         DateTime                         @default(now()) @map("created_at")
  updatedAt         DateTime                         @updatedAt @map("updated_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, conversationId, createdAt])
  @@index([organizationId, conversationId, state])
  @@index([organizationId, nativeMessageId])
  @@index([organizationId, state, createdAt])
  @@map("communication_attachments")
}

/// Durable audit trail for Communication Center retention purge runs (C13.1).
model CommunicationRetentionPurgeRun {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  trigger        String
  dryRun         Boolean   @default(true) @map("dry_run")
  status         String
  correlationId  String?   @map("correlation_id")
  report         Json      @default("{}")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt])
  @@map("communication_retention_purge_runs")
}
