enum VsiProfileLifecycleOutboxEventType {
  SOURCE_LINK_ACTIVATED
  SOURCE_LINK_DEACTIVATED
  SOURCE_LINK_SUPERSEDED
  DECLARED_CATALOG_ADVANCED
  ACTIVE_VEHICLE_BACKFILL_RECONCILE
}

enum VsiProfileLifecycleOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// VSI P2 — async profile initialization and lifecycle reconciliation (non-blocking onboarding).
model VsiProfileLifecycleOutbox {
  id                   String                            @id @default(uuid())
  organizationId       String                            @map("organization_id")
  vehicleId            String                            @map("vehicle_id")
  providerSourceLinkId String?                           @map("provider_source_link_id")
  eventType            VsiProfileLifecycleOutboxEventType @map("event_type")
  idempotencyKey       String                            @unique @map("idempotency_key")
  payloadVersion       Int                               @default(1) @map("payload_version")
  payload              Json
  occurredAt           DateTime                          @map("occurred_at") @db.Timestamptz(3)
  status               VsiProfileLifecycleOutboxStatus   @default(PENDING)
  attempts             Int                               @default(0)
  availableAt          DateTime                          @default(now()) @map("available_at") @db.Timestamptz(3)
  claimToken           String?                           @map("claim_token")
  claimExpiresAt       DateTime?                         @map("claim_expires_at") @db.Timestamptz(3)
  lastError            String?                           @map("last_error")
  processedAt          DateTime?                         @map("processed_at") @db.Timestamptz(3)
  createdAt            DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([organizationId, vehicleId, occurredAt])
  @@index([providerSourceLinkId])
  @@map("vsi_profile_lifecycle_outbox")
}

enum ApdShadowActivationEpochLifecycle {
  PREPARED
  ACTIVE
  PAUSED
  CLOSED
}

/// P2.5 APDS durable shadow activation epoch (explicit operator activation; flag alone does not create T0).
model ApdShadowActivationEpoch {
  id                            String                            @id @default(uuid())
  activationScopeKey            String                            @map("activation_scope_key")
  organizationId                String                            @map("organization_id")
  cohortConfigFingerprintSha256 String                            @map("cohort_config_fingerprint_sha256")
  cohortConfigVersion           String                            @map("cohort_config_version")
  b2PolicyVersion               String                            @map("b2_policy_version")
  b4PolicyVersion               String                            @map("b4_policy_version")
  productionReleaseIdentity     String?                           @map("production_release_identity")
  lifecycleState                ApdShadowActivationEpochLifecycle @map("lifecycle_state")
  /// Immutable authoritative T0 (PostgreSQL clock); set only on authorized ACTIVE transition.
  activatedAt                   DateTime?                         @map("activated_at") @db.Timestamptz(3)
  preparedAt                    DateTime                          @default(now()) @map("prepared_at")
  pausedAt                      DateTime?                         @map("paused_at")
  closedAt                      DateTime?                         @map("closed_at")
  operatorActor                 String?                           @map("operator_actor")
  operatorReason                String?                           @map("operator_reason")
  operatorRequestId             String?                           @map("operator_request_id")
  /// Idempotency key for authorized activation requests (unique when present).
  activationRequestKey          String?                           @unique @map("activation_request_key")
  createdAt                     DateTime                          @default(now()) @map("created_at")
  updatedAt                     DateTime                          @updatedAt @map("updated_at")

  organization Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decisions    ApdShadowReconciliationDecision[]

  @@index([activationScopeKey, lifecycleState])
  @@index([organizationId, lifecycleState])
  @@map("apd_shadow_activation_epochs")
}

/// P2.5 APD shadow observe-only reconciliation decisions (flag OFF by default).
model ApdShadowReconciliationDecision {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  vehicleId      String   @map("vehicle_id")
  opportunityId  String   @map("opportunity_id")
  decisionAt     DateTime @map("decision_at")
  activationEpochId String? @map("activation_epoch_id")
  realPollId     String?  @map("real_poll_id")
  realPollStatus String?  @map("real_poll_status")

  shadowExecutionVersion String?  @map("shadow_execution_version")
  reconciliation         Boolean?
  enqueueOutcome         String?  @map("enqueue_outcome")
  enqueueOutcomeAt       DateTime? @map("enqueue_outcome_at")

  policyVersion  String @map("policy_version")
  profileVersion String @map("profile_version")
  profileClass   String @map("profile_class")
  decision       String
  reason         String

  lastLvSourceAt        DateTime? @map("last_lv_source_at")
  lastProviderFetchedAt DateTime? @map("last_provider_fetched_at")
  expectedWindowStart   DateTime? @map("expected_window_start")
  expectedWindowEnd     DateTime? @map("expected_window_end")
  providerGapState      String?   @map("provider_gap_state")
  connectivityState     String?   @map("connectivity_state")
  wakeCorrelationId       String?   @map("wake_correlation_id")

  realPollStartedAt           DateTime? @map("real_poll_started_at")
  realPollVisibleLvSourceAt   DateTime? @map("real_poll_visible_lv_source_at")
  realPollCompletedAt       DateTime? @map("real_poll_completed_at")
  newLvSourceObserved       Boolean   @default(false) @map("new_lv_source_observed")
  newLvSourceAt             DateTime? @map("new_lv_source_at")
  newTopLevelSourceObserved Boolean   @default(false) @map("new_top_level_source_observed")
  newObdSourceObserved      Boolean   @default(false) @map("new_obd_source_observed")
  newIgnitionSourceObserved Boolean   @default(false) @map("new_ignition_source_observed")
  simulatedNextPollAt       DateTime? @map("simulated_next_poll_at")
  simulatedDiscoveryAt      DateTime? @map("simulated_discovery_at")
  additionalDiscoveryDelayMs  Int?    @map("additional_discovery_delay_ms")

  legacyAssessmentImpact  String @default("NONE") @map("legacy_assessment_impact")
  legacyPublicationImpact String @default("NONE") @map("legacy_publication_impact")
  legacyCustomerImpact    String @default("NONE") @map("legacy_customer_impact")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Cascade)
  activationEpoch ApdShadowActivationEpoch? @relation(fields: [activationEpochId], references: [id], onDelete: Restrict)

  @@unique([organizationId, vehicleId, opportunityId, policyVersion])
  @@index([vehicleId, decisionAt])
  @@index([organizationId, decisionAt])
  @@index([activationEpochId, decisionAt])
  @@map("apd_shadow_reconciliation_decisions")
}

/// P5B.1 append-only offline VSI↔APDS correlation evidence (write runtime OFF by default).
model VsiApdsP5CorrelationEvidence {
  id                         String   @id @default(uuid())
  organizationId             String   @map("organization_id")
  vehicleId                  String   @map("vehicle_id")
  providerSourceLinkId       String?  @map("provider_source_link_id")
  opportunityId              String   @map("opportunity_id")
  policyVersion              String   @map("policy_version")
  activationEpochId          String?  @map("activation_epoch_id")
  shadowExecutionVersion     String?  @map("shadow_execution_version")
  decisionAt                 DateTime @map("decision_at") @db.Timestamptz(3)
  p5CorrelationContractVersion String @map("p5_correlation_contract_version")
  correlationFingerprint     String   @map("correlation_fingerprint")
  evidenceRevision           Int      @map("evidence_revision")
  replayRunId                String   @map("replay_run_id")
  payloadJson                Json     @map("payload_json")
  createdAt                  DateTime @default(now()) @map("created_at")

  @@unique([organizationId, vehicleId, opportunityId, policyVersion, decisionAt, p5CorrelationContractVersion, correlationFingerprint], map: "vsi_apds_p5_corr_evidence_fingerprint_key")
  @@unique([organizationId, vehicleId, opportunityId, policyVersion, decisionAt, p5CorrelationContractVersion, evidenceRevision], map: "vsi_apds_p5_corr_evidence_rev_key")
  @@index([organizationId, decisionAt], map: "vsi_apds_p5_corr_evidence_org_decision_idx")
  @@map("vsi_apds_p5_correlation_evidence")
}

// ------------------------------------------------
// INTEGRATIONS
// ------------------------------------------------

model Integration {
  id           String           @id @default(uuid())
  type         IntegrationType
  scope        IntegrationScope
  name         String
  description  String?
  configSchema Json?            @map("config_schema")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  orgIntegrations OrganizationIntegration[]

  @@unique([type, scope])
  @@map("integrations")
}

model OrganizationIntegration {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  integrationId  String            @map("integration_id")
  status         IntegrationStatus @default(INACTIVE)
  credentials    Json?
  configJson     Json?             @map("config_json")
  lastSyncAt     DateTime?         @map("last_sync_at")
  errorMessage   String?           @map("error_message")
  connectedAt    DateTime?         @map("connected_at")
  disconnectedAt DateTime?         @map("disconnected_at")
  createdAt      DateTime          @default(now()) @map("created_at")
