// ── M3.3G ground-truth scientific authority (append-only) ──

enum BatteryGroundTruthType {
  WORKSHOP_MEASUREMENT
  BATTERY_REPLACEMENT
  OTHER_CONFIRMED_INTERVENTION
}

enum BatteryGroundTruthSourceAuthority {
  WORKSHOP
  CONFIRMED_DOCUMENT
  OEM
  MANUAL_CONFIRMED
  OTHER
}

enum BatteryGroundTruthVerificationStatus {
  CONFIRMED
  SUPERSEDED
  REVOKED
}

enum BatteryGroundTruthRevocationReasonCode {
  SOURCE_DELETED
  OPERATOR_REVOKE
  DATA_CORRECTION
  OTHER
}

model BatteryGroundTruthEvent {
  id                         String                               @id @default(uuid())
  organizationId             String                               @map("organization_id")
  vehicleId                  String                               @map("vehicle_id")
  groundTruthType            BatteryGroundTruthType               @map("ground_truth_type")
  batteryScope               BatteryEvidenceScope                 @map("battery_scope")
  effectiveAt                DateTime                             @map("effective_at")
  sourceAuthority            BatteryGroundTruthSourceAuthority    @map("source_authority")
  verificationStatus         BatteryGroundTruthVerificationStatus @default(CONFIRMED) @map("verification_status")
  sourceServiceEventId       String?                              @map("source_service_event_id")
  sourceDocumentExtractionId String?                            @map("source_document_extraction_id")
  sourceBatteryEvidenceId    String?                              @map("source_battery_evidence_id")
  sourceMeasurementId        String?                              @map("source_measurement_id")
  sourceContentFingerprint   String                               @map("source_content_fingerprint") @db.Char(64)
  confirmedByUserId          String?                              @map("confirmed_by_user_id")
  confirmedAt                DateTime?                            @map("confirmed_at")
  supersedesGroundTruthEventId String?                            @map("supersedes_ground_truth_event_id")
  createdAt                  DateTime                             @default(now()) @map("created_at")

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle              Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  confirmedByUser      User?                     @relation("BatteryGroundTruthConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  sourceServiceEvent   VehicleServiceEvent?      @relation(fields: [sourceServiceEventId], references: [id], onDelete: SetNull)
  sourceDocumentExtraction VehicleDocumentExtraction? @relation(fields: [sourceDocumentExtractionId], references: [id], onDelete: SetNull)
  sourceBatteryEvidence BatteryEvidence?         @relation(fields: [sourceBatteryEvidenceId], references: [id], onDelete: SetNull)
  sourceMeasurement    BatteryMeasurement?       @relation(fields: [sourceMeasurementId], references: [id], onDelete: SetNull)
  supersedesGroundTruthEvent BatteryGroundTruthEvent? @relation("BatteryGroundTruthSupersede", fields: [supersedesGroundTruthEventId], references: [id], onDelete: SetNull)
  supersededByGroundTruthEvents BatteryGroundTruthEvent[] @relation("BatteryGroundTruthSupersede")
  revocations          BatteryGroundTruthRevocation[]

  @@index([organizationId])
  @@index([vehicleId, effectiveAt(sort: Desc)])
  @@index([groundTruthType])
  @@index([batteryScope])
  @@index([verificationStatus])
  @@index([sourceContentFingerprint])
  @@index([supersedesGroundTruthEventId])
  @@map("battery_ground_truth_events")
}

model BatteryGroundTruthRevocation {
  id                  String                             @id @default(uuid())
  organizationId      String                             @map("organization_id")
  groundTruthEventId  String                             @map("ground_truth_event_id")
  reasonCode          BatteryGroundTruthRevocationReasonCode @map("reason_code")
  revokedByUserId     String?                            @map("revoked_by_user_id")
  revokedAt           DateTime                           @map("revoked_at")
  createdAt           DateTime                           @default(now()) @map("created_at")

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groundTruthEvent BatteryGroundTruthEvent @relation(fields: [groundTruthEventId], references: [id], onDelete: Restrict)
  revokedByUser    User?                   @relation("BatteryGroundTruthRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([groundTruthEventId])
  @@map("battery_ground_truth_revocations")
}

// ------------------------------------------------
// BRAKE EVIDENCE (evidence-based brake condition)
// ------------------------------------------------
// Provenance store for real brake observations. Only MEASURED / DOCUMENTED /
// SENSOR / MANUAL sources may carry real mm values; TELEMATICS_ESTIMATION never
// invents wheel mm. Mirrors the BatteryEvidence pattern and feeds the canonical
// BrakeHealthService read model (data basis, confidence, CRITICAL safety
// signals) without becoming a second wear truth.

enum BrakeEvidenceSource {
  MANUAL_MEASUREMENT
  WORKSHOP_MEASUREMENT
  DOCUMENTED_REPLACEMENT
  INSPECTION_PROTOCOL
  AI_UPLOAD_UNCONFIRMED
  AI_UPLOAD_CONFIRMED
  DTC_SIGNAL
  PROVIDER_WARNING
  BRAKE_WEAR_SENSOR
  TELEMATICS_ESTIMATION
}

enum BrakeAxle {
  FRONT
  REAR
  UNKNOWN
}

enum BrakeWheelPosition {
  FRONT_LEFT
  FRONT_RIGHT
  REAR_LEFT
  REAR_RIGHT
}

enum BrakeComponentStatus {
  GOOD
  WATCH
  WARNING
  CRITICAL
  UNKNOWN
}

enum BrakeEvidenceConfidence {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum BrakeEvidenceConfirmationStatus {
  UNCONFIRMED
  CONFIRMED
  NOT_APPLICABLE
}

enum BrakeEvidenceFreshnessStatus {
  FRESH
  STALE
  EXPIRED
  UNKNOWN
}

enum BrakeDtcCategory {
  BRAKE_SYSTEM
  ABS
  ESC
  PARKING_BRAKE
  BRAKE_SENSOR
  BRAKE_FLUID
  COMMUNICATION_RELATED
  NOT_BRAKE_RELATED
}

enum BrakeDtcFreshness {
  FRESH
  STALE
  UNKNOWN
}

model BrakeEvidence {
  id                      String                          @id @default(uuid())
  organizationId          String?                         @map("organization_id")
  vehicleId               String                          @map("vehicle_id")
  source                  BrakeEvidenceSource
  axle                    BrakeAxle                       @default(UNKNOWN)
  wheelPosition           BrakeWheelPosition?             @map("wheel_position")
  measuredPadMm           Float?                          @map("measured_pad_mm")
  measuredDiscMm          Float?                          @map("measured_disc_mm")
  discCondition           BrakeComponentStatus?           @map("disc_condition")
  brakeFluidStatus        BrakeComponentStatus?           @map("brake_fluid_status")
  /// Confirmed "replace immediately" flag from a workshop/AI document.
  immediateReplacement    Boolean?                        @map("immediate_replacement")
  /// Optional DTC severity when source = DTC_SIGNAL (INFO/WARNING/CRITICAL).
  dtcSeverity             String?                         @map("dtc_severity")
  vehicleDtcEventId       String?                         @map("vehicle_dtc_event_id")
  dtcCode                 String?                         @map("dtc_code")
  dtcCategory             BrakeDtcCategory?               @map("dtc_category")
  dtcActive               Boolean?                        @map("dtc_active")
  dtcFirstSeenAt          DateTime?                       @map("dtc_first_seen_at")
  dtcLastSeenAt           DateTime?                       @map("dtc_last_seen_at")
  dtcResolvedAt           DateTime?                       @map("dtc_resolved_at")
  sourceProvider          String?                         @map("source_provider")
  sourceTimestamp         DateTime?                       @map("source_timestamp")
  dtcFreshness            BrakeDtcFreshness?              @map("dtc_freshness")
  dedupeKey               String?                         @map("dedupe_key")
  dtcReviewRequired       Boolean?                        @map("dtc_review_required")
  active                  Boolean                         @default(true) @map("active")
  firstObservedAt         DateTime?                       @map("first_observed_at")
  lastObservedAt          DateTime?                       @map("last_observed_at")
  resolvedAt              DateTime?                       @map("resolved_at")
  expiresAt               DateTime?                       @map("expires_at")
  freshnessStatus         BrakeEvidenceFreshnessStatus    @default(UNKNOWN) @map("freshness_status")
  confirmationStatus      BrakeEvidenceConfirmationStatus @default(NOT_APPLICABLE) @map("confirmation_status")
  confirmedBy             String?                         @map("confirmed_by")
  confirmedAt             DateTime?                       @map("confirmed_at")
  supersededByEvidenceId  String?                         @map("superseded_by_evidence_id")
  externalSourceId        String?                         @map("external_source_id")
  recalculationEnqueuedAt DateTime?                       @map("recalculation_enqueued_at")
  mileageAtMeasurementKm  Int?                            @map("mileage_at_measurement_km")
  measuredAt              DateTime?                       @map("measured_at")
  confidence              BrakeEvidenceConfidence         @default(UNKNOWN)
  notes                   String?
  documentExtractionId    String?                         @map("document_extraction_id")
  serviceEventId          String?                         @map("service_event_id")
  predictionSnapshotId    String?                         @map("prediction_snapshot_id")
  createdById             String?                         @map("created_by_id")
  createdAt               DateTime                        @default(now()) @map("created_at")

  vehicle                Vehicle                      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documentExtraction     VehicleDocumentExtraction?   @relation(fields: [documentExtractionId], references: [id], onDelete: SetNull)
  serviceEvent           VehicleServiceEvent?         @relation(fields: [serviceEventId], references: [id], onDelete: SetNull)
  predictionSnapshot     BrakeHealthSnapshot?         @relation("BrakeEvidencePredictionSnapshot", fields: [predictionSnapshotId], references: [id], onDelete: SetNull)
  vehicleDtcEvent        VehicleDtcEvent?             @relation(fields: [vehicleDtcEventId], references: [id], onDelete: SetNull)
  supersededBy           BrakeEvidence?               @relation("BrakeEvidenceSupersession", fields: [supersededByEvidenceId], references: [id], onDelete: SetNull)
  supersedes             BrakeEvidence[]              @relation("BrakeEvidenceSupersession")
  componentInstallations BrakeComponentInstallation[]

  @@unique([documentExtractionId, axle])
  @@index([vehicleId, axle, measuredAt])
  @@index([vehicleId, source, measuredAt])
  @@index([documentExtractionId])
  @@index([serviceEventId])
  @@index([predictionSnapshotId])
  @@index([vehicleId, dtcCode, dtcActive])
  @@index([vehicleId, dedupeKey])
  @@index([vehicleId, active, lastObservedAt(sort: Desc)])
  @@index([organizationId, vehicleId, dedupeKey])
  @@map("brake_evidence")
}

