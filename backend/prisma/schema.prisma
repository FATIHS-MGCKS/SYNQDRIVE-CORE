  organizationId   String    @map("organization_id")
  legalDocumentId  String    @map("legal_document_id")
  eventType        String    @map("event_type")
  previousStatus   String?   @map("previous_status")
  newStatus        String    @map("new_status")
  actorUserId      String?   @map("actor_user_id")
  actorDisplayName String?   @map("actor_display_name")
  reason           String?
  changeSummary    String?   @map("change_summary")
  versionLabel     String    @map("version_label")
  documentType     String    @map("document_type")
  legalVariant     String?   @map("legal_variant")
  checksum         String?
  language         String
  jurisdiction     String?
  customerSegment  String?   @map("customer_segment")
  bookingChannel   String?   @map("booking_channel")
  productScope     String?   @map("product_scope")
  stationScopeMode String?   @map("station_scope_mode")
  priority         Int?
  isMandatory      Boolean?  @map("is_mandatory")
  noticePurpose    String?   @map("notice_purpose")
  validFrom        DateTime? @map("valid_from")
  validUntil       DateTime? @map("valid_until")
  correlationId    String?   @map("correlation_id")
  retentionClass   String    @default("AUDIT_EVENT") @map("retention_class")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalDocument OrganizationLegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt], map: "organization_legal_document_events_org_created_idx")
  @@index([legalDocumentId, createdAt], map: "organization_legal_document_events_doc_created_idx")
  @@index([organizationId, legalDocumentId, createdAt], map: "organization_legal_document_events_org_doc_created_idx")
  @@map("organization_legal_document_events")
}

/// Append-only proof of legal text presentation, delivery, and acknowledgment to customers.
/// NOT a consent store — marketing/KYC/data-processing consents use separate models.
/// Rows are created via controlled service methods; completed events are immutable.
model LegalDocumentDeliveryEvidence {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  bookingId            String    @map("booking_id")
  customerId           String    @map("customer_id")
  legalDocumentId      String    @map("legal_document_id")
  generatedDocumentId  String    @map("generated_document_id")
  documentType         String    @map("document_type")
  versionLabel         String    @map("version_label")
  language             String
  checksum             String?
  presentedAt          DateTime  @map("presented_at")
  deliveryChannel      String    @map("delivery_channel")
  deliveryStatus       String    @map("delivery_status")
  deliveredAt          DateTime? @map("delivered_at")
  acknowledgedAt       DateTime? @map("acknowledged_at")
  acknowledgmentMethod String?   @map("acknowledgment_method")
  signatureReference   String?   @map("signature_reference")
  actorUserId          String?   @map("actor_user_id")
  recipientSnapshot    Json      @map("recipient_snapshot")
  requestId            String?   @map("request_id")
  outboundEmailId      String?   @map("outbound_email_id")
  retentionClass       String    @default("DELIVERY_EVIDENCE") @map("retention_class")
  retainUntil          DateTime? @map("retain_until")
  legalHold            Boolean   @default(false) @map("legal_hold")
  legalHoldReason      String?   @map("legal_hold_reason")
  legalHoldSetAt       DateTime? @map("legal_hold_set_at")
  legalHoldSetByUserId String?   @map("legal_hold_set_by_user_id")
  deletionEligibleAt   DateTime? @map("deletion_eligible_at")
  deletedAt            DateTime? @map("deleted_at")
  recipientRedactedAt  DateTime? @map("recipient_redacted_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
