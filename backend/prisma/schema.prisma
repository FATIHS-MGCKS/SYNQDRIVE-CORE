  sourceDataCutoffAt    DateTime @map("source_data_cutoff_at") @db.Timestamptz(6)
  pairingEligible       Boolean  @default(false) @map("pairing_eligible")
  measurementIdsUsed    Json     @default("[]") @map("measurement_ids_used")
  snapshotPayload       Json     @map("snapshot_payload")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

