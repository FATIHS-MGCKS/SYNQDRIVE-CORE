  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt])
  @@index([organizationId, createdAt])
  @@map("brake_recalculation_audit")
}

// ------------------------------------------------
// VEHICLE DTC EVENTS (Error Codes)
// ------------------------------------------------

model VehicleDtcEvent {
  id              String      @id @default(uuid())
  vehicleId       String?     @map("vehicle_id")
  dtcCode         String      @map("dtc_code")
  description     String?
  severity        DtcSeverity @default(WARNING)
  isActive        Boolean     @default(true) @map("is_active")
  firstSeenAt     DateTime    @map("first_seen_at")
  lastSeenAt      DateTime    @map("last_seen_at")
  clearedAt       DateTime?   @map("cleared_at")
  occurrenceCount Int         @default(1) @map("occurrence_count")
  rawPayload      Json?       @map("raw_payload")
  createdAt       DateTime    @default(now()) @map("created_at")

  vehicle       Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  brakeEvidence BrakeEvidence[]

  @@index([vehicleId])
  @@index([dtcCode])
  @@index([isActive])
  @@index([firstSeenAt])
  // Hot queries: `findByVehicle` orders by lastSeenAt desc; summary counts
  // active faults for a vehicle. Composite indexes avoid a heap fetch + sort.
  @@index([vehicleId, lastSeenAt])
  @@index([vehicleId, isActive])
  @@map("vehicle_dtc_events")
}

/// DTC-01B — canonical monotonic source head (isolated from global VLS snapshot provenance).
model VehicleDtcSourceHead {
