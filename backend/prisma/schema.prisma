/// VSI-03 P2C — append-only per-fetch aggregated provider source observations (not vehicle state).
enum VehicleProviderSourceTimestampProvenance {
  PROVIDER_LAST_SEEN
  PROVIDER_MISSING
}

enum VehicleProviderSourceObservationRecordPhase {
  PROVIDER_FETCH
  VLS_APPLICATION
}

enum VehicleProviderSourceObservationOutcome {
  VLS_APPLIED
  MONOTONIC_STALE_SKIPPED
  PROVIDER_FETCH_RECORDED
  VLS_COMMITTED
  PERSISTENCE_FAILED
}

model VehicleProviderSourceObservationCounter {
  organizationId           String @map("organization_id")
  vehicleId                String @map("vehicle_id")
  provider                 String
  providerBindingScopeKey  String @map("provider_binding_scope_key")
  providerTokenScopeKey    String @map("provider_token_scope_key")
  nextObservationIndex     BigInt @default(2) @map("next_observation_index")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "vsi_p2c_obs_counters_org_fkey")
  vehicle      Vehicle      @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Cascade, map: "vsi_p2c_obs_counters_vehicle_fkey")

  @@id([organizationId, vehicleId, provider, providerBindingScopeKey, providerTokenScopeKey])
  @@map("vehicle_provider_source_observation_counters")
}

model VehicleProviderSourceObservation {
  id                       String                                   @id @default(uuid())
  organizationId           String                                   @map("organization_id")
  vehicleId                String                                   @map("vehicle_id")
  provider                 String
  providerBindingId        String?                                  @map("provider_binding_id")
  /// Stable scope key for sequencing (binding id or UNRESOLVED when null).
  providerBindingScopeKey  String                                   @map("provider_binding_scope_key")
  providerTokenReference     String?                                  @map("provider_token_reference")
  providerTokenScopeKey      String                                   @map("provider_token_scope_key")
  pollJobId                String                                   @map("poll_job_id")
  bullmqAttemptNumber      Int                                      @default(0) @map("bullmq_attempt_number")
  fetchCorrelationId       String?                                  @map("fetch_correlation_id")
  recordPhase              VehicleProviderSourceObservationRecordPhase @default(PROVIDER_FETCH) @map("record_phase")
  idempotencyKey           String                                   @unique @map("idempotency_key")
  observationIndex         BigInt                                   @map("observation_index")
  providerFetchedAt        DateTime                                 @map("provider_fetched_at") @db.Timestamptz(3)
  providerSourceTimestamp  DateTime?                                @map("provider_source_timestamp") @db.Timestamptz(3)
  sourceTimestampProvenance VehicleProviderSourceTimestampProvenance @map("source_timestamp_provenance")
  observationOutcome       VehicleProviderSourceObservationOutcome  @map("observation_outcome")
  createdAt                DateTime                                 @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, vehicleId, provider, providerBindingScopeKey, providerTokenScopeKey, observationIndex, recordPhase], map: "vsi_p2c_obs_scope_index_phase_key")
  @@index([organizationId, vehicleId, providerBindingId, providerFetchedAt(sort: Desc)])
  @@index([vehicleId, providerFetchedAt(sort: Desc)])
  @@index([fetchCorrelationId])
  @@map("vehicle_provider_source_observations")
}

/// VSI P0+P1 — durable per-link signal capability profile (declared vs observed).
model VehicleSignalCapabilityProfile {
  id                              String    @id @default(uuid())
  organizationId                  String    @map("organization_id")
  vehicleId                       String    @map("vehicle_id")
  providerSourceLinkId            String    @map("provider_source_link_id")
  providerIdentity                String    @map("provider_identity")
  verifiedModality                String?   @map("verified_modality")
  telemetrySourceFamily           String?   @map("telemetry_source_family")
  profileContractVersion          String    @map("profile_contract_version")
  profileRevision                 Int       @default(1) @map("profile_revision")
  contentFingerprint              String    @map("content_fingerprint")
  evaluatedAt                     DateTime  @map("evaluated_at") @db.Timestamptz(3)
  declaredCatalogCheckedAt        DateTime? @map("declared_catalog_checked_at") @db.Timestamptz(3)
  lastMaterializedSourceTimestamp DateTime? @map("last_materialized_source_timestamp") @db.Timestamptz(3)
  lastMaterializedProviderFetchAt DateTime? @map("last_materialized_provider_fetch_at") @db.Timestamptz(3)
  lastProvenStrictSourceAdvanceAt DateTime? @map("last_proven_strict_source_advance_at") @db.Timestamptz(3)
  signalsSnapshot                 Json      @map("signals_snapshot")
  profileLimitations              Json      @default("[]") @map("profile_limitations")
  createdAt                       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, vehicleId, providerSourceLinkId], map: "vehicle_signal_capability_profiles_scope_key")
  @@index([organizationId, vehicleId])
  @@index([vehicleId, evaluatedAt(sort: Desc)])
  @@map("vehicle_signal_capability_profiles")
}

/// VSI P5-H1 — immutable append-only revision history for decision-time evidence (capture gate default OFF).
model VehicleSignalCapabilityProfileRevision {
  id                              String   @id @default(uuid())
  organizationId                  String   @map("organization_id")
  vehicleId                       String   @map("vehicle_id")
  providerSourceLinkId            String   @map("provider_source_link_id")
  profileRevision                 Int      @map("profile_revision")
  profileContractVersion          String   @map("profile_contract_version")
  contentFingerprint              String   @map("content_fingerprint")
  providerIdentity                String   @map("provider_identity")
  verifiedModality                String?  @map("verified_modality")
  telemetrySourceFamily           String?  @map("telemetry_source_family")
  evaluatedAt                     DateTime @map("evaluated_at") @db.Timestamptz(3)
  recordedAt                      DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  declaredCatalogCheckedAt        DateTime? @map("declared_catalog_checked_at") @db.Timestamptz(3)
  lastMaterializedSourceTimestamp DateTime? @map("last_materialized_source_timestamp") @db.Timestamptz(3)
  lastMaterializedProviderFetchAt DateTime? @map("last_materialized_provider_fetch_at") @db.Timestamptz(3)
  lastProvenStrictSourceAdvanceAt DateTime? @map("last_proven_strict_source_advance_at") @db.Timestamptz(3)
  signalsSnapshot                 Json     @map("signals_snapshot")
  profileLimitations              Json     @default("[]") @map("profile_limitations")
  materializationTrigger          String   @map("materialization_trigger")
  sourceLinkLifecycleContext      Json     @default("{}") @map("source_link_lifecycle_context")
  sourceProvenance                Json     @default("{}") @map("source_provenance")
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "vehicle_signal_capability_profile_revisions_org_fkey")
  vehicle      Vehicle      @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Cascade, map: "vehicle_signal_capability_profile_revisions_vehicle_fkey")

  @@unique([organizationId, vehicleId, providerSourceLinkId, profileRevision], map: "vehicle_signal_capability_profile_revisions_scope_revision_key")
  @@index([organizationId, vehicleId, providerSourceLinkId, recordedAt(sort: Desc)], map: "vehicle_signal_capability_profile_revisions_scope_recorded_idx")
  @@index([organizationId, vehicleId, providerSourceLinkId, evaluatedAt(sort: Desc)], map: "vehicle_signal_capability_profile_revisions_scope_evaluated_idx")
  @@map("vehicle_signal_capability_profile_revisions")
}

enum VsiProviderCatalogAxisDeclaredStatus {
  LISTED
  NOT_LISTED
  UNKNOWN
}

enum VsiProviderCatalogSnapshotCompleteness {
  COMPLETE_PROVIDER_CATALOG
  INCOMPLETE_PROVIDER_RESPONSE
  PROVIDER_ERROR
}

enum VsiProviderCatalogAxisProvenance {
  DIMO_AVAILABLE_SIGNALS_PREFLIGHT
}

