// ────────────────────────────────────────────────────────────────────────────

model TenantInsightPolicy {
  id                 String   @id @default(uuid())
  organizationId     String   @unique @map("organization_id")
  enabled            Boolean  @default(true)
  refreshIntervalMin Int      @default(30) @map("refresh_interval_min")
  maxVisibleInsights Int      @default(4) @map("max_visible_insights")
  enabledTypes       Json?    @map("enabled_types")
  policyOverrides    Json?    @map("policy_overrides")
  useLlmFormatting   Boolean  @default(false) @map("use_llm_formatting")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("tenant_insight_policies")
}

model DashboardInsightRun {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  trigger         String
  startedAt       DateTime  @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  durationMs      Int?      @map("duration_ms")
  candidateCount  Int       @default(0) @map("candidate_count")
  publishedCount  Int       @default(0) @map("published_count")
  errorMessage    String?   @map("error_message")
  calculationMeta Json?     @map("calculation_meta")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  insights     DashboardInsight[]

  @@index([organizationId])
  @@index([createdAt])
  @@map("dashboard_insight_runs")
}

model DashboardInsight {
  id              String             @id @default(uuid())
  organizationId  String             @map("organization_id")
  runId           String             @map("run_id")
  type            InsightType
  severity        InsightSeverity
  priority        Int                @default(0)
  title           String
  message         String
  actionLabel     String?            @map("action_label")
  actionType      String?            @map("action_type")
  entityScope     InsightEntityScope @map("entity_scope")
  entityIds       Json?              @map("entity_ids")
  timeContext     Json?              @map("time_context")
  metrics         Json?
  reasons         Json?
  confidence      Float              @default(1.0)
  dedupeKey       String             @map("dedupe_key")
  groupKey        String?            @map("group_key")
  isGrouped       Boolean            @default(false) @map("is_grouped")
  groupCount      Int                @default(1) @map("group_count")
  isActive        Boolean            @default(true) @map("is_active")
  expiresAt       DateTime?          @map("expires_at")
  calculationMeta Json?              @map("calculation_meta")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          DashboardInsightRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@index([runId])
  @@index([dedupeKey])
  @@index([type])
  @@map("dashboard_insights")
}

// ── Notification Engine (V4.9.351) — persistent lifecycle notifications ──
// Partial unique index on (organization_id, fingerprint, lifecycle_generation)
// for active statuses is defined in migration SQL — Prisma does not support partial indexes.

model Notification {
  id                  String                 @id @default(uuid())
  organizationId      String                 @map("organization_id")
  fingerprint         String
  lifecycleGeneration Int                    @default(1) @map("lifecycle_generation")
  eventType           String                 @map("event_type")
  eventKind           NotificationEventKind  @map("event_kind")
  conditionCode       String                 @map("condition_code")
  domain              NotificationDomain
  severity            NotificationSeverity
  status              NotificationStatus     @default(OPEN)
  entityType          NotificationEntityType @map("entity_type")
  entityId            String                 @map("entity_id")
  titleKey            String                 @map("title_key")
  bodyKey             String                 @map("body_key")
  templateParams      Json                   @default("{}") @map("template_params")
  actionType          NotificationActionType @map("action_type")
  actionTarget        Json                   @default("{}") @map("action_target")
  sourceType          NotificationSourceType @map("source_type")
  primarySourceRef    String                 @map("primary_source_ref")
  /// Optional backfill bridge to legacy DashboardInsight.id — not a FK to preserve migration independence.
  legacyInsightId     String?                @map("legacy_insight_id")
  firstSeenAt         DateTime               @map("first_seen_at")
  lastSeenAt          DateTime               @map("last_seen_at")
  occurrenceCount     Int                    @default(1) @map("occurrence_count")
  reopenCount         Int                    @default(0) @map("reopen_count")
  acknowledgedAt      DateTime?              @map("acknowledged_at")
  snoozedUntil        DateTime?              @map("snoozed_until")
  resolvedAt          DateTime?              @map("resolved_at")
  archivedAt          DateTime?              @map("archived_at")
  expiresAt           DateTime?              @map("expires_at")
  retentionClass      String                 @default("ACTIVE_OPERATIONAL") @map("retention_class")
  legalHold           Boolean                @default(false) @map("legal_hold")
  legalHoldReason     String?                @map("legal_hold_reason")
  legalHoldSetAt      DateTime?              @map("legal_hold_set_at")
  deletionEligibleAt  DateTime?              @map("deletion_eligible_at")
  anonymizedAt        DateTime?              @map("anonymized_at")
  version             Int                    @default(1)
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  occurrences    NotificationOccurrence[]
  receipts       NotificationReceipt[]
  deliveryOutbox NotificationDeliveryOutbox[]
  auditEvents    NotificationAuditEvent[]

  @@index([organizationId, status, lastSeenAt])
  @@index([organizationId, severity, status])
  @@index([organizationId, domain, status])
  @@index([entityType, entityId])
  @@index([fingerprint])
  @@index([expiresAt])
  @@index([resolvedAt])
  @@index([organizationId, retentionClass, deletionEligibleAt])
  @@index([organizationId, legalHold])
  @@index([organizationId, fingerprint, lifecycleGeneration])
  @@map("notifications")
}

model NotificationOccurrence {
  id                   String                 @id @default(uuid())
  notificationId       String                 @map("notification_id")
  organizationId       String                 @map("organization_id")
  occurredAt           DateTime               @map("occurred_at")
  detectedAt           DateTime               @default(now()) @map("detected_at")
  sourceType           NotificationSourceType @map("source_type")
  sourceRef            String                 @map("source_ref")
  severityAtOccurrence NotificationSeverity   @map("severity_at_occurrence")
  payload              Json?                  @map("payload")
  createdAt            DateTime               @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([notificationId, occurredAt])
  @@index([organizationId])
  @@map("notification_occurrences")
}

model NotificationReceipt {
  id             String    @id @default(uuid())
  notificationId String    @map("notification_id")
  userId         String    @map("user_id")
  organizationId String    @map("organization_id")
  readAt         DateTime? @map("read_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  snoozedUntil   DateTime? @map("snoozed_until")
  hiddenAt       DateTime? @map("hidden_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@index([organizationId])
  @@map("notification_receipts")
}

model NotificationDeliveryOutbox {
  id                  String                           @id @default(uuid())
  organizationId      String                           @map("organization_id")
  notificationId      String                           @map("notification_id")
  lifecycleGeneration Int                              @map("lifecycle_generation")
  eventType           String                           @map("event_type")
  deliveryTransition  NotificationDeliveryTransition   @map("delivery_transition")
  channel             NotificationDeliveryChannel
  recipientId         String?                          @map("recipient_id")
  audienceKey         String                           @map("audience_key")
  payloadRef          Json                             @default("{}") @map("payload_ref")
  status              NotificationDeliveryOutboxStatus @default(PENDING)
  attempts            Int                              @default(0)
  availableAt         DateTime                         @default(now()) @map("available_at")
  processedAt         DateTime?                        @map("processed_at")
  lastError           String?                          @map("last_error")
  idempotencyKey      String                           @unique @map("idempotency_key")
  outboundEmailId     String?                          @map("outbound_email_id")
  createdAt           DateTime                         @default(now()) @map("created_at")
  updatedAt           DateTime                         @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([organizationId, status])
  @@index([notificationId])
  @@map("notification_delivery_outbox")
}

enum NotificationAuditActorType {
  USER
  SYSTEM
  AUTOMATION
  WORKFLOW
}

enum NotificationAuditEventType {
  NOTIFICATION_CREATED
  SEVERITY_ESCALATED
  ACKNOWLEDGED
  SNOOZED
  UNSNOOZED
  RESOLVED
  REOPENED
  ARCHIVED
  DELIVERY_FAILED
  DELIVERY_DEAD_LETTER
  WORKFLOW_TRIGGERED
  MANUAL_INTERVENTION
  POLICY_REJECTED
  INGEST_IGNORED
}

enum NotificationAuditRetentionClass {
  TECHNICAL_LOG
  REVISION_AUDIT
  GOVERNANCE_AUDIT
}

/// Append-only governance audit for notification lifecycle and delivery (ISO-oriented).
model NotificationAuditEvent {
  id             String                          @id @default(uuid())
  organizationId String                          @map("organization_id")
  notificationId String?                         @map("notification_id")
  eventType      NotificationAuditEventType      @map("event_type")
  retentionClass NotificationAuditRetentionClass @map("retention_class")
  actorType      NotificationAuditActorType      @map("actor_type")
  actorUserId    String?                         @map("actor_user_id")
  previousState  Json?                           @map("previous_state")
  nextState      Json?                           @map("next_state")
  reasonCode     String?                         @map("reason_code")
  correlationId  String?                         @map("correlation_id")
  clientMeta     Json?                           @map("client_meta")
  payloadHash    String?                         @map("payload_hash")
  legalHold      Boolean                         @default(false) @map("legal_hold")
  createdAt      DateTime                        @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, notificationId])
  @@index([organizationId, eventType])
  @@index([correlationId])
  @@index([retentionClass, createdAt])
  @@map("notification_audit_events")
}

model NotificationRetentionPurgeRun {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  trigger        String
  dryRun         Boolean   @default(true) @map("dry_run")
  status         String
  correlationId  String?   @map("correlation_id")
  report         Json      @default("{}")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@map("notification_retention_purge_runs")
}

/// Durable retry queue for optional task automation side-effects (booking, invoice, document, insight).
model TaskAutomationOutbox {
  id             String                     @id @default(uuid())
  organizationId String                     @map("organization_id")
  ruleId         String                     @map("rule_id")
  ruleVersion    Int                        @map("rule_version")
  entityType     TaskAutomationEntityType   @map("entity_type")
  entityId       String                     @map("entity_id")
  idempotencyKey String                     @unique @map("idempotency_key")
  payload        Json
  status         TaskAutomationOutboxStatus @default(PENDING)
  attempts       Int                        @default(0)
  availableAt    DateTime                   @default(now()) @map("available_at")
  lastError      String?                    @map("last_error")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  processedAt    DateTime?                  @map("processed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status, availableAt])
  @@map("task_automation_outbox")
}

/// Per-organization overrides for canonical task automation catalog rules.
/// Null column values inherit the platform default from the code catalog.
model OrgTaskAutomationRuleOverride {
  id                      String        @id @default(uuid())
  organizationId          String        @map("organization_id")
  ruleId                  String        @map("rule_id")
  enabled                 Boolean?
  activationOffsetMinutes Int?          @map("activation_offset_minutes")
  dueOffsetMinutes        Int?          @map("due_offset_minutes")
  priority                TaskPriority?
  assignmentStrategy      String?       @map("assignment_strategy")
  assignedUserId          String?       @map("assigned_user_id")
  assignedRoleKey         String?       @map("assigned_role_key")
  stationScope            String?       @map("station_scope")
  escalationConfig        Json?         @map("escalation_config")
  notificationConfig      Json?         @map("notification_config")
  checklistOverrides      Json?         @map("checklist_overrides")
  version                 Int           @default(1)
  createdByUserId         String?       @map("created_by_user_id")
  updatedByUserId         String?       @map("updated_by_user_id")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  organization Organization                            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                                   @relation("TaskAutomationRuleOverrideCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?                                   @relation("TaskAutomationRuleOverrideUpdated", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  revisions    OrgTaskAutomationRuleOverrideRevision[]

  @@unique([organizationId, ruleId])
  @@index([organizationId])
  @@map("org_task_automation_rule_overrides")
}

enum TaskAutomationRuleOverrideChangeType {
  CREATE
  UPDATE
  RESET
}

/// Immutable audit snapshots for org task automation rule overrides.
model OrgTaskAutomationRuleOverrideRevision {
  id              String                               @id @default(uuid())
  overrideId      String                               @map("override_id")
  organizationId  String                               @map("organization_id")
  ruleId          String                               @map("rule_id")
  overrideVersion Int                                  @map("override_version")
  changeType      TaskAutomationRuleOverrideChangeType @map("change_type")
  snapshot        Json
  changedByUserId String?                              @map("changed_by_user_id")
  createdAt       DateTime                             @default(now()) @map("created_at")

  override  OrgTaskAutomationRuleOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)
  changedBy User?                         @relation("TaskAutomationRuleOverrideRevisionChanged", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, ruleId])
  @@index([overrideId, createdAt])
  @@map("org_task_automation_rule_override_revisions")
}

