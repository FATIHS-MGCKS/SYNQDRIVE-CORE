  id                   String                      @id @default(uuid())
  organizationId       String                      @map("organization_id")
  scopeType            RentalRuleRevisionScopeType @map("scope_type")
  scopeId              String                      @map("scope_id")
  version              Int
  status               RentalRuleRevisionStatus
  normalizedRules      Json                        @map("normalized_rules")
  rulesHash            String                      @map("rules_hash") @db.VarChar(64)
  effectiveFrom        DateTime                    @map("effective_from")
  effectiveTo          DateTime?                   @map("effective_to")
  createdBy            String?                     @map("created_by")
  createdAt            DateTime                    @default(now()) @map("created_at")
  publishedBy          String?                     @map("published_by")
  publishedAt          DateTime?                   @map("published_at")
  changeReason         String?                     @map("change_reason")
  supersedesRevisionId String?                     @map("supersedes_revision_id")
  lockVersion          Int                         @default(1) @map("lock_version")

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser      User?                @relation("RentalRuleRevisionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  publishedByUser    User?                @relation("RentalRuleRevisionPublishedBy", fields: [publishedBy], references: [id], onDelete: SetNull)
  supersedesRevision RentalRuleRevision?  @relation("RentalRuleRevisionSupersedes", fields: [supersedesRevisionId], references: [id], onDelete: SetNull)
