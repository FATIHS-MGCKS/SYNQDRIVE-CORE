  underCoverageKm        Float?  @map("under_coverage_km")
  overCoverageKm         Float?  @map("over_coverage_km")
  coverageRatioRaw       Float?  @map("coverage_ratio_raw")
  coverageStatus         String? @map("coverage_status")
