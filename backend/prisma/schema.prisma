// ------------------------------------------------
// REFRESH TOKENS
// ------------------------------------------------

enum RefreshTokenScope {
  ORG_MEMBERSHIP_BOUND
  LEGACY_UNSCOPED
}

enum SessionAssuranceLevel {
  PASSWORD
  MFA
}

model RefreshToken {
  id                String                 @id @default(uuid())
  userId            String                 @map("user_id")
  tokenHash         String                 @unique @map("token_hash") // bcrypt hash of the actual token
  family            String                 @map("family") // rotation family — revoke all on reuse detection
  scope             RefreshTokenScope      @default(LEGACY_UNSCOPED) @map("scope")
  organizationId    String?                @map("organization_id")
  membershipId      String?                @map("membership_id")
  sessionVersion    Int?                   @map("session_version")
  membershipVersion Int?                   @map("membership_version")
  permissionVersion Int?                   @map("permission_version")
  roleVersion       Int?                   @map("role_version")
  assuranceLevel    SessionAssuranceLevel? @map("assurance_level")
  authenticatedAt   DateTime?              @map("authenticated_at")
  lastUsedAt        DateTime?              @map("last_used_at")
  privilegedSession Boolean                @default(false) @map("privileged_session")
  expiresAt         DateTime               @map("expires_at")
  revokedAt         DateTime?              @map("revoked_at")
  revocationReason  String?                @map("revocation_reason")
  replacedBy        String?                @map("replaced_by") // id of the next token in chain
  userAgent         String?                @map("user_agent")
  ipAddress         String?                @map("ip_address")
  createdAt         DateTime               @default(now()) @map("created_at")

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  membership   OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([family])
  @@index([userId, organizationId])
  @@index([membershipId])
  @@index([scope])
  @@map("refresh_tokens")
}

