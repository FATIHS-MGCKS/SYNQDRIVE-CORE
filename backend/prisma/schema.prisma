  usageEvents    VoiceUsageEvent[]
  toolExecutions VoiceToolExecution[]
  webhookEvents  VoiceProviderWebhookEvent[]

  @@index([organizationId, startedAt])
  @@index([lifecycleState])
  @@index([voiceAssistantId])
  @@index([outcome])
  @@index([providerConversationId])
  @@index([elevenLabsConvId])
  @@index([twilioCallSid])
  @@map("voice_conversations")
}

model TwilioWebhookEvent {
  id              String    @id @default(uuid())
  organizationId  String?   @map("organization_id")
  callSid         String?   @map("call_sid")
  externalEventId String    @map("external_event_id")
  eventType       String?   @map("event_type")
