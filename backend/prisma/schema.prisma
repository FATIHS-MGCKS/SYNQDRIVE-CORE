  inputFingerprint        String?                          @map("input_fingerprint")
  lastNotifiedFingerprint String?                          @map("last_notified_fingerprint")
  pressureSource          String?                          @map("pressure_source")
  pressureTimestamp       DateTime?                        @map("pressure_timestamp")
  pressureFreshness       String?                          @map("pressure_freshness")
  templateParamsJson      Json?                            @map("template_params_json")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tireSetup    VehicleTireSetup @relation(fields: [tireSetupId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([vehicleId, tireSetupId, status])
  @@index([dedupeKey, status])
  @@map("tire_health_alerts")
}

// ------------------------------------------------
// BOOKINGS
// ------------------------------------------------

model Booking {
  id                      String                @id @default(uuid())
  organizationId          String                @map("organization_id")
  customerId              String                @map("customer_id")
  assignedDriverId        String?               @map("assigned_driver_id")
  vehicleId               String                @map("vehicle_id")
  pickupStationId         String?               @map("pickup_station_id")
  returnStationId         String?               @map("return_station_id")
  actualPickupStationId   String?               @map("actual_pickup_station_id")
  actualReturnStationId   String?               @map("actual_return_station_id")
  pickupAddressOverride   String?               @map("pickup_address_override")
  returnAddressOverride   String?               @map("return_address_override")
  isOneWayRental          Boolean               @default(false) @map("is_one_way_rental")
  stationTransferFeeCents Int?                  @map("station_transfer_fee_cents")
  startDate               DateTime              @map("start_date")
  endDate                 DateTime              @map("end_date")
  dailyRateCents          Int?                  @map("daily_rate_cents")
  totalPriceCents         Int?                  @map("total_price_cents")
  kmIncluded              Int?                  @map("km_included")
  kmDriven                Int?                  @map("km_driven")
  insuranceOptions        Json?                 @map("insurance_options")
  extrasJson              Json?                 @map("extras_json")
  currency                String                @default("eur")
  status                  BookingStatus         @default(PENDING)
  /// Derived summary from BookingPaymentRequest / invoice state — not financial source of truth.
  paymentStatus           BookingPaymentStatus  @default(UNPAID) @map("payment_status")
  /// Checkout payment intent from wizard — does not imply money received.
  paymentIntent           BookingPaymentIntent? @map("payment_intent")
  notes                   String?
  cancelledAt             DateTime?             @map("cancelled_at")
  completedAt             DateTime?             @map("completed_at")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  organization                  Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer                      Customer                        @relation(fields: [customerId], references: [id])
  assignedDriver                Customer?                       @relation("BookingAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  vehicle                       Vehicle                         @relation(fields: [vehicleId], references: [id])
  pickupStation                 Station?                        @relation("BookingPickupStation", fields: [pickupStationId], references: [id], onDelete: SetNull)
  returnStation                 Station?                        @relation("BookingReturnStation", fields: [returnStationId], references: [id], onDelete: SetNull)
  actualPickupStation           Station?                        @relation("BookingActualPickupStation", fields: [actualPickupStationId], references: [id], onDelete: SetNull)
  actualReturnStation           Station?                        @relation("BookingActualReturnStation", fields: [actualReturnStationId], references: [id], onDelete: SetNull)
  rentalDrivingAnalyses         RentalDrivingAnalysis[]
  handoverProtocols             BookingHandoverProtocol[]
  handoverDrafts                BookingHandoverDraft[]
  verificationChecks            CustomerVerificationCheck[]
  misuseCases                   MisuseCase[]
  priceSnapshots                BookingPriceSnapshot[]
  pricingQuote                  PricingQuote?                   @relation("PricingQuoteConsumedBooking")
  vehicleDamages                VehicleDamage[]
  whatsappConversations         WhatsAppConversation[]
  smsConversations              SmsConversation[]
  communicationConversations    CommunicationConversation[]
  communicationEvents           CommunicationEvent[]
  outboundEmails                OutboundEmail[]
  legalDocumentDeliveryEvidence LegalDocumentDeliveryEvidence[]
  documentGenerationJobs        BookingDocumentGenerationJob[]
  pickupGateAuditEvents         BookingPickupGateAuditEvent[]
  eligibilityApprovals          BookingEligibilityApproval[]
  eligibilityDecisions          BookingEligibilityDecision[]
  bookingPaymentRequests        BookingPaymentRequest[]
  drivingIntelligenceJobs       DrivingIntelligenceJob[]
  driverAttributions            DriverAttribution[]
  allowedDrivers                BookingAllowedDriver[]

  @@index([organizationId])
  @@index([customerId])
  @@index([assignedDriverId])
  @@index([vehicleId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([pickupStationId])
  @@index([returnStationId])
  // Service-window detector and availability lookups filter by
  // vehicleId + status + startDate.
  @@index([vehicleId, status, startDate])
  @@index([organizationId, status])
  @@map("bookings")
}

enum BookingDriverRole {
  PRIMARY
  ADDITIONAL
}

/// Allowed drivers for a booking — contract holder (`customerId`) remains separate.
model BookingAllowedDriver {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  bookingId      String            @map("booking_id")
  customerId     String            @map("customer_id")
  role           BookingDriverRole @default(ADDITIONAL)
  addedByUserId  String?           @map("added_by_user_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addedBy      User?        @relation("BookingAllowedDriverAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([bookingId, customerId])
  @@index([organizationId])
  @@index([bookingId])
  @@index([customerId])
  @@index([bookingId, role])
  @@map("booking_allowed_drivers")
}

