model BrakeHealthSnapshot {
  id                       String   @id @default(uuid())
  organizationId           String?  @map("organization_id")
  vehicleId                String   @map("vehicle_id")
  generatedAt              DateTime @map("generated_at")
  modelVersion             String   @map("model_version")
  modelConfigHash          String   @map("model_config_hash")
  inputFingerprint         String   @map("input_fingerprint")
  componentInstallationIds Json     @default("[]") @map("component_installation_ids")
  anchorEvidenceSummary    Json?    @map("anchor_evidence_summary")
  modeledDistanceKm        Float?   @map("modeled_distance_km")
  observedDistanceKm       Float?   @map("observed_distance_km")
  neutralGapDistanceKm     Float?   @map("neutral_gap_distance_km")
  coverageRatio            Float?   @map("coverage_ratio")
  modelingSource           String?  @map("modeling_source")
  frontPadEstimateMm       Float?   @map("front_pad_estimate_mm")
  rearPadEstimateMm        Float?   @map("rear_pad_estimate_mm")
  frontDiscEstimateMm      Float?   @map("front_disc_estimate_mm")
