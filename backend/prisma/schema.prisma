// VEHICLE INTELLIGENCE — INDIVIDUAL TIRES
// ------------------------------------------------

model Tire {
  id                         String              @id @default(uuid())
  organizationId             String              @map("organization_id")
  vehicleId                  String              @map("vehicle_id")
  tireSetId                  String?             @map("tire_set_id")
  brand                      String?
  tireModel                  String?             @map("tire_model")
  width                      Int?
  aspectRatio                Int?                @map("aspect_ratio")
  rimDiameter                Int?                @map("rim_diameter")
  loadIndex                  String?             @map("load_index")
  speedIndex                 String?             @map("speed_index")
  seasonType                 TireSeason          @default(ALL_SEASON) @map("season_type")
  runflat                    Boolean             @default(false)
  reinforced                 Boolean             @default(false)
  dotCode                    String?             @map("dot_code")
  productionWeek             Int?                @map("production_week")
  productionYear             Int?                @map("production_year")
  installedPosition          TirePosition        @map("installed_position")
  currentPosition            TirePosition        @map("current_position")
  initialTreadDepthMm        Float               @map("initial_tread_depth_mm")
  legalMinTreadMm            Float               @default(1.6) @map("legal_min_tread_mm")
  targetReplaceTreadMm       Float               @default(3.0) @map("target_replace_tread_mm")
  initialTreadEvidenceSource TireEvidenceSource? @map("initial_tread_evidence_source")
  initialTreadMeasuredAt     DateTime?           @map("initial_tread_measured_at")
  initialTreadConfirmedAt    DateTime?           @map("initial_tread_confirmed_at")
  initialTreadEvidenceId     String?             @map("initial_tread_evidence_id")
  baselineConfidence         Float?              @map("baseline_confidence")
  baselineStatus             TireBaselineStatus? @map("baseline_status")
  estimatedTreadMm           Float?              @map("estimated_tread_mm")
  estimatedWearPercent       Float?              @map("estimated_wear_percent")
  estimatedRemainingKm       Int?                @map("estimated_remaining_km")
  wearRateMmPer1000km        Float?              @map("wear_rate_mm_per_1000km")
  healthStatus               TireHealthStatus    @default(EXCELLENT) @map("health_status")
  confidenceScore            Float?              @map("confidence_score")
  confidenceLabel            String?             @map("confidence_label")
  totalKmOnTire              Float               @default(0) @map("total_km_on_tire")
  cityKm                     Float               @default(0) @map("city_km")
  highwayKm                  Float               @default(0) @map("highway_km")
  ruralKm                    Float               @default(0) @map("rural_km")
  harshAccelEvents           Int                 @default(0) @map("harsh_accel_events")
  harshBrakeEvents           Int                 @default(0) @map("harsh_brake_events")
  highLateralEvents          Int                 @default(0) @map("high_lateral_events")
  burnoutEvents              Int                 @default(0) @map("burnout_events")
  lastRecalculatedAt         DateTime?           @map("last_recalculated_at")
  active                     Boolean             @default(true)
  mountedAt                  DateTime?           @map("mounted_at")
  dismountedAt               DateTime?           @map("dismounted_at")
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")

  vehicle         Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tireSet         VehicleTireSetup?     @relation(fields: [tireSetId], references: [id], onDelete: SetNull)
  positionHistory TirePositionHistory[]
  events          TireEvent[]
  snapshots       TireHealthSnapshot[]
  measurements    TireMeasurement[]

  @@index([organizationId, vehicleId])
  @@index([vehicleId, active])
  @@index([tireSetId])
  @@map("tires")
}

model TirePositionHistory {
  id               String         @id @default(uuid())
  organizationId   String         @map("organization_id")
  vehicleId        String         @map("vehicle_id")
  tireSetId        String?        @map("tire_set_id")
  tireId           String?        @map("tire_id")
  fromPosition     TirePosition?  @map("from_position")
  toPosition       TirePosition   @map("to_position")
  changedAt        DateTime       @map("changed_at")
  odometerKm       Float?         @map("odometer_km")
  changeType       TireChangeType @map("change_type")
  rotationTemplate String?        @map("rotation_template")
  notes            String?
  createdBy        String?        @map("created_by")
  createdAt        DateTime       @default(now()) @map("created_at")

  vehicle Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tireSet VehicleTireSetup? @relation(fields: [tireSetId], references: [id], onDelete: SetNull)
  tire    Tire?             @relation(fields: [tireId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([tireSetId])
  @@index([tireId, changedAt])
  @@map("tire_position_history")
}

model TireMeasurement {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  vehicleId       String   @map("vehicle_id")
  tireId          String   @map("tire_id")
  measuredTreadMm Float    @map("measured_tread_mm")
  measuredAt      DateTime @map("measured_at")
  odometerKm      Float?   @map("odometer_km")
  measuredBy      String?  @map("measured_by")
  source          String   @default("manual")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  tire Tire @relation(fields: [tireId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([tireId, measuredAt])
  @@map("tire_measurements")
}

model TireEvent {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  vehicleId      String        @map("vehicle_id")
  tireId         String?       @map("tire_id")
  tireSetId      String?       @map("tire_set_id")
  type           TireEventType
  payload        Json?
  createdBy      String?       @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")

  vehicle Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tire    Tire?             @relation(fields: [tireId], references: [id], onDelete: SetNull)
  tireSet VehicleTireSetup? @relation(fields: [tireSetId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([tireSetId])
  @@index([tireId])
  @@map("tire_events")
}

model TireHealthSnapshot {
  id                    String              @id @default(uuid())
  organizationId        String              @map("organization_id")
  vehicleId             String              @map("vehicle_id")
  tireId                String?             @map("tire_id")
  tireSetId             String?             @map("tire_set_id")
  snapshotDate          DateTime            @map("snapshot_date")
  odometerKm            Float?              @map("odometer_km")
  estimatedTreadMm      Float?              @map("estimated_tread_mm")
  estimatedWearPercent  Float?              @map("estimated_wear_percent")
  estimatedRemainingKm  Int?                @map("estimated_remaining_km")
  citySharePercent      Float?              @map("city_share_percent")
  highwaySharePercent   Float?              @map("highway_share_percent")
  ruralSharePercent     Float?              @map("rural_share_percent")
  confidenceScore       Float?              @map("confidence_score")
  wearRateMmPer1000km   Float?              @map("wear_rate_mm_per_1000km")
  createdAt             DateTime            @default(now()) @map("created_at")
  modelVersion          String?             @map("model_version")
  modelConfigHash       String?             @map("model_config_hash")
  inputFingerprint      String?             @map("input_fingerprint")
  predictionGeneratedAt DateTime?           @map("prediction_generated_at")
  baselineSource        TireEvidenceSource? @map("baseline_source")
  evidenceSummary       Json?               @map("evidence_summary")

  vehicle                    Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tire                       Tire?               @relation(fields: [tireId], references: [id], onDelete: SetNull)
  tireSet                    VehicleTireSetup?   @relation(fields: [tireSetId], references: [id], onDelete: SetNull)
  wearDataPointsFromSnapshot TireWearDataPoint[] @relation("WearDataPointPredictionSnapshot")

  @@index([vehicleId, snapshotDate])
  @@index([tireId, snapshotDate])
  @@index([tireSetId])
  /// Partial unique enforced in SQL migration (nullable legacy rows excluded).
  @@index([tireSetId, modelVersion, inputFingerprint], map: "tire_health_snapshots_setup_model_fingerprint_idx")
  @@map("tire_health_snapshots")
}

model TireWearDataPoint {
  id                    String              @id @default(uuid())
  organizationId        String              @map("organization_id")
  vehicleId             String              @map("vehicle_id")
  tireSetId             String?             @map("tire_set_id")
  axle                  String
  distanceKm            Float               @map("distance_km")
  predictedTreadMm      Float               @map("predicted_tread_mm")
  actualTreadMm         Float               @map("actual_tread_mm")
  initialTreadMm        Float               @map("initial_tread_mm")
  climateFactor         Float               @default(1.0) @map("climate_factor")
  roadSurfaceFactor     Float               @default(1.0) @map("road_surface_factor")
  roadTypeFactor        Float               @default(1.0) @map("road_type_factor")
  drivingStyleFactor    Float               @default(1.0) @map("driving_style_factor")
  regenFactor           Float               @default(1.0) @map("regen_factor")
  curbWeightKg          Float?              @map("curb_weight_kg")
  tireWidthMm           Int?                @map("tire_width_mm")
  tireSeason            String?             @map("tire_season")
  residualError         Float?              @map("residual_error")
  createdAt             DateTime            @default(now()) @map("created_at")
  isGroundTruth         Boolean?            @map("is_ground_truth")
  actualSource          TireEvidenceSource? @map("actual_source")
  actualMeasurementId   String?             @map("actual_measurement_id")
  actualMeasuredAt      DateTime?           @map("actual_measured_at")
  predictionGeneratedAt DateTime?           @map("prediction_generated_at")
  modelVersion          String?             @map("model_version")
  modelConfigHash       String?             @map("model_config_hash")
  predictionSnapshotId  String?             @map("prediction_snapshot_id")

  vehicle            Vehicle                      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tireSet            VehicleTireSetup?            @relation(fields: [tireSetId], references: [id], onDelete: SetNull)
  actualMeasurement  VehicleTireTreadMeasurement? @relation("WearDataPointActualMeasurement", fields: [actualMeasurementId], references: [id], onDelete: Restrict)
  predictionSnapshot TireHealthSnapshot?          @relation("WearDataPointPredictionSnapshot", fields: [predictionSnapshotId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([tireSetId])
  @@index([organizationId])
  @@index([actualMeasurementId])
  @@index([predictionSnapshotId])
  @@index([isGroundTruth])
  @@map("tire_wear_data_points")
}

/// Source of truth for tire-set-attributed trip usage (km splits, harsh events, driving impact).
/// One row per (trip, tire setup) pair. Updates only when `sourceFingerprint` changes.
/// Not wired into trip finalization yet — Prompt 9 schema + repository only.
model TireTripUsageLedger {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  vehicleId              String    @map("vehicle_id")
  tripId                 String    @map("trip_id")
  tireSetupId            String    @map("tire_setup_id")
  tripStartedAt          DateTime  @map("trip_started_at")
  tripEndedAt            DateTime? @map("trip_ended_at")
  distanceKm             Float     @map("distance_km")
  cityKm                 Float     @default(0) @map("city_km")
  ruralKm                Float     @default(0) @map("rural_km")
  highwayKm              Float     @default(0) @map("highway_km")
  harshAccelerationCount Int       @default(0) @map("harsh_acceleration_count")
  harshBrakingCount      Int       @default(0) @map("harsh_braking_count")
  harshCorneringCount    Int       @default(0) @map("harsh_cornering_count")
  drivingImpactSummary   Json?     @map("driving_impact_summary")
  sourceVersion          String    @map("source_version")
  sourceFingerprint      String    @map("source_fingerprint")
  previousFingerprint    String?   @map("previous_fingerprint")
  revisionNumber         Int       @default(1) @map("revision_number")
  invalidatedAt          DateTime? @map("invalidated_at")
  invalidationReason     String?   @map("invalidation_reason")
  supersededByTripId     String?   @map("superseded_by_trip_id")
  processedAt            DateTime  @map("processed_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  vehicle   Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trip      VehicleTrip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tireSetup VehicleTireSetup @relation(fields: [tireSetupId], references: [id], onDelete: Restrict)

  @@unique([tripId, tireSetupId])
  @@index([tireSetupId, invalidatedAt])
  @@index([tireSetupId, tripStartedAt])
  @@index([vehicleId, tripStartedAt])
  @@index([organizationId, vehicleId])
  @@index([tripId])
  @@index([sourceFingerprint])
  tireDs4MotionShadowInputs TireDs4MotionShadowInputV1[]

  @@map("tire_trip_usage_ledger")
}

/// DS4 → tire shadow driving-load input (shadow only; not read by productive tire health).
model TireDs4MotionShadowInputV1 {
