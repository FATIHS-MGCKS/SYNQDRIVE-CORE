// ------------------------------------------------
// VEHICLE TRIPS
// ------------------------------------------------

enum TripStatus {
  ONGOING
  COMPLETED
  CANCELLED
}

/// Identifies the pipeline that created a canonical trip record.
/// V2_LIVE = created by the live FSM detection engine.
/// REPAIRED = created by the reconciliation/repair layer after the fact.
enum TripSource {
  V2_LIVE
  REPAIRED
}

enum TripAssignmentStatus {
  ASSIGNED_DRIVER
  ASSIGNED_BOOKING_CUSTOMER
  PRIVATE_UNASSIGNED
  UNKNOWN_ASSIGNMENT
}

enum TripAssignmentSubjectType {
  DRIVER
  BOOKING_CUSTOMER
}

enum TripBookingLinkSource {
  EXPLICIT
  TIME_WINDOW
}

/// Canonical persisted route display quality (Trip Route Architecture V2).
/// Distinct from processing/job lifecycle — see DrivingIntelligenceJob for execution state.
enum RouteQuality {
  MATCHED
  FILTERED
  RAW
}

model VehicleTrip {
  id                    String                     @id @default(uuid())
  vehicleId             String                     @map("vehicle_id")
  dimoSegmentId         String?                    @unique @map("dimo_segment_id")
  tripStatus            TripStatus                 @default(ONGOING) @map("trip_status")
  driverName            String?                    @map("driver_name")
  assignmentStatus      TripAssignmentStatus?      @map("assignment_status")
  assignmentSubjectType TripAssignmentSubjectType? @map("assignment_subject_type")
  assignmentSubjectId   String?                    @map("assignment_subject_id")
  assignedBookingId     String?                    @map("assigned_booking_id")
  bookingLinkSource     TripBookingLinkSource?     @map("booking_link_source")
  bookingCustomerId     String?                    @map("booking_customer_id")
  assignedDriverId      String?                    @map("assigned_driver_id")
  actualDriverId        String?                    @map("actual_driver_id")
  isPrivateTrip         Boolean                    @default(false) @map("is_private_trip")
  startTime             DateTime                   @map("start_time")
  endTime               DateTime?                  @map("end_time")
  startLatitude         Float?                     @map("start_latitude")
  startLongitude        Float?                     @map("start_longitude")
  endLatitude           Float?                     @map("end_latitude")
  endLongitude          Float?                     @map("end_longitude")
  distanceKm            Float?                     @map("distance_km")
  durationMinutes       Float?                     @map("duration_minutes")
  avgSpeedKmh           Float?                     @map("avg_speed_kmh")
  maxSpeedKmh           Float?                     @map("max_speed_kmh")
  drivingScore          Float?                     @map("driving_score")

  fuelUsedLiters          Float?  @map("fuel_used_liters")
  avgConsumptionLPer100Km Float?  @map("avg_consumption_l_per_100km")
  fuelConfidence          String? @map("fuel_confidence")

  energyUsedKwh             Float?  @map("energy_used_kwh")
  avgConsumptionKwhPer100Km Float?  @map("avg_consumption_kwh_per_100km")
  energyConfidence          String? @map("energy_confidence")

  citySharePercent    Float? @map("city_share_percent")
  highwaySharePercent Float? @map("highway_share_percent")
  countrySharePercent Float? @map("country_share_percent")

  outsideTemperatureStartC Float? @map("outside_temperature_start_c")
  engineTempStartC         Float? @map("engine_temp_start_c")
  engineTempEndC           Float? @map("engine_temp_end_c")
  avgRpm                   Float? @map("avg_rpm")
  avgThrottlePosition      Float? @map("avg_throttle_position")
  avgEngineLoad            Float? @map("avg_engine_load")

  speedingPercent  Float? @map("speeding_percent")
  maxOverSpeedKmh  Float? @map("max_over_speed_kmh")
  speedingSegments Int?   @map("speeding_segments")

  speedingSectionsJson Json?  @map("speeding_sections_json")
  speedingSectionCount Int?   @map("speeding_section_count")
  speedingDistanceM    Int?   @map("speeding_distance_m")
  speedingDurationS    Int?   @map("speeding_duration_s")
  speedingExposurePct  Float? @map("speeding_exposure_pct")
  avgOverSpeedKmh      Float? @map("avg_over_speed_kmh")

  harshBrakeCount  Int @default(0) @map("harsh_brake_count")
  harshAccelCount  Int @default(0) @map("harsh_accel_count")
  harshCornerCount Int @default(0) @map("harsh_corner_count")

  accelerationEventCount  Int       @default(0) @map("acceleration_event_count")
  brakingEventCount       Int       @default(0) @map("braking_event_count")
  abuseEventCount         Int       @default(0) @map("abuse_event_count")
  hardAccelerationCount   Int       @default(0) @map("hard_acceleration_count")
  hardBrakingCount        Int       @default(0) @map("hard_braking_count")
  fullBrakingCount        Int       @default(0) @map("full_braking_count")
  totalAccelerationEvents Int       @default(0) @map("total_acceleration_events")
  hardAccelerationEvents  Int       @default(0) @map("hard_acceleration_events")
  totalBrakingEvents      Int       @default(0) @map("total_braking_events")
  hardBrakingEvents       Int       @default(0) @map("hard_braking_events")
  fullBrakingEvents       Int       @default(0) @map("full_braking_events")
  corneringEvents         Int       @default(0) @map("cornering_events")
  abuseEvents             Int       @default(0) @map("abuse_events")
  speedingEvents          Int       @default(0) @map("speeding_events")
  possibleImpactCount     Int       @default(0) @map("possible_impact_count")
  kickdownCount           Int       @default(0) @map("kickdown_count")
  coldEngineAbuseCount    Int       @default(0) @map("cold_engine_abuse_count")
  longIdleCount           Int       @default(0) @map("long_idle_count")
  abuseScore              Float?    @map("abuse_score")
  behaviorSummaryJson     Json?     @map("behavior_summary_json")
  behaviorEnrichedAt      DateTime? @map("behavior_enriched_at")

  // ── Enrichment status tracking ──────────────────────────────────────────
  // Values: PENDING | IN_PROGRESS | COMPLETED | SKIPPED_NO_HF_DATA | FAILED_TRANSIENT | FAILED_PERMANENT
  // String (not enum) to avoid costly ALTER TYPE migrations and allow extensibility.
  behaviorEnrichmentStatus    String?   @map("behavior_enrichment_status")
  behaviorEnrichmentAttempts  Int       @default(0) @map("behavior_enrichment_attempts")
  behaviorEnrichmentError     String?   @map("behavior_enrichment_error")
  behaviorEnrichmentStartedAt DateTime? @map("behavior_enrichment_started_at")
  drivingImpactComputedAt     DateTime? @map("driving_impact_computed_at")

  // ── Canonical post-trip analysis status (separate from trip COMPLETED) ───
  // Values: PENDING | IN_PROGRESS | PARTIAL | COMPLETED | FAILED | SKIPPED
  tripAnalysisStatus   String?   @map("trip_analysis_status")
  analysisQueuedAt     DateTime? @map("analysis_queued_at")
  analysisStartedAt    DateTime? @map("analysis_started_at")
  analysisPartialAt    DateTime? @map("analysis_partial_at")
  analysisCompletedAt  DateTime? @map("analysis_completed_at")
  analysisFailedAt     DateTime? @map("analysis_failed_at")
  analysisFailedReason String?   @map("analysis_failed_reason")
  analysisLatencyMs    Int?      @map("analysis_latency_ms")
  analysisStagesJson   Json?     @map("analysis_stages_json")

  detectionProfile         VehicleDetectionProfile? @map("detection_profile")
  startDetectionMode       String?                  @map("start_detection_mode")
  endDetectionMode         String?                  @map("end_detection_mode")
  startConfidence          DetectionConfidence?     @map("start_confidence")
  endConfidence            DetectionConfidence?     @map("end_confidence")
  possibleStartAt          DateTime?                @map("possible_start_at")
  possibleEndAt            DateTime?                @map("possible_end_at")
  firstActivityAt          DateTime?                @map("first_activity_at")
  lastActivityAt           DateTime?                @map("last_activity_at")
  routeTrackingStartedAt   DateTime?                @map("route_tracking_started_at")
  drivingTrackingStartedAt DateTime?                @map("driving_tracking_started_at")
  rawDetectionMeta         Json?                    @map("raw_detection_meta")

  gapEnded   Boolean   @default(false) @map("gap_ended")
  enrichedAt DateTime? @map("enriched_at")

  // ── Canonical ownership and source ──────────────────────────────────────
  // tripSource identifies which pipeline created this trip.
  // isRepaired is true when a repair was applied after initial creation.
  tripSource        TripSource @default(V2_LIVE) @map("trip_source")
  isRepaired        Boolean    @default(false) @map("is_repaired")
  mergeParentTripId String?    @map("merge_parent_trip_id")

  // ── UI-facing readiness status ───────────────────────────────────────────
  // Simple string statuses for frontend display. Values:
  //   qualityStatus:         VERIFIED | LOW_DATA | ANOMALY
  //   behaviorSummaryStatus: PENDING | READY | SKIPPED | FAILED
  //   drivingImpactStatus:   PENDING | READY | SKIPPED | FAILED
  qualityStatus         String? @map("quality_status")
  behaviorSummaryStatus String? @map("behavior_summary_status")
  drivingImpactStatus   String? @map("driving_impact_status")

  tireUsageAttributionStatus String?   @map("tire_usage_attribution_status")
  tireUsageProcessedAt       DateTime? @map("tire_usage_processed_at")

  createdAt DateTime @default(now()) @map("created_at")

  vehicle                             Vehicle                              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  waypoints                           VehicleTripWaypoint[]
  tireTripUsageLedgers                TireTripUsageLedger[]
  events                              DrivingEvent[]
  behaviorEvents                      TripBehaviorEvent[]
  misuseCases                         MisuseCase[]
  tripAssessabilities                 TripAssessability[]
  drivingEvidence                     DrivingEvidence[]
  drivingAnalysisRuns                 DrivingAnalysisRun[]
  diV0ShadowRuns                      DiV0ShadowRun[]
  diV0ShadowIntervals                 DiV0ShadowInterval[]
  diV0S4WorkItems                     DiV0S4WorkItem[]
  diV0S4EvidenceSnapshots             DiV0S4EvidenceSnapshot[]
  drivingIntelligenceJobs             DrivingIntelligenceJob[]
  driverAttributions                  DriverAttribution[]
  repairs                             TripRepair[]
  rpmWebhookCandidates                RpmWebhookCandidate[]
  batteryMeasurementSessions          BatteryMeasurementSession[]
  batteryShutdownEvidenceObservations BatteryShutdownEvidenceObservation[]
  batteryTripShutdownContext          BatteryTripShutdownContext?
  batteryGeneralizedEvidenceObservations BatteryGeneralizedEvidenceObservation[]
  batteryRestSessionsAsCandidate      BatteryRestSession[] @relation("RestSessionCandidateTrip")
  batteryRestSessionsAsConfirmed      BatteryRestSession[] @relation("RestSessionConfirmedTrip")
  dimoBrakingEventIntakes             DimoBrakingEventIntake[]
  brakingEventLedgerEntries           BrakingEventLedger[]
  routeArtifact                       VehicleTripRouteArtifact?

  @@index([vehicleId])
  @@index([startTime])
  @@index([tripStatus])
  @@index([tripSource])
  @@index([assignmentStatus, isPrivateTrip])
  @@index([assignmentSubjectType, assignmentSubjectId])
  @@index([assignedBookingId])
  @@index([behaviorEnrichmentStatus])
  @@index([tripAnalysisStatus])
  @@index([tireUsageAttributionStatus])
  // Composite index for the hot "trips by vehicle ordered by startTime desc"
  // query used by trips list, rental analysis, driver score and hydration.
  // PostgreSQL can walk this index in reverse for free, so no DESC clause.
  @@index([vehicleId, startTime])
  @@map("vehicle_trips")
}

model VehicleTripWaypoint {
  id         String   @id @default(uuid())
  tripId     String   @map("trip_id")
  latitude   Float
  longitude  Float
  speedKmh   Float?   @map("speed_kmh")
  heading    Float?
  recordedAt DateTime @map("recorded_at")

  trip VehicleTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([recordedAt])
  @@map("vehicle_trip_waypoints")
}

/// Canonical 1:1 route geometry artifact per completed trip (Route V2).
/// Geometry is stored as JSON arrays of [longitude, latitude] pairs.
/// RAW observations remain on VehicleTripWaypoint — not duplicated here unless quality is RAW-only metadata row.
model VehicleTripRouteArtifact {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  vehicleId      String @map("vehicle_id")
  tripId         String @unique @map("trip_id")

  routeQuality RouteQuality @map("route_quality")

  matchedGeometryJson  Json? @map("matched_geometry_json")
  filteredGeometryJson Json? @map("filtered_geometry_json")

  matchConfidence Float? @map("match_confidence")
  matchCoverage   Float? @map("match_coverage")

  provider         String? @map("provider")
  algorithmVersion String  @map("algorithm_version")
  inputFingerprint String  @map("input_fingerprint")

  sourcePointCount   Int  @map("source_point_count")
  filteredPointCount Int  @default(0) @map("filtered_point_count")
  matchedPointCount  Int? @map("matched_point_count")
  chunkCount         Int? @map("chunk_count")
  failedChunkCount   Int? @map("failed_chunk_count")

  processedAt     DateTime? @map("processed_at")
  failureReason   String?   @map("failure_reason")
  diagnosticsJson Json?     @map("diagnostics_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip    VehicleTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId, vehicleId])
  @@index([inputFingerprint])
  @@index([algorithmVersion])
  @@map("vehicle_trip_route_artifacts")
}

// ── Vehicle Energy Events (Refuel + Recharge, detected via DIMO segments) ──
// Canonical contract: DIMO's native RefuelDetector / RechargeDetector emit
// segments via the same `segments(mechanism: refuel|recharge)` GraphQL query
// that we already consume for trip detection. We persist each segment as a
// first-class event so the Trips-Tab timeline can render "refill / recharge
// between trips" without merging trip-side heuristics into the same table.

enum EnergyEventKind {
  REFUEL
  RECHARGE
}

enum EnergyEventConfidence {
  HIGH
  MEDIUM
  LOW
}

/// RFRF F4 — explicit native vs fallback detection source (NULL = legacy native-era).
/// ERD E5 — canonical HV charge session product projection (RECHARGE only).
enum VehicleEnergyEventDetectionSource {
  DIMO_NATIVE
  SYNQDRIVE_RAW_FUEL_FALLBACK
  SYNQDRIVE_ERD_RECHARGE_PROJECTION
}

model VehicleEnergyEvent {
  id                           String                             @id @default(uuid())
  vehicleId                    String                             @map("vehicle_id")
  /// Real DIMO segment / coalesced legacy identity when present; NULL allowed for ERD telemetry-only projections.
  dimoSegmentId                String?                            @unique @map("dimo_segment_id")
  /// NULL = legacy native-era row; never means raw fuel fallback (F4 contract).
  detectionSource              VehicleEnergyEventDetectionSource? @map("detection_source")
  /// Canonical fallback idempotency key (candidateIdentityKey); NULL for legacy/native.
  /// ERD RECHARGE projection uses stable physical projection key (see E5 identity v1).
  /// SQL CHECK `vehicle_energy_events_source_identity_check` enforces pairings (migration SQL only).
  sourceEventKey               String?                            @map("source_event_key") @db.VarChar(512)
  /// ERD E5 — current canonical HvChargeSession authority for this product projection (nullable; handoff updates FK).
  canonicalChargeSessionId     String?                            @unique @map("canonical_charge_session_id")
  kind                         EnergyEventKind
  detectionMechanism           String                             @map("detection_mechanism")
  startTime                    DateTime              @map("start_time")
  endTime                      DateTime              @map("end_time")
  durationSeconds              Int                   @map("duration_seconds")
  startLatitude                Float?                @map("start_latitude")
  startLongitude               Float?                @map("start_longitude")
  endLatitude                  Float?                @map("end_latitude")
  endLongitude                 Float?                @map("end_longitude")
  fuelDeltaLiters              Float?                @map("fuel_delta_liters")
  fuelDeltaPercent             Float?                @map("fuel_delta_percent")
  socDeltaPercent              Float?                @map("soc_delta_percent")
  energyDeltaKwh               Float?                @map("energy_delta_kwh")
  odometerStartKm              Float?                @map("odometer_start_km")
  odometerEndKm                Float?                @map("odometer_end_km")
  confidence                   EnergyEventConfidence @default(MEDIUM)
  rawDetectionMeta             Json?                 @map("raw_detection_meta")
  /// REFUEL only: observed material fuel-level transition window (not pump/nozzle duration).
  fuelLevelRiseStart           DateTime?             @map("fuel_level_rise_start")
  fuelLevelRiseEnd             DateTime?             @map("fuel_level_rise_end")
  fuelLevelRiseDurationSeconds Int?                  @map("fuel_level_rise_duration_seconds")
  createdAt                    DateTime              @default(now()) @map("created_at")
  updatedAt                    DateTime              @updatedAt @map("updated_at")

  vehicle               Vehicle                                  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  canonicalChargeSession HvChargeSession?                        @relation(fields: [canonicalChargeSessionId], references: [id], onDelete: SetNull)
  fuelStationEnrichment     VehicleEnergyEventFuelStationEnrichment?
  chargingStationEnrichment VehicleEnergyEventChargingStationEnrichment?
  refuelReconciliation  VehicleEnergyEventRefuelReconciliation?

  @@unique([vehicleId, sourceEventKey])
  @@index([vehicleId])
  @@index([vehicleId, startTime])
  @@index([vehicleId, kind, startTime])
  @@index([vehicleId, kind, createdAt])
  @@index([kind])
  @@index([detectionSource])
  @@index([canonicalChargeSessionId])
  @@map("vehicle_energy_events")
}

/// G2.1 physical-refuel reconciliation / settlement persistence (feature-flagged runtime).
enum PhysicalRefuelFinalityState {
  PROVISIONAL
  SETTLING
  FINAL_CANONICAL
  FINAL_DISTINCT
  INSUFFICIENT_EVIDENCE
}

model VehicleEnergyEventRefuelReconciliation {
  id                              String                      @id @default(uuid())
  energyEventId                   String                      @unique @map("energy_event_id")
  vehicleId                       String                      @map("vehicle_id")
  reconciliationGroupId           String                      @map("reconciliation_group_id")
  classification                  String
  finalityState                   PhysicalRefuelFinalityState @map("finality_state")
  canonicalEventId                String?                     @map("canonical_event_id")
  enrichmentEligible              Boolean                     @default(false) @map("enrichment_eligible")
  settlementWindowOpen            Boolean                     @default(true) @map("settlement_window_open")
  lateSiblingConflict             Boolean                     @default(false) @map("late_sibling_conflict")
  reason                          String
  reasonCodes                     Json                        @default("[]") @map("reason_codes")
  coordinateLatitude              Float?                      @map("coordinate_latitude")
  coordinateLongitude             Float?                      @map("coordinate_longitude")
  coordinateSource                String?                     @map("coordinate_source")
  coordinateSelectorVersion       String?                     @map("coordinate_selector_version")
  coordinateSelectionStatus       String?                     @map("coordinate_selection_status")
  coordinateEvidenceFingerprint   String?                     @map("coordinate_evidence_fingerprint")
  routeEvidenceFingerprint        String?                     @map("route_evidence_fingerprint")
  routeEvidenceStabilizationUntil DateTime?                   @map("route_evidence_stabilization_until")
  coordinateRetryCount            Int                         @default(0) @map("coordinate_retry_count")
  nextCoordinateRetryAt           DateTime?                   @map("next_coordinate_retry_at")
  lastCoordinateAttemptAt         DateTime?                   @map("last_coordinate_attempt_at")
  enrichmentEnqueuedAt            DateTime?                   @map("enrichment_enqueued_at")
  nextReconciliationAt            DateTime?                   @map("next_reconciliation_at")
  reconciledAt                    DateTime                    @default(now()) @map("reconciled_at")
  updatedAt                       DateTime                    @updatedAt @map("updated_at")

  energyEvent VehicleEnergyEvent @relation(fields: [energyEventId], references: [id], onDelete: Cascade)

  @@index([vehicleId, reconciledAt])
  @@index([vehicleId, finalityState])
  @@index([finalityState, nextReconciliationAt])
  @@index([enrichmentEligible, enrichmentEnqueuedAt])
  @@index([nextCoordinateRetryAt])
  @@index([reconciliationGroupId])
  @@map("vehicle_energy_event_refuel_reconciliations")
}

/// RFRF F2 — raw fuel refuel fallback candidate staging (Option D).
enum RawRefuelCandidateLifecycleState {
  INSUFFICIENT
  OBSERVED
  SETTLING
  READY_FOR_PERSIST
  REJECTED
  PROMOTED
  /// F5 — authoritative native SAME convergence; no fallback VEE created.
  CONVERGED_NATIVE
}

enum RawRefuelCandidateSignalChannel {
  ABSOLUTE_LITERS
  RELATIVE_PERCENT
}

enum RawRefuelAbsoluteSignalTrust {
  TRUSTED
  UNTRUSTED
  UNKNOWN
}

enum RawRefuelCandidateRecoveryLastOutcome {
  SUCCESS_CONVERGED
  SUCCESS_PROMOTED
  SUCCESS_MATURED_READY
  PENDING_NATIVE_RECONCILIATION
  NO_MATCHING_OBSERVATION
  NO_NEW_EVIDENCE
  SAMPLE_FETCH_FAILED
  NO_DIMO_TOKEN
  CAPABILITY_NOT_SUPPORTED
  AMBIGUOUS_RECOVERY_OBSERVATION
  TERMINAL_NO_ACTION
}

enum RawRefuelCandidateRejectionReason {
  INSUFFICIENT_PRE_PLATEAU
  INSUFFICIENT_POST_PLATEAU
  RISE_TOO_SMALL
  SAMPLE_GAP_TOO_LARGE
  RISE_NOT_STABLE
  SENSOR_RESET_SUSPECTED
  UNIT_NOT_TRUSTED
  VEHICLE_CAPABILITY_UNSUPPORTED
  MOTION_EVIDENCE_CONFLICT
  DUPLICATE_NATIVE_EVIDENCE
  EVIDENCE_STILL_SETTLING
  DUPLICATE_FALLBACK_EVIDENCE
  NON_FUEL_POWERTRAIN
}

model RawRefuelCandidate {
  id                          String                             @id @default(uuid())
  organizationId              String                             @map("organization_id")
  vehicleId                   String                             @map("vehicle_id")
  /// Assigned once when identity evidence is sufficient; nullable while INSUFFICIENT.
  candidateIdentityKey        String?                            @map("candidate_identity_key")
  detectionVersion            String                             @map("detection_version")
  detectorVersion             String                             @map("detector_version")
  signalChannel               RawRefuelCandidateSignalChannel    @map("signal_channel")
  lifecycleState              RawRefuelCandidateLifecycleState   @map("lifecycle_state")
  rejectionReason             RawRefuelCandidateRejectionReason? @map("rejection_reason")
  evidenceRevisionFingerprint String                             @map("evidence_revision_fingerprint")
  physicalEvidenceStart       DateTime?                          @map("physical_evidence_start")
  physicalEvidenceEnd         DateTime?                          @map("physical_evidence_end")
  riseOnsetAt                 DateTime?                          @map("rise_onset_at")
  riseEndAt                   DateTime?                          @map("rise_end_at")
  preFuelAbsoluteLiters       Float?                             @map("pre_fuel_absolute_liters")
  postFuelAbsoluteLiters      Float?                             @map("post_fuel_absolute_liters")
  deltaAbsoluteLiters         Float?                             @map("delta_absolute_liters")
  preFuelRelativePercent      Float?                             @map("pre_fuel_relative_percent")
  postFuelRelativePercent     Float?                             @map("post_fuel_relative_percent")
  deltaRelativePercent        Float?                             @map("delta_relative_percent")
  prePlateauSampleCount       Int?                               @map("pre_plateau_sample_count")
  postPlateauSampleCount      Int?                               @map("post_plateau_sample_count")
  totalSampleCount            Int?                               @map("total_sample_count")
  maxSampleGapSeconds         Int?                               @map("max_sample_gap_seconds")
  absoluteSignalTrust         RawRefuelAbsoluteSignalTrust?      @map("absolute_signal_trust")
  relativeSignalAvailable     Boolean?                           @map("relative_signal_available")
  routeEvidenceAvailable      Boolean?                           @map("route_evidence_available")
  stationaryEvidenceAvailable Boolean?                           @map("stationary_evidence_available")
  scanWindowStart             DateTime?                          @map("scan_window_start")
  scanWindowEnd               DateTime?                          @map("scan_window_end")
  signalProvider              String?                            @map("signal_provider")
  evidenceMeta                Json?                              @map("evidence_meta")
  qualityMeta                 Json?                              @map("quality_meta")
  firstObservedAt             DateTime                           @map("first_observed_at")
  lastObservedAt              DateTime                           @map("last_observed_at")
  recoveryNextAttemptAt       DateTime?                          @map("recovery_next_attempt_at")
  recoveryLastAttemptAt       DateTime?                          @map("recovery_last_attempt_at")
  recoveryAttemptCount        Int                                @default(0) @map("recovery_attempt_count")
  recoveryLastOutcome         RawRefuelCandidateRecoveryLastOutcome? @map("recovery_last_outcome")
  recoveryLeaseExpiresAt      DateTime?                          @map("recovery_lease_expires_at")
  createdAt                   DateTime                           @default(now()) @map("created_at")
  updatedAt                   DateTime                           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, candidateIdentityKey])
  @@index([organizationId])
  @@index([vehicleId, lifecycleState])
  @@index([vehicleId, physicalEvidenceStart])
  @@index([vehicleId, firstObservedAt])
  @@index([lifecycleState, updatedAt])
  @@index([lifecycleState, recoveryNextAttemptAt])
  @@map("raw_refuel_candidates")
}

/// Async OSM fuel-station resolution for persisted REFUEL energy events (Phase D).
enum FuelStationEnrichmentProcessingStatus {
