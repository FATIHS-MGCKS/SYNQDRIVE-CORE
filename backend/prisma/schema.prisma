  @@index([tireSetupId, inputFingerprint], map: "tire_wear_v3_cal_snap_setup_fp_idx")
  @@index([tireSetupId, calibrationEligibilityDigest], map: "tire_wear_v3_cal_snap_setup_elig_idx")
  @@map("tire_wear_v3_calibration_snapshot_v1")
}

