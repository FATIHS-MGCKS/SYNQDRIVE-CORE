model AccessReviewDecision {
  id                          String                              @id @default(uuid())
  itemId                      String                              @map("item_id")
  campaignId                  String                              @map("campaign_id")
  organizationId              String                              @map("organization_id")
  reviewerUserId              String                              @map("reviewer_user_id")
  decision                    AccessReviewDecisionType
  reason                      String
  decidedAt                   DateTime                            @map("decided_at")
  resultApplicationStatus     AccessReviewResultApplicationStatus @default(PENDING) @map("result_application_status")
  appliedAt                   DateTime?                           @map("applied_at")
  applicationError            String?                             @map("application_error")
  modifyPayload               Json?                               @map("modify_payload")
  idempotencyKey              String                              @unique @map("idempotency_key")
  membershipVersionAtDecision Int                                 @map("membership_version_at_decision")
  createdAt                   DateTime                            @default(now()) @map("created_at")

  item         AccessReviewItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  campaign     AccessReviewCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewer     User                 @relation("AccessReviewDecisions", fields: [reviewerUserId], references: [id], onDelete: Restrict)

