  recalculationModelVersion     String? @map("recalculation_model_version")

  lastRecalculatedAt DateTime? @map("last_recalculated_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId, vehicleId])
  @@map("brake_health_current")
}

enum BrakeHealthAlertStatus {
  OPEN
  RESOLVED
}

enum BrakeHealthAlertCategory {
  WEAR
  SAFETY
  DATA_QUALITY
}

enum BrakeHealthAlertResolutionReason {
  COMPONENT_REPLACED
  NEW_MEASUREMENT
  DTC_CLEARED
  EVIDENCE_RESOLVED
  SPEC_CONFIRMED
  COVERAGE_REPAIRED
  EVIDENCE_CLEARED
  SUPERSEDED
}

model BrakeHealthAlert {
  id                      String                            @id @default(uuid())
  organizationId          String                            @map("organization_id")
  vehicleId               String                            @map("vehicle_id")
  componentInstallationId String?                           @map("component_installation_id")
  alertType               String                            @map("alert_type")
  category                BrakeHealthAlertCategory
  reasonCode              String                            @map("reason_code")
  severity                String
  axle                    String?
  displayMode             String                            @map("display_mode")
  evidenceFingerprint     String                            @map("evidence_fingerprint")
  dedupeKey               String                            @map("dedupe_key")
  modelSnapshotId         String?                           @map("model_snapshot_id")
  status                  BrakeHealthAlertStatus            @default(OPEN)
  resolutionReason        BrakeHealthAlertResolutionReason? @map("resolution_reason")
  resolvedAt              DateTime?                         @map("resolved_at")
  openedAt                DateTime                          @default(now()) @map("opened_at")
  lastSeenAt              DateTime                          @default(now()) @map("last_seen_at")
  inputFingerprint        String?                           @map("input_fingerprint")
  lastNotifiedFingerprint String?                           @map("last_notified_fingerprint")
