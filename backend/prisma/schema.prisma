  hardBrakePer100Km    Float? @map("hard_brake_per_100km")
  extremeBrakePer100Km Float? @map("extreme_brake_per_100km")
  fullBrakingPer100Km  Float? @map("full_braking_per_100km")
  kickdownPer100Km     Float? @map("kickdown_per_100km")
  launchLikePer100Km   Float? @map("launch_like_per_100km")

  // Rolling behavior metrics
  brakesPer100Km            Float? @map("brakes_per_100km")
  stopDensity               Float? @map("stop_density")
  highSpeedBrakeShare       Float? @map("high_speed_brake_share")
  meanBrakeEnergyPerKm      Float? @map("mean_brake_energy_per_km")
  p95NegativeDecel          Float? @map("p95_negative_decel")
  // P42 — measured/reconstructed vs ESTIMATED_PROXY braking kinematics
  p95NegativeDecelMeasured  Float? @map("p95_negative_decel_measured")
  p95NegativeDecelProxy     Float? @map("p95_negative_decel_proxy")
  meanBrakeEnergyProxyPerKm Float? @map("mean_brake_energy_proxy_per_km")

  // Rolling stress scores (distance-weighted)
  longitudinalStressScore Float? @map("longitudinal_stress_score")
  brakingStressScore      Float? @map("braking_stress_score")
  stopGoStressScore       Float? @map("stop_go_stress_score")
  highSpeedStressScore    Float? @map("high_speed_stress_score")
  thermalBrakeStressScore Float? @map("thermal_brake_stress_score")
  /// Rolling composite vehicle stress (0–100). Higher = more load. Mapped to legacy column.
  drivingStressScore      Float? @map("driving_style_score")
  /// @deprecated No longer updated on recompute; historical values may remain.
  safetyScore             Float? @map("safety_score")

  modelVersion String @map("model_version")

  // P41 — rolling provenance aggregate (distance-weighted where applicable)
  primarySource           String? @map("primary_source")
  measuredShare           Float?  @map("measured_share")
  providerClassifiedShare Float?  @map("provider_classified_share")
  reconstructedShare      Float?  @map("reconstructed_share")
  estimatedProxyShare     Float?  @map("estimated_proxy_share")
  contextOnlyShare        Float?  @map("context_only_share")
  measurementCoverage     Float?  @map("measurement_coverage")
  hardwareProfile         String? @map("hardware_profile")
  capabilityVersion       String? @map("capability_version")
  healthEligibility       String? @map("health_eligibility")
  provenanceMaturity      String? @map("provenance_maturity")
  provenanceVersion       String? @map("provenance_version")

  // P43 — rolling structured load components snapshot
  loadComponentsJson Json? @map("load_components_json")

  // P46 — rolling window manifest (trip count, distance, source quality, exclusions)
  rollingWindowJson Json? @map("rolling_window_json")

  updatedAt DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId, vehicleId])
  @@map("vehicle_driving_impact_current")
}

