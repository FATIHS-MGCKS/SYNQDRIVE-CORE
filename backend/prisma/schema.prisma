// ------------------------------------------------
// VEHICLE DOCUMENT EXTRACTION (AI Upload)
// ------------------------------------------------

model VehicleDocumentExtraction {
  id                        String                               @id @default(uuid())
  vehicleId                 String?                              @map("vehicle_id")
  organizationId            String?                              @map("organization_id")
  uploadContextType         String?                              @map("upload_context_type")
  uploadContextId           String?                              @map("upload_context_id")
  // Legacy field — mirrors effectiveDocumentType for backward compatibility.
  documentType              DocumentExtractionType?              @map("document_type")
  requestedDocumentType     DocumentExtractionType?              @map("requested_document_type")
  effectiveDocumentType     DocumentExtractionType?              @map("effective_document_type")
  classificationMode        DocumentExtractionClassificationMode @default(MANUAL) @map("classification_mode")
  detectedDocumentType      DocumentExtractionType?              @map("detected_document_type")
  classificationConfidence  Decimal?                             @map("classification_confidence") @db.Decimal(5, 4)
  status                    DocumentExtractionStatus             @default(PENDING) @map("status")
  processingStage           DocumentExtractionStage              @default(UPLOAD) @map("processing_stage")
  errorPhase                DocumentExtractionErrorPhase?        @map("error_phase")
  errorCode                 String?                              @map("error_code")
  processingAttempts        Int                                  @default(0) @map("processing_attempts")
  ocrProvider               String?                              @map("ocr_provider")
  ocrModel                  String?                              @map("ocr_model")
  extractionProvider        String?                              @map("extraction_provider")
  extractionModel           String?                              @map("extraction_model")
  ocrPageCount              Int?                                 @map("ocr_page_count")
  sourceFileName            String?                              @map("source_file_name")
  sourceFileUrl             String?                              @map("source_file_url")
  // Private object-storage key for the stored upload (NOT publicly served).
  // sourceFileUrl is kept for backward compatibility / domain apply links.
  objectKey                 String?                              @map("object_key")
  storageProvider           String?                              @map("storage_provider")
  mimeType                  String?                              @map("mime_type")
  sizeBytes                 Int?                                 @map("size_bytes")
  contentSha256             String?                              @map("content_sha256")
  uploadDuplicateStatus     String?                              @map("upload_duplicate_status")
  relatedExtractionId       String?                              @map("related_extraction_id")
  reuploadReason            String?                              @map("reupload_reason")
  extractedData             Json?                                @map("extracted_data")
  // Plausibility result produced by the worker (informational; never blocks storage).
  plausibility              Json?                                @map("plausibility")
  confirmedData             Json?                                @map("confirmed_data")
  errorMessage              String?                              @map("error_message")
  queuedAt                  DateTime?                            @map("queued_at")
  processedAt               DateTime?                            @map("processed_at")
  appliedAt                 DateTime?                            @map("applied_at")
  processingStartedAt       DateTime?                            @map("processing_started_at")
  ocrCompletedAt            DateTime?                            @map("ocr_completed_at")
  classificationCompletedAt DateTime?                            @map("classification_completed_at")
  extractionCompletedAt     DateTime?                            @map("extraction_completed_at")
  processingCompletedAt     DateTime?                            @map("processing_completed_at")
  nextRetryAt               DateTime?                            @map("next_retry_at")
  cancelledAt               DateTime?                            @map("cancelled_at")
  cancelledById             String?                              @map("cancelled_by_id")
  confirmedById             String?                              @map("confirmed_by_id")
  appliedById               String?                              @map("applied_by_id")
  fileDeletedById           String?                              @map("file_deleted_by_id")
  fileDeletedAt             DateTime?                            @map("file_deleted_at")
  createdById               String?                              @map("created_by_id")
  serviceEventId            String?                              @map("service_event_id")
  createdAt                 DateTime                             @default(now()) @map("created_at")
  updatedAt                 DateTime                             @updatedAt @map("updated_at")

  vehicle                           Vehicle?                          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  relatedExtraction                 VehicleDocumentExtraction?        @relation("UploadDuplicateRelated", fields: [relatedExtractionId], references: [id], onDelete: SetNull)
  relatedReuploads                  VehicleDocumentExtraction[]       @relation("UploadDuplicateRelated")
  contentAnchor                     DocumentExtractionContentAnchor?  @relation("ContentAnchorCanonical")
  batteryEvidence                   BatteryEvidence[]
  batteryGroundTruthEvents          BatteryGroundTruthEvent[]
  brakeEvidence                     BrakeEvidence[]
  vehicleBatteryReferenceCapacities VehicleBatteryReferenceCapacity[]
  vehicleMotionPhysicsReferences    VehicleMotionPhysicsReference[]
  fines                             Fine[]
  orgInvoices                       OrgInvoice[]
  serviceEvents                     VehicleServiceEvent[]
  damages                           VehicleDamage[]
  tireTreadMeasurements             VehicleTireTreadMeasurement[]
  archiveIndex                      DocumentExtractionArchiveIndex?

  @@index([vehicleId])
  @@index([organizationId, uploadContextType, uploadContextId])
  @@index([status])
  @@index([organizationId, createdAt])
  @@index([organizationId, contentSha256])
  @@index([organizationId, uploadDuplicateStatus])
  @@index([relatedExtractionId])
  @@index([vehicleId, createdAt])
  @@index([status, updatedAt])
  @@map("vehicle_document_extractions")
}

