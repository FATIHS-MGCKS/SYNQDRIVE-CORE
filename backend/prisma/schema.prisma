/// Tenant voice product entitlement — plan reference is provider-agnostic (no hardcoded Stripe fields).
model VoiceSubscription {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planCode                  String                  @map("plan_code")
  planCatalogVersion        String                  @default("2026-07-17") @map("plan_catalog_version")
  planReference             String?                 @map("plan_reference")
  status                    VoiceSubscriptionStatus @default(PENDING)
  setupFeeCents             Int                     @default(0) @map("setup_fee_cents")
  setupFeePaidAt            DateTime?               @map("setup_fee_paid_at")
  pendingPlanCode           String?                 @map("pending_plan_code")
  pendingPlanCatalogVersion String?                 @map("pending_plan_catalog_version")
  pendingPlanEffectiveAt    DateTime?               @map("pending_plan_effective_at")
  trialEndsAt               DateTime?               @map("trial_ends_at")
  currentPeriodStart        DateTime?               @map("current_period_start")
  currentPeriodEnd          DateTime?               @map("current_period_end")
  activatedAt               DateTime?               @map("activated_at")
  suspendedAt               DateTime?               @map("suspended_at")
  cancelledAt               DateTime?               @map("cancelled_at")
  archivedAt                DateTime?               @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@map("voice_subscriptions")
}

/// Per-tenant provider account binding (Twilio subaccount, ElevenLabs workspace, etc.).
model VoiceProviderAccount {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider          VoiceControlPlaneProvider  @map("provider")
  accountType       VoiceProviderAccountType   @map("account_type")
  maskedExternalRef String                     @map("masked_external_ref")
  /// Opaque vault reference — never store plaintext credentials.
  secretRef         String?                    @map("secret_ref")
  region            String?
  edge              String?
  status            VoiceProviderAccountStatus @default(PENDING)
  lastHealthCheckAt DateTime?                  @map("last_health_check_at")
  lastSyncedAt      DateTime?                  @map("last_synced_at")
  healthMessage     String?                    @map("health_message")
  archivedAt        DateTime?                  @map("archived_at")

  phoneNumbers VoicePhoneNumber[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, provider, accountType])
  @@index([organizationId, status])
  @@index([provider, status])
  @@map("voice_provider_accounts")
}

/// Org-scoped phone inventory with protected E.164 and Twilio SID references.
model VoicePhoneNumber {
  id                String               @id @default(uuid())
  organizationId    String               @map("organization_id")
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerAccountId String               @map("provider_account_id")
  providerAccount   VoiceProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Restrict)

  maskedPhoneNumber      String                      @map("masked_phone_number")
  /// Protected E.164 envelope or vault reference — never plaintext in tenant APIs.
  protectedE164          String?                     @map("protected_e164")
  /// Protected Twilio Phone Number SID reference.
  protectedExternalRef   String?                     @map("protected_external_ref")
  /// Protected ElevenLabs phone_number_id reference.
  protectedElevenLabsRef String?                     @map("protected_elevenlabs_ref")
  /// SHA-256 digest of canonical E.164 for global uniqueness without storing plaintext.
  e164Digest             String?                     @unique @map("e164_digest")
  /// SHA-256 digest of provider phone SID for global uniqueness.
  externalRefDigest      String?                     @unique @map("external_ref_digest")
  /// SHA-256 digest of ElevenLabs phone_number_id for global uniqueness.
  elevenLabsRefDigest    String?                     @unique @map("elevenlabs_ref_digest")
  region                 String?
  capabilities           Json?
  lifecycle              VoicePhoneNumberLifecycle   @default(DRAFT)
  regulatoryStatus       VoicePhoneRegulatoryStatus  @default(UNKNOWN) @map("regulatory_status")
  /// Structured bundle/address/end-user compliance breakdown — no document payloads.
  regulatoryDetails      Json?                       @map("regulatory_details")
  elevenLabsImportStatus VoiceElevenLabsImportStatus @default(NOT_IMPORTED) @map("elevenlabs_import_status")
  voiceAssistantId       String?                     @map("voice_assistant_id")
  voiceAssistant         VoiceAssistant?             @relation(fields: [voiceAssistantId], references: [id], onDelete: SetNull)

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, lifecycle])
  @@index([providerAccountId])
  @@index([voiceAssistantId])
  @@index([organizationId, archivedAt])
  @@map("voice_phone_numbers")
}

/// Versioned agent deployment record per org assistant and provider.
model VoiceAgentDeployment {
  id               String         @id @default(uuid())
  organizationId   String         @map("organization_id")
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voiceAssistantId String         @map("voice_assistant_id")
  voiceAssistant   VoiceAssistant @relation(fields: [voiceAssistantId], references: [id], onDelete: Restrict)

  provider             VoiceControlPlaneProvider
  maskedExternalRef    String?                    @map("masked_external_ref")
  protectedExternalRef String?                    @map("protected_external_ref")
  version              Int                        @default(1)
  status               VoiceAgentDeploymentStatus @default(DRAFT)
  configHash           String?                    @map("config_hash")
  configSnapshot       Json?                      @map("config_snapshot")
  activatedVersion     Int?                       @map("activated_version")
  previousVersion      Int?                       @map("previous_version")
  provisionedAt        DateTime?                  @map("provisioned_at")
  failedAt             DateTime?                  @map("failed_at")
  rolledBackAt         DateTime?                  @map("rolled_back_at")
  createdByUserId      String?                    @map("created_by_user_id")
  updatedByUserId      String?                    @map("updated_by_user_id")
  archivedAt           DateTime?                  @map("archived_at")

  testRuns VoiceTestRun[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, voiceAssistantId, status])
  @@index([voiceAssistantId, version])
  @@index([organizationId, archivedAt])
  @@map("voice_agent_deployments")
}

/// Async provisioning job envelope — payload must not contain secrets.
model VoiceProvisioningJob {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  jobType        VoiceProvisioningJobType     @map("job_type")
  status         VoiceProvisioningJobStatus   @default(PENDING)
  idempotencyKey String                       @map("idempotency_key")
  currentStep    String?                      @map("current_step")
  progressPct    Int?                         @map("progress_pct")
  errorClass     VoiceProvisioningErrorClass? @map("error_class")
  errorMessage   String?                      @map("error_message")
  retryCount     Int                          @default(0) @map("retry_count")
  payload        Json?

  voiceAssistantId  String?         @map("voice_assistant_id")
  voiceAssistant    VoiceAssistant? @relation(fields: [voiceAssistantId], references: [id], onDelete: SetNull)
  providerAccountId String?         @map("provider_account_id")
  phoneNumberId     String?         @map("phone_number_id")
  deploymentId      String?         @map("deployment_id")

  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  failedAt        DateTime? @map("failed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  archivedAt      DateTime? @map("archived_at")
  createdByUserId String?   @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, jobType, status])
  @@index([status, updatedAt])
  @@index([organizationId, archivedAt])
  @@map("voice_provisioning_jobs")
}

