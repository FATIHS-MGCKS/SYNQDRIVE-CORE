  @@index([organizationId, vehicleId], map: "tire_wear_v3_prior_shadow_org_vehicle_idx")
  @@map("tire_wear_v3_prior_shadow_v1")
}

/// Tire Wear V3 calibration shadow — immutable per-wheel predictions (not customer-facing).
model TireWearV3CalibrationSnapshotV1 {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  vehicleId             String   @map("vehicle_id")
  tireSetupId           String   @map("tire_setup_id")
  mountPeriodId         String?  @map("mount_period_id")
  wheelPosition         String   @map("wheel_position")
  physicalTireId        String?  @map("physical_tire_id")
  predictionCreatedAt   DateTime @map("prediction_created_at") @db.Timestamptz(6)
  sourceComputedAt      DateTime @map("source_computed_at") @db.Timestamptz(6)
  sourceOdometerKm      Float?   @map("source_odometer_km")
  modelVersion          String   @map("model_version")
  modelConfigHash       String   @map("model_config_hash")
  inputFingerprint      String   @map("input_fingerprint")
  calibrationEligibilityDigest String @map("calibration_eligibility_digest")
  snapshotSchemaVersion String   @map("snapshot_schema_version")
