/// Battery Health V2 — time-bounded measurement cycle (architecture layer 3).
/// Mutable only in status, endedAt, targetAt, quality, metadata, updatedAt.
model BatteryMeasurementSession {
  id               String                          @id @default(uuid())
  organizationId   String                          @map("organization_id")
  vehicleId        String                          @map("vehicle_id")
  scope            BatteryEvidenceScope
  type             BatteryMeasurementSessionType   @map("type")
  status           BatteryMeasurementSessionStatus @default(PLANNED)
  driveProfile     BatteryDriveProfile             @default(UNKNOWN) @map("drive_profile")
  chemistry        BatteryChemistry                @default(UNKNOWN)
  startedAt        DateTime                        @map("started_at")
  targetAt         DateTime?                       @map("target_at")
  endedAt          DateTime?                       @map("ended_at")
  quality          BatteryMeasurementQuality       @default(SHADOW)
  providerSource   String?                         @map("provider_source")
  sourceEntityType String?                         @map("source_entity_type")
  sourceEntityId   String?                         @map("source_entity_id")
  tripId           String?                         @map("trip_id")
  idempotencyKey   String                          @map("idempotency_key")
  metadata         Json?                           @map("metadata")
  modelVersion     Int                             @default(1) @map("model_version")
  createdAt        DateTime                        @default(now()) @map("created_at")
  updatedAt        DateTime                        @updatedAt @map("updated_at")

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle          Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trip             VehicleTrip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  measurements     BatteryMeasurement[]
  hvChargeSessions HvChargeSession[]

  @@unique([vehicleId, idempotencyKey], map: "battery_measurement_sessions_idempotency_key")
  @@index([organizationId, startedAt(sort: Desc)])
  @@index([vehicleId, startedAt(sort: Desc)])
  @@index([vehicleId, status])
  @@index([vehicleId, type])
  @@index([vehicleId, scope, type])
  @@index([tripId])
  @@map("battery_measurement_sessions")
}

/// Battery Health V2 — immutable raw measurement (architecture layer 4).
/// INSERT-only: business fields are never updated after commit.
model BatteryMeasurement {
  id                String                    @id @default(uuid())
  organizationId    String                    @map("organization_id")
  vehicleId         String                    @map("vehicle_id")
  sessionId         String?                   @map("session_id")
  scope             BatteryEvidenceScope
  type              BatteryMeasurementType    @map("type")
  numericValue      Float?                    @map("numeric_value")
  textValue         String?                   @map("text_value")
  unit              String?                   @map("unit")
  quality           BatteryMeasurementQuality
  observedAt        DateTime                  @map("observed_at")
  receivedAt        DateTime                  @default(now()) @map("received_at")
  providerTimestamp DateTime?                 @map("provider_timestamp")
  providerSource    String?                   @map("provider_source")
  signalName        String?                   @map("signal_name")
  context           Json?                     @map("context")
  provenance        Json?                     @map("provenance")
  idempotencyKey    String                    @map("idempotency_key")
  supersededById    String?                   @map("superseded_by_id")
  createdAt         DateTime                  @default(now()) @map("created_at")

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle                    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  session      BatteryMeasurementSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  supersededBy BatteryMeasurement?        @relation("BatteryMeasurementSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   BatteryMeasurement[]       @relation("BatteryMeasurementSupersede")
  evidenceRows BatteryEvidence[]
  batteryGroundTruthEvents BatteryGroundTruthEvent[]
  generalizedEvidenceObservations BatteryGeneralizedEvidenceObservation[]
  providerGapLastFreshLinks         BatteryProviderObservabilityGap[] @relation("GapLastFreshObservation")
  providerGapFirstFreshAfterLinks   BatteryProviderObservabilityGap[] @relation("GapFirstFreshAfterGap")

  @@unique([organizationId, vehicleId, idempotencyKey], map: "battery_measurements_tenant_idempotency_key")
  @@unique([vehicleId, type, observedAt], map: "battery_measurements_dedup_key")
  @@index([organizationId, observedAt(sort: Desc)])
  @@index([vehicleId, observedAt(sort: Desc)])
  @@index([vehicleId, scope, type])
  @@index([sessionId])
  @@index([quality])
  @@index([supersededById])
  @@map("battery_measurements")
}

/// Battery Health V2 — versioned assessment run (architecture layer 6, append-only).
model BatteryAssessment {
  id               String                    @id @default(uuid())
  organizationId   String                    @map("organization_id")
  vehicleId        String                    @map("vehicle_id")
  scope            BatteryEvidenceScope
  type             BatteryAssessmentType     @map("type")
  scoreValue       Float?                    @map("score_value")
  textValue        String?                   @map("text_value")
  confidence       String?                   @map("confidence")
  evidenceStrength BatteryEvidenceStrength   @map("evidence_strength")
  dataQuality      String?                   @map("data_quality")
  maturity         BatteryAssessmentMaturity
  modelVersion     Int                       @default(1) @map("model_version")
