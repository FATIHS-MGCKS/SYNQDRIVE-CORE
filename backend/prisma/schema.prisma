  expiresAt           DateTime           @map("expires_at")
  consumedAt          DateTime?          @map("consumed_at")
  consumedByBookingId String?            @unique @map("consumed_by_booking_id")
  pricingContextJson  Json               @map("pricing_context_json")
  pricingInputJson    Json               @map("pricing_input_json")
  lineItemsJson       Json               @map("line_items_json")
  totalsJson          Json               @map("totals_json")
