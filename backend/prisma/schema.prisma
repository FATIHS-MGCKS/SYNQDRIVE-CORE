  @@unique([organizationId, integrationId])
  @@index([organizationId])
  @@map("organization_integrations")
}

// ------------------------------------------------
// BILLING
// ------------------------------------------------

/// Canonical SaaS billing product catalog (distinct from org licensing `products`).
model BillingCatalogProduct {
  id                 String               @id @default(uuid())
  key                String               @unique
  name               String
  description        String?
  productRole        BillingProductRole   @map("product_role")
  status             BillingCatalogStatus @default(ACTIVE)
  sortOrder          Int                  @default(0) @map("sort_order")
  allowMultipleItems Boolean              @default(false) @map("allow_multiple_items")
  metadata           Json?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  priceBooks            BillingPriceBook[]
  stripeMappings        BillingStripePriceMapping[]
  stripeCatalogMappings BillingStripeCatalogMapping[]
  subscriptionItems     BillingSubscriptionItem[]

  @@index([status, sortOrder])
  @@map("billing_catalog_products")
}

model BillingPriceBook {
  id               String                 @id @default(uuid())
  name             String
  productKey       String                 @map("product_key")
  billingProductId String?                @map("billing_product_id")
  billingModel     BillingModel           @default(PER_CONNECTED_VEHICLE) @map("billing_model")
  interval         BillingInterval        @default(MONTHLY)
  currency         String                 @default("EUR") @db.Char(3)
  status           BillingPriceBookStatus @default(ACTIVE)
  internalLabel    String?                @map("internal_label")
  isDefault        Boolean                @default(false) @map("is_default")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  billingProduct        BillingCatalogProduct?             @relation(fields: [billingProductId], references: [id], onDelete: SetNull)
  versions              BillingPriceVersion[]
  usageSnapshots        BillingUsageSnapshot[]
  orgPriceOverrides     BillingOrganizationPriceOverride[]
  subscriptions         BillingSubscription[]
  subscriptionItems     BillingSubscriptionItem[]
  stripeMappings        BillingStripePriceMapping[]
  stripeCatalogMappings BillingStripeCatalogMapping[]

  @@index([productKey])
  @@index([billingProductId])
  @@index([isDefault])
  @@index([status])
  @@map("billing_price_books")
}

model BillingPriceVersion {
  id                String                    @id @default(uuid())
  priceBookId       String                    @map("price_book_id")
  versionNumber     Int                       @map("version_number")
  versionLabel      String?                   @map("version_label")
  status            BillingPriceVersionStatus @default(DRAFT)
  effectiveFrom     DateTime?                 @map("effective_from")
  effectiveTo       DateTime?                 @map("effective_to")
  tierMode          BillingTierMode           @default(VOLUME) @map("tier_mode")
  createdByUserId   String?                   @map("created_by_user_id")
  publishedByUserId String?                   @map("published_by_user_id")
  publishedAt       DateTime?                 @map("published_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  priceBook             BillingPriceBook                   @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  createdByUser         User?                              @relation("BillingPriceVersionsCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedByUser       User?                              @relation("BillingPriceVersionsPublished", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  tiers                 BillingPriceTier[]
  usageSnapshots        BillingUsageSnapshot[]
  orgPriceOverrides     BillingOrganizationPriceOverride[]
  subscriptions         BillingSubscription[]
  subscriptionItems     BillingSubscriptionItem[]
  stripeCatalogMappings BillingStripeCatalogMapping[]

  @@unique([priceBookId, versionNumber])
  @@index([priceBookId, status])
  @@index([status, publishedAt])
  @@map("billing_price_versions")
}

/// Quantity tiers for a price version. `minVehicles`/`maxVehicles` are the billable quantity axis for per-vehicle SaaS pricing.
model BillingPriceTier {
  id             String   @id @default(uuid())
  priceVersionId String   @map("price_version_id")
  minVehicles    Int      @map("min_vehicles")
  maxVehicles    Int?     @map("max_vehicles")
  unitPriceCents Int?     @map("unit_price_cents")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  priceVersion      BillingPriceVersion       @relation(fields: [priceVersionId], references: [id], onDelete: Cascade)
  usageSnapshots    BillingUsageSnapshot[]
  subscriptionItems BillingSubscriptionItem[]

  @@index([priceVersionId, sortOrder])
  @@map("billing_price_tiers")
}

/// Stripe Product/Price mapping per pricebook. TEST and LIVE are strictly separated.
model BillingStripePriceMapping {
  id               String                     @id @default(uuid())
  priceBookId      String                     @map("price_book_id")
  billingProductId String?                    @map("billing_product_id")
  stripeMode       BillingStripeMode          @map("stripe_mode")
  stripeProductId  String?                    @map("stripe_product_id")
  stripePriceId    String?                    @map("stripe_price_id")
  mappingStatus    BillingStripeMappingStatus @default(PENDING) @map("mapping_status")
  lastSyncedAt     DateTime?                  @map("last_synced_at")
  lastError        String?                    @map("last_error")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  priceBook      BillingPriceBook       @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  billingProduct BillingCatalogProduct? @relation(fields: [billingProductId], references: [id], onDelete: SetNull)

  @@unique([priceBookId, stripeMode])
  @@unique([stripePriceId, stripeMode])
  @@index([billingProductId])
  @@index([mappingStatus])
  @@index([stripeProductId, stripeMode])
  @@map("billing_stripe_price_mappings")
}

/// Explicit Stripe catalog mapping per billing product + published price version and mode.
model BillingStripeCatalogMapping {
  id                 String                     @id @default(uuid())
  billingProductId   String                     @map("billing_product_id")
  priceVersionId     String                     @map("price_version_id")
  priceBookId        String                     @map("price_book_id")
  stripeMode         BillingStripeMode          @map("stripe_mode")
  stripeProductId    String                     @map("stripe_product_id")
  stripePriceId      String                     @map("stripe_price_id")
  currency           String                     @db.Char(3)
  billingInterval    BillingInterval            @map("billing_interval")
  billingModel       BillingModel               @default(PER_CONNECTED_VEHICLE) @map("billing_model")
  stripePresentation String                     @default("recurring_per_unit") @map("stripe_presentation")
  mappingStatus      BillingStripeMappingStatus @default(PENDING) @map("mapping_status")
  lastVerifiedAt     DateTime?                  @map("last_verified_at")
  lastError          String?                    @map("last_error")
  disabledAt         DateTime?                  @map("disabled_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  billingProduct BillingCatalogProduct @relation(fields: [billingProductId], references: [id], onDelete: Restrict)
  priceVersion   BillingPriceVersion   @relation(fields: [priceVersionId], references: [id], onDelete: Cascade)
  priceBook      BillingPriceBook      @relation(fields: [priceBookId], references: [id], onDelete: Cascade)

  @@unique([priceVersionId, stripeMode])
  @@unique([stripePriceId, stripeMode])
  @@index([billingProductId, stripeMode])
  @@index([priceBookId, stripeMode])
  @@index([mappingStatus])
  @@map("billing_stripe_catalog_mappings")
}

model BillingSubscription {
  id                   String                     @id @default(uuid())
  organizationId       String                     @map("organization_id")
  stripeSubscriptionId String?                    @map("stripe_subscription_id")
  stripeCustomerId     String?                    @map("stripe_customer_id")
  stripeMode           BillingStripeMode?         @map("stripe_mode")
  status               BillingStatus              @default(ACTIVE)
  trialStartAt         DateTime?                  @map("trial_start_at")
  trialEndAt           DateTime?                  @map("trial_end_at")
  startedAt            DateTime?                  @map("started_at")
  endedAt              DateTime?                  @map("ended_at")
  cancelAt             DateTime?                  @map("cancel_at")
  currentPeriodStart   DateTime?                  @map("current_period_start")
  currentPeriodEnd     DateTime?                  @map("current_period_end")
  cancelAtPeriodEnd    Boolean                    @default(false) @map("cancel_at_period_end")
  billingAnchorDay     Int?                       @map("billing_anchor_day")
  currency             String                     @default("EUR") @db.Char(3)
  priceBookId          String?                    @map("price_book_id")
  priceVersionId       String?                    @map("price_version_id")
  lockVersion          Int                        @default(0) @map("lock_version")
  stripeSyncStatus     BillingStripeMappingStatus @default(PENDING) @map("stripe_sync_status")
  lastStripeSyncedAt   DateTime?                  @map("last_stripe_synced_at")
  lastStripeSyncError  String?                    @map("last_stripe_sync_error")
  createdByUserId      String?                    @map("created_by_user_id")
  updatedByUserId      String?                    @map("updated_by_user_id")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceBook      BillingPriceBook?         @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  priceVersion   BillingPriceVersion?      @relation(fields: [priceVersionId], references: [id], onDelete: SetNull)
  createdByUser  User?                     @relation("BillingSubscriptionsCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser  User?                     @relation("BillingSubscriptionsUpdated", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  invoices       BillingInvoice[]
  items          BillingSubscriptionItem[]
  discounts      BillingDiscount[]
  quantityEvents BillingQuantityEvent[]
  outboundEmails OutboundEmail[]

  reconciliationDrifts BillingReconciliationDrift[]

  @@unique([stripeSubscriptionId, stripeMode])
  @@unique([stripeCustomerId, stripeMode])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([priceBookId])
  @@index([stripeSyncStatus])
  @@map("billing_subscriptions")
}

/// Contract line item — base plan (Rental/Fleet) or add-on. Historical ENDED items do not block new tariffs.
model BillingSubscriptionItem {
  id                       String                        @id @default(uuid())
  subscriptionId           String                        @map("subscription_id")
  organizationId           String                        @map("organization_id")
  billingProductId         String                        @map("billing_product_id")
  itemRole                 BillingSubscriptionItemRole   @map("item_role")
  priceBookId              String?                       @map("price_book_id")
  priceVersionId           String?                       @map("price_version_id")
  priceTierId              String?                       @map("price_tier_id")
  quantity                 Int                           @default(0)
  validFrom                DateTime                      @map("valid_from")
  validTo                  DateTime?                     @map("valid_to")
  status                   BillingSubscriptionItemStatus @default(DRAFT)
  stripeSubscriptionItemId String?                       @map("stripe_subscription_item_id")
  stripeMode               BillingStripeMode?            @map("stripe_mode")
  prorationBehavior        BillingProrationBehavior      @default(CREATE_PRORATIONS) @map("proration_behavior")
  metadata                 Json?
  createdAt                DateTime                      @default(now()) @map("created_at")
  updatedAt                DateTime                      @updatedAt @map("updated_at")

  subscription               BillingSubscription                @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organization               Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingProduct             BillingCatalogProduct              @relation(fields: [billingProductId], references: [id], onDelete: Restrict)
  priceBook                  BillingPriceBook?                  @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  priceVersion               BillingPriceVersion?               @relation(fields: [priceVersionId], references: [id], onDelete: SetNull)
  priceTier                  BillingPriceTier?                  @relation(fields: [priceTierId], references: [id], onDelete: SetNull)
  discounts                  BillingDiscount[]
  quantityEvents             BillingQuantityEvent[]
  usageSnapshots             BillingUsageSnapshot[]
  billableVehicleAssignments BillingBillableVehicleAssignment[]
  invoiceLines               BillingInvoiceLine[]

  @@unique([stripeSubscriptionItemId, stripeMode])
  @@index([subscriptionId, status])
  @@index([organizationId, itemRole, status])
  @@index([billingProductId])
  @@index([priceVersionId])
  @@map("billing_subscription_items")
}

/// Subscription-level discount (replaces ad-hoc overrides over time; legacy overrides remain).
model BillingDiscount {
  id                    String                @id @default(uuid())
  subscriptionId        String                @map("subscription_id")
  subscriptionItemId    String?               @map("subscription_item_id")
  discountType          BillingDiscountType   @map("discount_type")
  percentBps            Int?                  @map("percent_bps")
  fixedAmountCents      Int?                  @map("fixed_amount_cents")
  currency              String?               @db.Char(3)
  validFrom             DateTime              @map("valid_from")
  validTo               DateTime?             @map("valid_to")
  reason                String?
  status                BillingDiscountStatus @default(ACTIVE)
  stripeMode            BillingStripeMode?    @map("stripe_mode")
  stripeCouponId        String?               @map("stripe_coupon_id")
  stripePromotionCodeId String?               @map("stripe_promotion_code_id")
  createdByUserId       String?               @map("created_by_user_id")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  subscription     BillingSubscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionItem BillingSubscriptionItem? @relation(fields: [subscriptionItemId], references: [id], onDelete: SetNull)
  createdByUser    User?                    @relation("BillingDiscountsCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([stripeCouponId, stripeMode])
  @@unique([stripePromotionCodeId, stripeMode])
  @@index([subscriptionId, status])
  @@index([subscriptionItemId])
  @@map("billing_discounts")
}

model BillingInvoice {
  id                   String             @id @default(uuid())
  subscriptionId       String             @map("subscription_id")
  stripeInvoiceId      String?            @map("stripe_invoice_id")
  stripeMode           BillingStripeMode? @map("stripe_mode")
  invoiceNumber        String?            @map("invoice_number")
  amountCents          Int                @map("amount_cents")
  netAmountCents       Int?               @map("net_amount_cents")
  discountAmountCents  Int?               @default(0) @map("discount_amount_cents")
  taxAmountCents       Int?               @map("tax_amount_cents")
  amountDueCents       Int?               @map("amount_due_cents")
  amountPaidCents      Int?               @map("amount_paid_cents")
  amountRemainingCents Int?               @map("amount_remaining_cents")
  currency             String             @default("EUR") @db.Char(3)
  status               InvoiceStatus      @default(DRAFT)
  periodStart          DateTime?          @map("period_start")
  periodEnd            DateTime?          @map("period_end")
  stripeCreatedAt      DateTime?          @map("stripe_created_at")
  finalizedAt          DateTime?          @map("finalized_at")
  invoiceDate          DateTime           @map("invoice_date")
  dueDate              DateTime?          @map("due_date")
  paidAt               DateTime?          @map("paid_at")
  voidedAt             DateTime?          @map("voided_at")
  hostedInvoiceUrl     String?            @map("hosted_invoice_url")
  invoicePdfUrl        String?            @map("invoice_pdf_url")
  customerSnapshotJson Json?              @map("customer_snapshot_json")
  companySnapshotJson  Json?              @map("company_snapshot_json")
  billingAddressJson   Json?              @map("billing_address_json")
  taxIdSnapshot        String?            @map("tax_id_snapshot")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  subscription   BillingSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  lines          BillingInvoiceLine[]
  payments       BillingPayment[]
  refunds        BillingRefund[]
  creditNotes    BillingCreditNote[]
  disputes       BillingDispute[]
  outboundEmails OutboundEmail[]

  @@unique([stripeInvoiceId, stripeMode])
  @@index([subscriptionId])
  @@index([invoiceNumber])
  @@map("billing_invoices")
}

/// Immutable invoice line once created (financial snapshot).
model BillingInvoiceLine {
  id                  String             @id @default(uuid())
  invoiceId           String             @map("invoice_id")
  subscriptionItemId  String?            @map("subscription_item_id")
  usageSnapshotId     String?            @map("usage_snapshot_id")
  description         String
  quantity            Int
  unitAmountCents     Int?               @map("unit_amount_cents")
  discountCents       Int?               @default(0) @map("discount_cents")
  subtotalCents       Int                @map("subtotal_cents")
  netCents            Int?               @map("net_cents")
  taxRateBps          Int?               @map("tax_rate_bps")
  taxCents            Int?               @map("tax_cents")
  totalCents          Int                @map("total_cents")
  productSnapshotJson Json?              @map("product_snapshot_json")
  priceSnapshotJson   Json?              @map("price_snapshot_json")
  discountDetailsJson Json?              @map("discount_details_json")
  taxDetailsJson      Json?              @map("tax_details_json")
  stripeInvoiceLineId String?            @map("stripe_invoice_line_id")
  stripeMode          BillingStripeMode? @map("stripe_mode")
  periodStart         DateTime?          @map("period_start")
  periodEnd           DateTime?          @map("period_end")
  createdAt           DateTime           @default(now()) @map("created_at")

  invoice          BillingInvoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  subscriptionItem BillingSubscriptionItem? @relation(fields: [subscriptionItemId], references: [id], onDelete: SetNull)
  usageSnapshot    BillingUsageSnapshot?    @relation(fields: [usageSnapshotId], references: [id], onDelete: SetNull)

  @@unique([stripeInvoiceLineId, stripeMode])
  @@index([invoiceId])
  @@index([subscriptionItemId])
  @@index([usageSnapshotId])
  @@map("billing_invoice_lines")
}

/// Usage snapshot for a billing period — locked rows are immutable.
model BillingUsageSnapshot {
  id                    String                        @id @default(uuid())
  organizationId        String                        @map("organization_id")
  subscriptionItemId    String?                       @map("subscription_item_id")
  periodStart           DateTime                      @map("period_start")
  periodEnd             DateTime                      @map("period_end")
  connectedVehicleCount Int                           @map("connected_vehicle_count")
  billableVehicleCount  Int                           @map("billable_vehicle_count")
  calculatedQuantity    Int?                          @map("calculated_quantity")
  calculationBasis      BillingUsageSnapshotBasis?    @map("calculation_basis")
  billableVehicleIds    Json                          @map("billable_vehicle_ids")
  excludedVehicleIds    Json                          @default("[]") @map("excluded_vehicle_ids")
  excludedReasonSummary Json?                         @map("excluded_reason_summary")
  priceBookId           String?                       @map("price_book_id")
  priceVersionId        String?                       @map("price_version_id")
  priceTierId           String?                       @map("price_tier_id")
  unitPriceCents        Int?                          @map("unit_price_cents")
  subtotalCents         Int?                          @map("subtotal_cents")
  taxCents              Int?                          @map("tax_cents")
  totalCents            Int?                          @map("total_cents")
  currency              String                        @default("EUR") @db.Char(3)
  calculationStatus     BillingUsageCalculationStatus @map("calculation_status")
  idempotencyKey        String?                       @unique @map("idempotency_key")
  discountSnapshotJson  Json?                         @map("discount_snapshot_json")
  prorationDetailsJson  Json?                         @map("proration_details_json")
  sourceHash            String?                       @map("source_hash")
  sourceRevision        Int?                          @map("source_revision")
  lockedAt              DateTime?                     @map("locked_at")
  createdByUserId       String?                       @map("created_by_user_id")
  createdAt             DateTime                      @default(now()) @map("created_at")

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionItem BillingSubscriptionItem? @relation(fields: [subscriptionItemId], references: [id], onDelete: SetNull)
  priceBook        BillingPriceBook?        @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  priceVersion     BillingPriceVersion?     @relation(fields: [priceVersionId], references: [id], onDelete: SetNull)
  priceTier        BillingPriceTier?        @relation(fields: [priceTierId], references: [id], onDelete: SetNull)
  createdByUser    User?                    @relation("BillingUsageSnapshotsCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  invoiceLines     BillingInvoiceLine[]

  @@index([organizationId, periodStart])
  @@index([subscriptionItemId, periodStart])
  @@index([priceVersionId])
  @@index([lockedAt])
  @@map("billing_usage_snapshots")
}

/// Append-only assignment of a vehicle to a subscription item for billing.
model BillingBillableVehicleAssignment {
  id                 String                                 @id @default(uuid())
  organizationId     String                                 @map("organization_id")
  vehicleId          String                                 @map("vehicle_id")
  subscriptionItemId String                                 @map("subscription_item_id")
  billableFrom       DateTime                               @map("billable_from")
  billableUntil      DateTime?                              @map("billable_until")
  status             BillingBillableVehicleAssignmentStatus @default(ACTIVE)
  reasonCode         String?                                @map("reason_code")
  reasonNote         String?                                @map("reason_note")
  approvedByUserId   String?                                @map("approved_by_user_id")
  createdAt          DateTime                               @default(now()) @map("created_at")

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle          Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  subscriptionItem BillingSubscriptionItem @relation(fields: [subscriptionItemId], references: [id], onDelete: Cascade)
  approvedByUser   User?                   @relation("BillingVehicleAssignmentsApproved", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, vehicleId, status])
  @@index([subscriptionItemId, billableFrom])
  @@index([vehicleId, billableFrom])
  @@map("billing_billable_vehicle_assignments")
}

/// Append-only quantity ledger per subscription item.
model BillingQuantityEvent {
  id                 String                     @id @default(uuid())
  organizationId     String                     @map("organization_id")
  subscriptionId     String?                    @map("subscription_id")
  subscriptionItemId String                     @map("subscription_item_id")
  vehicleId          String?                    @map("vehicle_id")
  eventType          BillingQuantityEventType   @map("event_type")
  delta              Int
  quantityBefore     Int                        @map("quantity_before")
  quantityAfter      Int                        @map("quantity_after")
  effectiveAt        DateTime                   @map("effective_at")
  source             BillingQuantityEventSource
  actorUserId        String?                    @map("actor_user_id")
  reason             String?
  idempotencyKey     String                     @unique @map("idempotency_key")
  createdAt          DateTime                   @default(now()) @map("created_at")

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription     BillingSubscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionItem BillingSubscriptionItem @relation(fields: [subscriptionItemId], references: [id], onDelete: Cascade)
  vehicle          Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  actorUser        User?                   @relation("BillingQuantityEventsActed", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, effectiveAt])
  @@index([subscriptionItemId, effectiveAt])
  @@index([subscriptionId, effectiveAt])
  @@index([vehicleId, effectiveAt])
  @@index([eventType, effectiveAt])
  @@map("billing_quantity_events")
}

/// SaaS payment aggregate for a billing invoice.
model BillingPayment {
  id                    String                    @id @default(uuid())
  invoiceId             String                    @map("invoice_id")
  amountCents           Int                       @map("amount_cents")
  currency              String                    @default("EUR") @db.Char(3)
  status                BillingPaymentStatus      @default(PENDING)
  provider              BillingPaymentProvider    @default(STRIPE)
  stripePaymentIntentId String?                   @map("stripe_payment_intent_id")
  stripeChargeId        String?                   @map("stripe_charge_id")
  stripePaymentMethodId String?                   @map("stripe_payment_method_id")
  stripeMode            BillingStripeMode?        @map("stripe_mode")
  attemptCount          Int                       @default(0) @map("attempt_count")
  refundedAmountCents   Int                       @default(0) @map("refunded_amount_cents")
  remainingAmountCents  Int?                      @map("remaining_amount_cents")
  succeededAt           DateTime?                 @map("succeeded_at")
  failedAt              DateTime?                 @map("failed_at")
  cancelledAt           DateTime?                 @map("cancelled_at")
  manualPaymentType     BillingManualPaymentType? @map("manual_payment_type")
  manualReference       String?                   @map("manual_reference")
  manualReceiptNote     String?                   @map("manual_receipt_note")
  recordedByUserId      String?                   @map("recorded_by_user_id")
  idempotencyKey        String?                   @unique @map("idempotency_key")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  invoice    BillingInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?                   @relation("BillingPaymentsRecorded", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  attempts   BillingPaymentAttempt[]
  refunds    BillingRefund[]
  disputes   BillingDispute[]

  @@unique([stripePaymentIntentId, stripeMode])
  @@unique([stripeChargeId, stripeMode])
  @@index([invoiceId, status])
  @@index([provider, status])
  @@map("billing_payments")
}

/// Append-only payment attempt log.
model BillingPaymentAttempt {
  id               String                      @id @default(uuid())
  paymentId        String                      @map("payment_id")
  attemptNumber    Int                         @map("attempt_number")
  amountCents      Int                         @map("amount_cents")
  status           BillingPaymentAttemptStatus @default(PENDING)
  provider         BillingPaymentProvider      @default(STRIPE)
  stripeChargeId   String?                     @map("stripe_charge_id")
  stripeMode       BillingStripeMode?          @map("stripe_mode")
  errorCode        String?                     @map("error_code")
  declineCode      String?                     @map("decline_code")
  errorMessage     String?                     @map("error_message")
  safeErrorMessage String?                     @map("safe_error_message")
  nextRetryAt      DateTime?                   @map("next_retry_at")
  idempotencyKey   String?                     @unique @map("idempotency_key")
  attemptedAt      DateTime                    @default(now()) @map("attempted_at")
  createdAt        DateTime                    @default(now()) @map("created_at")

  payment BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, attemptNumber])
  @@unique([stripeChargeId, stripeMode])
  @@index([paymentId, attemptedAt])
  @@map("billing_payment_attempts")
}

/// Append-only refund record.
model BillingRefund {
  id             String              @id @default(uuid())
  paymentId      String              @map("payment_id")
  invoiceId      String?             @map("invoice_id")
  amountCents    Int                 @map("amount_cents")
  currency       String              @default("EUR") @db.Char(3)
  status         BillingRefundStatus @default(PENDING)
  isPartial      Boolean             @default(false) @map("is_partial")
  reason         String?
  stripeRefundId String?             @map("stripe_refund_id")
  stripeMode     BillingStripeMode?  @map("stripe_mode")
  refundedAt     DateTime?           @map("refunded_at")
  idempotencyKey String?             @unique @map("idempotency_key")
  createdAt      DateTime            @default(now()) @map("created_at")

  payment     BillingPayment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice     BillingInvoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  creditNotes BillingCreditNote[]

  @@unique([stripeRefundId, stripeMode])
  @@index([paymentId, createdAt])
  @@index([invoiceId])
  @@map("billing_refunds")
}

/// Append-only credit note linked to invoice/refund.
model BillingCreditNote {
  id                 String                  @id @default(uuid())
  invoiceId          String                  @map("invoice_id")
  refundId           String?                 @map("refund_id")
  amountCents        Int                     @map("amount_cents")
  currency           String                  @default("EUR") @db.Char(3)
  status             BillingCreditNoteStatus @default(DRAFT)
  reason             String?
  stripeCreditNoteId String?                 @map("stripe_credit_note_id")
  stripeMode         BillingStripeMode?      @map("stripe_mode")
  hostedUrl          String?                 @map("hosted_url")
  pdfUrl             String?                 @map("pdf_url")
  issuedAt           DateTime?               @map("issued_at")
  voidedAt           DateTime?               @map("voided_at")
  idempotencyKey     String?                 @unique @map("idempotency_key")
  createdAt          DateTime                @default(now()) @map("created_at")

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refund  BillingRefund? @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@unique([stripeCreditNoteId, stripeMode])
  @@index([invoiceId, status])
  @@index([refundId])
  @@map("billing_credit_notes")
}

/// Stripe charge dispute mirror — safe metadata only.
model BillingDispute {
  id              String               @id @default(uuid())
  organizationId  String               @map("organization_id")
  paymentId       String?              @map("payment_id")
  invoiceId       String?              @map("invoice_id")
  amountCents     Int                  @map("amount_cents")
  currency        String               @default("EUR") @db.Char(3)
  status          BillingDisputeStatus
  reason          String?
  stripeDisputeId String?              @map("stripe_dispute_id")
  stripeChargeId  String?              @map("stripe_charge_id")
  stripeMode      BillingStripeMode?   @map("stripe_mode")
  openedAt        DateTime?            @map("opened_at")
  closedAt        DateTime?            @map("closed_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      BillingPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoice      BillingInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([stripeDisputeId, stripeMode])
  @@index([organizationId, status])
  @@index([stripeChargeId, stripeMode])
  @@map("billing_disputes")
}

/// Billing domain event outbox — payload immutable after insert; delivery state may advance.
model BillingDomainEventOutbox {
  id             String                         @id @default(uuid())
  eventType      String                         @map("event_type")
  aggregateType  String                         @map("aggregate_type")
  aggregateId    String                         @map("aggregate_id")
  organizationId String?                        @map("organization_id")
  payloadVersion Int                            @default(1) @map("payload_version")
  payload        Json
  occurredAt     DateTime                       @map("occurred_at")
  publishedAt    DateTime?                      @map("published_at")
  status         BillingDomainEventOutboxStatus @default(PENDING)
  retryCount     Int                            @default(0) @map("retry_count")
  nextRetryAt    DateTime?                      @map("next_retry_at")
  lastError      String?                        @map("last_error")
  lockedAt       DateTime?                      @map("locked_at")
  lockOwner      String?                        @map("lock_owner")
  idempotencyKey String                         @unique @map("idempotency_key")
  createdAt      DateTime                       @default(now()) @map("created_at")

  deliveries BillingDomainEventOutboxDelivery[]

  @@index([status, occurredAt])
  @@index([status, nextRetryAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("billing_domain_event_outbox")
}

/// Per-consumer delivery state — enables multiple downstream consumers later.
model BillingDomainEventOutboxDelivery {
  id            String                                 @id @default(uuid())
  outboxEventId String                                 @map("outbox_event_id")
  consumerId    String                                 @map("consumer_id")
  status        BillingDomainEventOutboxDeliveryStatus @default(PENDING)
  retryCount    Int                                    @default(0) @map("retry_count")
  nextRetryAt   DateTime?                              @map("next_retry_at")
  lastError     String?                                @map("last_error")
  deliveredAt   DateTime?                              @map("delivered_at")
  lockedAt      DateTime?                              @map("locked_at")
  lockOwner     String?                                @map("lock_owner")
  createdAt     DateTime                               @default(now()) @map("created_at")
  updatedAt     DateTime                               @updatedAt @map("updated_at")

  outboxEvent    BillingDomainEventOutbox @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  outboundEmails OutboundEmail[]

  @@unique([outboxEventId, consumerId])
  @@index([status, nextRetryAt])
  @@index([consumerId, status])
  @@map("billing_domain_event_outbox_deliveries")
}

model BillingPaymentMethod {
