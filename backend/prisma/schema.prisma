  organizationId            String   @map("organization_id")
  vehicleId                 String   @map("vehicle_id")
  tripId                    String   @map("trip_id")
  tireSetupId               String   @map("tire_setup_id")
  tireTripUsageLedgerId     String   @map("tire_trip_usage_ledger_id")
  diV0MotionCoreShadowRunId String   @map("di_v0_motion_core_shadow_run_id")
  workItemId                String?  @map("work_item_id")
  combinedInputIdentity     String   @map("combined_input_identity")
  pinnedSnapshotHash        String   @map("pinned_snapshot_hash")
  contentFingerprint        String   @map("content_fingerprint")
  shadowBundleVersion       String   @map("shadow_bundle_version")
  speedAuthority            String   @map("speed_authority")
  eventsAlgorithmVersion    String   @map("events_algorithm_version")
  adapterVersion            String   @map("adapter_version")
