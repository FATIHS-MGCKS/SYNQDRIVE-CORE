// ------------------------------------------------
// BOOKING HANDOVER PROTOCOL (V4.6.75 — pickup + return)
// ------------------------------------------------

enum HandoverKind {
  PICKUP
  RETURN
}

model BookingHandoverProtocol {
  id                       String       @id @default(uuid())
  organizationId           String       @map("organization_id")
  bookingId                String       @map("booking_id")
  vehicleId                String       @map("vehicle_id")
  kind                     HandoverKind
  performedAt              DateTime     @default(now()) @map("performed_at")
  performedByUserId        String?      @map("performed_by_user_id")
  performedByName          String?      @map("performed_by_name")
  odometerKm               Int          @map("odometer_km")
  fuelPercent              Int          @map("fuel_percent")
  fuelFull                 Boolean      @default(false) @map("fuel_full")
  exteriorClean            Boolean      @default(true) @map("exterior_clean")
  interiorClean            Boolean      @default(true) @map("interior_clean")
  tiresSeasonOk            Boolean      @default(true) @map("tires_season_ok")
  warningLightsOn          Boolean      @default(false) @map("warning_lights_on")
  warningLightsNotes       String?      @map("warning_lights_notes")
  notes                    String?
  customerSignatureName    String?      @map("customer_signature_name")
  customerSignatureDataUrl String?      @map("customer_signature_data_url")
  staffSignatureName       String?      @map("staff_signature_name")
  staffSignatureDataUrl    String?      @map("staff_signature_data_url")
  documentsAcknowledged    Boolean      @default(false) @map("documents_acknowledged")
  // JSON array of VehicleDamage.id values that were noted or created
  // during this handover. We link rather than duplicate — damage records
  // continue to live in VehicleDamage with their pin coordinates, images,
  // cost and repair status.
  damageIds                Json?        @map("damage_ids")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleDamages VehicleDamage[]

  @@unique([bookingId, kind])
  @@index([organizationId])
  @@index([vehicleId])
  @@map("booking_handover_protocols")
}

/// In-progress operator handover form state (per booking, kind, user).
model BookingHandoverDraft {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  bookingId      String       @map("booking_id")
  kind           HandoverKind
  userId         String       @map("user_id")
  payload        Json
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, kind, userId])
  @@index([organizationId])
  @@map("booking_handover_drafts")
}

/// Rental-period analysis input coverage (P59).
enum RentalDrivingAnalysisCompleteness {
  FULL
  PARTIAL
  INSUFFICIENT
}

/// Publication stability for rental analysis (P60).
enum RentalDrivingAnalysisStability {
  PROVISIONAL
  STABLE
}

/// Customer-facing completeness assessment for rental analysis (P61).
enum RentalDrivingAnalysisAssessmentStatus {
  COMPLETE
  PARTIAL
  PROVISIONAL
  NOT_ASSESSABLE
  FAILED
}

// ------------------------------------------------
// RENTAL DRIVING ANALYSIS (stored per completed rental period)
// ------------------------------------------------

model RentalDrivingAnalysis {
  id                     String                                @id @default(uuid())
  organizationId         String                                @map("organization_id")
  bookingId              String                                @map("booking_id")
  vehicleId              String                                @map("vehicle_id")
  /// Contract holder (Vertragspartner) — not automatically the driver.
  bookingCustomerId      String                                @map("booking_customer_id")
  assignedDriverId       String?                               @map("assigned_driver_id")
  actualDriverId         String?                               @map("actual_driver_id")
  /// @deprecated Legacy mirror of booking customer — read via readLegacyDriverId(); do not write customerId here.
  driverId               String?                               @map("driver_id")
  periodStart            DateTime                              @map("period_start")
  periodEnd              DateTime                              @map("period_end")
  payload                Json                                  @map("payload")
  overallLevel           String                                @map("overall_level")
  driverStyleCategory    String                                @map("driver_style_category")
  riskLevel              String                                @map("risk_level")
  drivingScore           Float?                                @map("driving_score")
  drivingEventsCount     Int?                                  @map("driving_events_count")
  abuseDetectionCount    Int?                                  @map("abuse_detection_count")
  wearImpact             String?                               @map("wear_impact")
  calculationVersion     String                                @default("rental-driving-analysis-v1") @map("calculation_version")
  inputFingerprint       String                                @map("input_fingerprint")
  generatedAt            DateTime                              @default(now()) @map("generated_at")
  sourceTripsFinalizedAt DateTime?                             @map("source_trips_finalized_at")
  analysisCompleteness   RentalDrivingAnalysisCompleteness     @default(PARTIAL) @map("analysis_completeness")
  stabilityStatus        RentalDrivingAnalysisStability        @default(PROVISIONAL) @map("stability_status")
  assessmentStatus       RentalDrivingAnalysisAssessmentStatus @default(PROVISIONAL) @map("assessment_status")
  assessmentSummary      Json                                  @default("{}") @map("assessment_summary")
  maturity               DrivingAnalysisMaturity               @default(PUBLISHED) @map("maturity")
  supersededAt           DateTime?                             @map("superseded_at")
  supersedesAnalysisId   String?                               @map("supersedes_analysis_id")
  recomputeReason        String?                               @map("recompute_reason")
  attributionSummary     Json                                  @default("{}") @map("attribution_summary")
  createdAt              DateTime                              @default(now()) @map("created_at")

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking            Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicle            Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bookingCustomer    Customer                @relation("RentalAnalysisBookingCustomer", fields: [bookingCustomerId], references: [id], onDelete: Cascade)
  assignedDriver     Customer?               @relation("RentalAnalysisAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  actualDriver       Customer?               @relation("RentalAnalysisActualDriver", fields: [actualDriverId], references: [id], onDelete: SetNull)
  driver             Customer?               @relation("RentalAnalysisLegacyDriver", fields: [driverId], references: [id], onDelete: SetNull)
  supersedesAnalysis RentalDrivingAnalysis?  @relation("RentalAnalysisSupersedes", fields: [supersedesAnalysisId], references: [id], onDelete: SetNull)
  supersededBy       RentalDrivingAnalysis[] @relation("RentalAnalysisSupersedes")

  @@unique([bookingId, calculationVersion, inputFingerprint])
  @@index([organizationId])
  @@index([vehicleId])
  @@index([bookingCustomerId])
  @@index([assignedDriverId])
  @@index([actualDriverId])
  @@index([driverId])
  @@index([periodStart, periodEnd])
  @@index([bookingId, supersededAt])
  @@index([bookingId, stabilityStatus])
  @@index([inputFingerprint])
  @@index([supersedesAnalysisId])
  @@map("rental_driving_analyses")
}

