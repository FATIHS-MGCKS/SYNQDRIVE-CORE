# PHYSICAL_REFUEL_RECONCILIATION_RECOVERY_INTERVAL_MS=60000
# PHYSICAL_REFUEL_RECONCILIATION_RECOVERY_BATCH_SIZE=25

# RFRF raw fuel refuel fallback (F1–F9 runtime; default OFF — staged rollout via F10 ops scripts)
# Permissive booleans accept: 1/true/yes/on. Strict authorities accept canonical true ONLY.
# RAW_FUEL_REFUEL_FALLBACK_ENABLED=false
# RAW_FUEL_REFUEL_FALLBACK_PERSIST_ENABLED=false
