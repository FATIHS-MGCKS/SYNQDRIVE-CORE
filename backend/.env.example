# RFRF_HYBRID_TRUST_ALLOWED_ORGANIZATION_IDS=
# RFRF_HYBRID_TRUST_ALLOWED_VEHICLE_IDS=
# RAW_FUEL_REFUEL_FALLBACK_CUTOVER_AT=

# ERD E5.4 recharge shadow parity (measurement-only; default OFF — no Production activation)
