# ------------------------------------------------
# SynqDrive Backend Environment Configuration
# ------------------------------------------------

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
# Swagger UI + OpenAPI JSON at /docs and /docs-json.
# Unset: enabled in development, disabled when NODE_ENV=production.
# SWAGGER_ENABLED=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://synqdrive:synqdrive@localhost:5432/synqdrive?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ClickHouse local/self-hosted analytics mirror
# Optional analytics/telemetry mirror — PostgreSQL stays the canonical truth.
# The values below are DEV DEFAULTS that match docker-compose.yml so local
# development works out of the box. In production use a STRONG password and
# never expose the ClickHouse ports publicly.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=synqdrive
CLICKHOUSE_PASSWORD=synqdrive_clickhouse_dev
CLICKHOUSE_DATABASE=synqdrive
# After migration 007: set true once to backfill legacy org_id rows from PostgreSQL vehicles
# CLICKHOUSE_ORG_BACKFILL_ENABLED=true
# CLICKHOUSE_ORG_BACKFILL_BATCH_SIZE=100
# Analysis read hardening (P22) — env URL only, no Docker assumption
# CLICKHOUSE_ANALYSIS_QUERY_TIMEOUT_MS=5000
# CLICKHOUSE_CIRCUIT_FAILURE_THRESHOLD=3
# CLICKHOUSE_CIRCUIT_COOLDOWN_MS=30000
# CLICKHOUSE_ANALYSIS_TIMEOUT_WINDOW_MS=60000

# Notification Engine V2 (shadow mode — writes V2 tables, legacy dashboard unchanged)
NOTIFICATIONS_V2=false
# Comma-separated org UUIDs — when set, V2 ingest/API only for listed orgs (global NOTIFICATIONS_V2 must be true)
NOTIFICATIONS_V2_ORG_ALLOWLIST=
# Async channel delivery (email/push outbox) — requires NOTIFICATIONS_V2=true and WORKERS_ENABLED=true
NOTIFICATIONS_DELIVERY_ENABLED=false
NOTIFICATIONS_DELIVERY_MAX_ATTEMPTS=5
NOTIFICATIONS_DELIVERY_BACKOFF_MS=60000
NOTIFICATION_QUIET_HOURS_START=22:00
NOTIFICATION_QUIET_HOURS_END=07:00
NOTIFICATION_DIGEST_HOUR_LOCAL=8

# Notification evaluation runtime (BullMQ + Redis lock)
NOTIFICATION_EVALUATION_QUEUE_ENABLED=true
NOTIFICATION_EVALUATION_DEBOUNCE_MS=120000
NOTIFICATION_EVALUATION_LOCK_TTL_MS=300000
NOTIFICATION_EVALUATION_LOCK_HEARTBEAT_MS=60000
NOTIFICATION_EVALUATION_JOB_ATTEMPTS=4
NOTIFICATION_EVALUATION_JOB_BACKOFF_MS=5000
NOTIFICATION_EVALUATION_BOOT_STAGGER_MS=15000

# ── Stations V2 rollout flags (Prompt 74/78 — all default OFF in production) ───
# Org canary: comma-separated UUIDs; when set, only listed orgs receive enabled flags.
# STATIONS_V2_ORG_ALLOWLIST=
STATIONS_V2_SCHEMA_ENABLED=false
STATIONS_V2_SCOPE_ENABLED=false
STATIONS_V2_LIFECYCLE_ENABLED=false
STATIONS_V2_SUMMARY_READ_MODEL_ENABLED=false
STATIONS_V2_DELTA_ASSIGNMENT_ENABLED=false
STATIONS_V2_POSITIONING_ENABLED=false
STATIONS_V2_BOOKING_RULES_ENABLED=false
# off | shadow | warning | enforce
STATIONS_V2_BOOKING_RULES_ENFORCEMENT=off
STATIONS_V2_CAPACITY_WARNINGS_ENABLED=false
STATIONS_V2_TRANSFERS_ENABLED=false
STATIONS_V2_AUDIT_TRAIL_ENABLED=false
STATIONS_V2_GEOFENCE_SHADOW_ENABLED=false
STATIONS_V2_UI_ENABLED=false

# Evaluations tenant-safe analytics foundation (E2). off | shadow | on.
# Default off: the analytics foundation routes are invisible (fail-closed 404).
EVALUATIONS_ANALYTICS_V2_MODE=off
# Legacy endpoint hard-disable (step 10)
STATIONS_V2_SET_VEHICLES_DISABLED=false
# Jest: defaults all flags ON unless set to off
# STATIONS_V2_FLAGS_TEST_DEFAULT=off

# ClickHouse trip assist (explicit architecture exception — default on).
# When true, guarded CH-assisted detectors may influence PostgreSQL trip
# start, continuity guard, and repair candidates. Does NOT affect canonical
# scores. Live trip END remains FSM + DIMO CUSUM (CH does not accelerate end).
# See architecture/CLICKHOUSE_TRIP_ASSIST_AND_TRIP_END_2026-07-08.md
# CLICKHOUSE_TRIP_ASSIST_ENABLED=true

# ClickHouse trip-end assist tuning (optional — defaults in worker.config.ts)
# TRIP_END_CH_ASSIST_MIN_STATIONARY_MS=45000
# TRIP_END_CH_ASSIST_MIN_TRIP_DURATION_MS=60000
# TRIP_END_CH_ASSIST_STABILITY_MS=30000
# TRIP_END_CH_ASSIST_HIGH_STATIONARY_MS=90000

# Post-trip HF analytics mirror (optional — does NOT affect canonical scores).
# HF_MIRROR_ENABLED=false

# Driving Intelligence V2 — post-trip pipeline only (never affects live trip FSM).
# DRIVING_INTELLIGENCE_V2_ENABLED=false
# DRIVING_V2_DIMO_SEGMENT_VALIDATION_ENABLED=false
# DRIVING_V2_ENGINE_DETECTOR_SHADOW_ENABLED=true
# DRIVING_V2_HF_DETECTOR_SHADOW_ENABLED=true

# P2 trip speed QC — auto V2 projection after durable S4 PRIMARY completion (scheduler in VehicleIntelligenceModule; default OFF).
# When enabled, DI_V0_P2_AUTO_PROJECTION_V2_ENABLED_SINCE is required (no unbounded historical backfill on enable).
# DI_V0_P2_AUTO_PROJECTION_V2_ENABLED=false
# DI_V0_P2_AUTO_PROJECTION_V2_ENABLED_SINCE=2026-10-15T00:00:00.000Z
# DI_V0_P2_AUTO_PROJECTION_V2_BATCH_LIMIT=20

# DS4 Assessment L2 + Impact V2 (PR-A) — materializes di_v0_ds4_trip_assessment_v1 from motion-core shadow runs.
# Default OFF: no production enqueue, no customer scoring cutover. Does not modify motion-core shadow allowlists.
# DI_V0_DS4_ASSESSMENT_ENABLED=false
# DI_V0_DS4_ASSESSMENT_WORKER_ENABLED=false
# DI_V0_DS4_ASSESSMENT_BATCH_LIMIT=5
# Required when assessment worker is enabled (fail-closed if unset/invalid). Proposed DS4 L2 collection boundary (owner activation only):
# DI_V0_DS4_ASSESSMENT_MIN_MOTION_RUN_CREATED_AT=2026-10-28T17:42:00Z

# DS4 RPM HF V1B — post-trip temporal quality shadow (default OFF; separate from V1A and motion-core shadow).
# Requires enabled-since + non-empty org/vehicle allowlists when flags are on. No customer API or scoring.
# DS4_RPM_HF_V1B_SHADOW_ENABLED=false
# DS4_RPM_HF_V1B_WORKER_ENABLED=false
# DS4_RPM_HF_V1B_ENABLED_SINCE=2026-10-28T00:00:00.000Z
# DS4_RPM_HF_V1B_ORGANIZATION_ALLOWLIST=
# DS4_RPM_HF_V1B_VEHICLE_ALLOWLIST=
# DS4_RPM_HF_V1B_BATCH_LIMIT=10
# DS4_RPM_REF_INTEL_V1_V1B_ATTACH_ENABLED=false

# EXP021 — V2 GPS speed evaluation product read (trip detail API; default OFF — separate from P2 auto-write)
# DI_V0_TRIP_SPEED_QUALITY_V2_PRODUCT_READ_ENABLED=false
# Frontend mirror (default OFF): VITE_DI_V0_TRIP_SPEED_QUALITY_V2_PRODUCT_UI_ENABLED=false

# Post-trip route waypoint mirror (optional — from PG trip waypoints only).
# WAYPOINT_MIRROR_ENABLED=false

# Post-trip activity window evidence mirror (optional).
# ACTIVITY_WINDOW_MIRROR_ENABLED=false

# Prometheus metrics scrape (internal only — required in production & staging)
# METRICS_BEARER_TOKEN=change-me-long-random-secret
# Local dev only: allow /metrics without token when explicitly enabled:
# METRICS_ALLOW_OPEN_IN_DEV=true

# Grafana (VPS ops only — localhost UI via SSH tunnel; set on prod backend.env)
# GRAFANA_ADMIN_PASSWORD=change-me-long-random-secret
# GRAFANA_INTERNAL_URL=http://127.0.0.1:3000
# PROMETHEUS_INTERNAL_URL=http://127.0.0.1:9090

# Authentication
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
JWT_SECRET=change-me-in-production
# IAM org-bound refresh sessions (Prompt 7). Default: enabled.
ENABLE_IAM_ORG_BOUND_REFRESH_SESSIONS=true
# One-time LEGACY_UNSCOPED refresh upgrade when org is determinable. Default: off.
ENABLE_IAM_LEGACY_UNSCOPED_REFRESH_GRACE=false

# IAM MFA (TOTP + step-up) — gradual rollout via org allowlist
IAM_MFA_ENROLLMENT_ENABLED=false
IAM_MFA_STEP_UP_ENFORCED=false
IAM_MFA_PRIVILEGED_ENROLLMENT_REQUIRED=false
IAM_MFA_ORG_ALLOWLIST=
# Master admin control plane MFA (mandatory enrollment + step-up for /master)
IAM_MFA_MASTER_ADMIN_ENABLED=false
# Optional dedicated AES key for MFA secret encryption (falls back to JWT_SECRET)
IAM_MFA_ENCRYPTION_KEY=

# Temporary master-admin smoke account provisioning (ops CLI only — default disabled)
MASTER_ADMIN_SMOKE_PROVISIONING_ENABLED=false
# Optional TTL for smoke account (hours, max 24; default 4)
MASTER_ADMIN_SMOKE_TTL_HOURS=4
# Optional override for readonly smoke API base URL (default https://app.synqdrive.eu)
MASTER_ADMIN_SMOKE_BASE_URL=
# Optional local-only paths for credential/state files (mode 0600); defaults to /tmp
MASTER_ADMIN_SMOKE_CREDENTIAL_FILE=
MASTER_ADMIN_SMOKE_STATE_FILE=

# IAM data retention & data subject rights — disabled by default; dry-run when enabled
IAM_DATA_RETENTION_ENABLED=false
IAM_DATA_RETENTION_DRY_RUN=true
IAM_DATA_RETENTION_BATCH_SIZE=500
IAM_DATA_RETENTION_MAX_BATCHES=50
IAM_DATA_RETENTION_MAX_RETRIES=3
IAM_DATA_RETENTION_SESSION_GRACE_DAYS=7
IAM_DATA_RETENTION_INVITE_DELIVERY_DAYS=30
# Set in production before enabling IP pseudonymization
IAM_DATA_PSEUDONYMIZATION_SALT=

# Evaluations person-level analytics pseudonymization (E5.1B / E5.2).
# Dedicated server-side HMAC-SHA-256 key for keyed, non-reversible, tenant-scoped
# driver pseudonyms in Evaluations Driver Analytics. Never reuse a JWT/session
# secret. In development/test a deterministic dev-only fallback is used when unset.
# In production (NODE_ENV=production) this is REQUIRED and fails closed: if it is
# missing, empty, a placeholder/dev value, or shorter than 32 chars, the
# pseudonymous person-level disclosure path returns UNAVAILABLE (no dev fallback,
# no raw/truncated ids). Set a strong high-entropy random value (>= 32 chars).
EVALUATIONS_PSEUDONYM_SECRET=

# Mapbox (backend geocoding, map matching, vendor POI — same token as frontend)
MAPBOX_ACCESS_TOKEN=
MAPBOX_TOKEN=
VITE_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_URL=

# Elevenlabs
ELEVENLABS_API_KEY=
# HMAC secret for signed ElevenLabs post-call webhooks (workspace webhook secret)
ELEVENLABS_WEBHOOK_SECRET=
# Unified webhook ingestion (Twilio + ElevenLabs + MCP). Production: opt-in only.
VOICE_WEBHOOK_INGESTION_ENABLED=false

# SynqDrive voice MCP gateway (ElevenLabs agent tools)
VOICE_AI_MCP_GATEWAY_ENABLED=false
VOICE_MCP_GATEWAY=false
# Native ElevenLabs-Twilio PSTN orchestration (staging/canary only)
VOICE_NATIVE_TWILIO_INTEGRATION=false
VOICE_AI_NATIVE_TELEPHONY=false
VOICE_AI_PROVISIONING_STAGING_ENABLED=false
# Legacy Twilio Say diagnostic PSTN (disabled in production by default)
VOICE_LEGACY_DIAGNOSTIC_CALLS=false
# Dedicated HMAC/JWT secret for short-lived MCP bearer tokens (falls back to JWT_SECRET)
VOICE_MCP_TOKEN_SECRET=
VOICE_MCP_TOKEN_TTL_SECONDS=900
VOICE_MCP_TOOL_TIMEOUT_MS=10000
VOICE_MCP_RATE_LIMIT_PER_MINUTE=120
# Daily voice privacy retention purge (transcripts/summaries/webhook payloads)
VOICE_RETENTION_ENABLED=true

# Voice staging E2E (Prompt 10B — manual live calls only with explicit gates)
VOICE_E2E_ORG_ID=org-voice-staging-e2e
VOICE_E2E_FORBIDDEN_ORG_IDS=
VOICE_E2E_ALLOW_LIVE_CALLS=false
# Comma-separated E.164 targets permitted for manual staging PSTN tests
VOICE_E2E_ALLOWLIST_E164=

# Twilio (server-side SDK — API Key auth, not Account Auth Token)
# Credentials optional until telephony integration is enabled; IE1 region requires edge dublin.
# See backend/docs/twilio-setup.md
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_REGION=ie1
TWILIO_EDGE=dublin
# Webhook signature validation only — never used for REST SDK calls
TWILIO_AUTH_TOKEN=
# Public app base URL for Twilio voice/status webhooks (defaults to APP_URL).
# Production SynqDrive: https://app.synqdrive.eu
TWILIO_VOICE_WEBHOOK_BASE_URL=https://app.synqdrive.eu

# ── AI Gateway (provider-neutral LLM layer) ───────────────────────────────────
# DIMO remains for vehicle identity/telemetry only — LLM inference uses this gateway.
AI_PROVIDER=mistral
MISTRAL_API_KEY=
# Optional override (default: https://api.mistral.ai)
MISTRAL_BASE_URL=
MISTRAL_ROUTER_MODEL=mistral-small-latest
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_JSON_MODEL=mistral-small-latest
MISTRAL_REASONING_MODEL=mistral-large-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_OCR_TIMEOUT_MS=120000
MISTRAL_OCR_MAX_FILE_BYTES=10485760
AI_STREAMING_ENABLED=true
# When true, WhatsApp/email/customer outreach requires explicit approval before send.
AI_EXTERNAL_ACTIONS_REQUIRE_APPROVAL=true
AI_AUDIT_LOGGING_ENABLED=true
AI_AUDIT_STORE_PLAIN_USER_ID=false
AI_AUDIT_USER_REF_PEPPER=
AI_AUDIT_RETENTION_DAYS=730
AI_AUDIT_DEBUG_LOGGING=false
AI_AGENT_LIMITS_ENABLED=true
AI_AGENT_LIMITS_FAIL_OPEN=true
AI_AGENT_RATE_LIMIT_ENABLED=true
AI_AGENT_RATE_LIMIT_WINDOW_MS=60000
AI_AGENT_RATE_LIMIT_PER_USER_PER_MINUTE=30
AI_AGENT_RATE_LIMIT_PER_ORG_PER_MINUTE=120
AI_AGENT_RATE_LIMIT_PER_IP_PER_MINUTE=60
AI_AGENT_MAX_CONCURRENT_PER_ORG=5
AI_AGENT_MAX_CONCURRENT_PER_USER=2
AI_AGENT_MAX_TOOL_INVOCATIONS_PER_CHAT=8
AI_AGENT_MAX_LLM_RETRIES=1
AI_AGENT_MAX_TOKENS_PER_LLM_CALL=768
AI_AGENT_TOKEN_BUDGET_ENABLED=true
AI_AGENT_TOKEN_BUDGET_PER_USER_PER_DAY=100000
AI_AGENT_TOKEN_BUDGET_PER_ORG_PER_DAY=500000
AI_AGENT_MAX_CONVERSATION_HISTORY=100
AI_AGENT_REQUEST_TIMEOUT_MS=45000
AI_AGENT_TOOL_CACHE_ENABLED=true
AI_AGENT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AI_AGENT_CIRCUIT_BREAKER_COOLDOWN_MS=60000
AI_AGENT_LLM_RETRY_BACKOFF_MS=500
# Fleet Chat domain-grounding rollout (Prompt 30) — default OFF in production
# FLEET_CHAT_ORG_ALLOWLIST=
FLEET_CHAT_DOMAIN_GROUNDING_ENABLED=false

# DIMO Integration (telemetry, identity, webhooks — NOT used as LLM provider)
#
# SECURITY — read before committing:
# - NEVER commit real secrets (.env, *agent*.local.json, *secrets*.json).
# - DIMO_PRIVATE_KEY is server-only — set it in local .env only.
# - If DIMO_PRIVATE_KEY was ever committed to git, rotate it immediately
#   in the DIMO Developer Console (https://console.dimo.org) and update your local .env.
#
DIMO_API_URL=https://identity-api.dimo.zone
DIMO_TELEMETRY_API_URL=https://telemetry-api.dimo.zone/query
DIMO_CLIENT_ID=

# PDI identity drift shadow (read-only; runs after DIMO vehicle sync when enabled)
PDI_IDENTITY_DRIFT_SHADOW_ENABLED=false
DIMO_PRIVATE_KEY=
DIMO_REDIRECT_URI=
DIMO_DOMAIN=
DIMO_ENV=
DIMO_VEHICLE_JWT_TTL_SECONDS=300
DIMO_VEHICLE_JWT_REFRESH_MARGIN_SECONDS=60
DIMO_WEBHOOK_SECRET=
# Optional legacy HMAC for x-dimo-signature when DIMO sends it. Vehicle Triggers API
# authenticates via DIMO_WEBHOOK_VERIFICATION_TOKEN at URL registration — trigger POSTs
# are unsigned by default and are accepted when the verification token is configured.
# Echoed when DIMO Vehicle Triggers verifies the webhook URL ({ "verification": "test" })
DIMO_WEBHOOK_VERIFICATION_TOKEN=
# Optional legacy bootstrap: auto-register DIMO webhooks/triggers on startup (default off)
DIMO_TRIGGER_BOOTSTRAP_ENABLED=false

# DTC-01A — fail-closed shared poll/webhook snapshot apply (default OFF; owner enable in runtime)
# DTC_01A_SAFETY_FOUNDATION_ENABLED=false
# Optional pilot cohort (requires DTC_01A_SAFETY_FOUNDATION_ENABLED=true). Default OFF.
# DTC_01F_COHORT_GATE_ENABLED=false
# DTC_01F_COHORT_VEHICLE_ALLOWLIST=vehicle-uuid-1,vehicle-uuid-2
# DTC-01F mixed-mode routing (default OFF; requires 01A + cohort gate + allowlist). Pilot allowlist → safety01a; other ACTIVE → legacy.
# DTC_01F_COHORT_MIXED_MODE_ENABLED=false
# DTC-02 P2 webhook capability (default OFF; requires DTC_01A + allowlist; no production activation in repo)
# DTC_02_WEBHOOK_CAPABILITY_ENABLED=false
# DTC_02_WEBHOOK_CAPABILITY_VEHICLE_ALLOWLIST=vehicle-uuid-1
# DTC-02 P3 adaptive scheduler shadow (default OFF; projected plans only — no enqueue/cadence change)
# DTC_02_ADAPTIVE_SCHEDULER_SHADOW_ENABLED=false
# DTC_02_ADAPTIVE_SCHEDULER_SHADOW_VEHICLE_ALLOWLIST=vehicle-uuid-1
# DTC-02 P5+ only — MUST remain false until pilot certification (P4 blocks in code)
# DTC_02_ADAPTIVE_DEFERRAL_ENABLED=false

# VSI-03 P2C — durable per-poll aggregated source observations (default OFF; requires migration)
# VSI03_P2C_SOURCE_OBSERVATION_CAPTURE_ENABLED=false
# VSI03_P2C_CAPTURE_PILOT_ALLOWLIST_ENABLED=false
# VSI03_P2C_CAPTURE_PILOT_ALLOWLIST_JSON={"version":1,"entries":[{"organizationId":"<org-uuid>","vehicleId":"<vehicle-uuid>"}]}
# VSI03_P2C_STRICT_ADVANCE_FROM_OBSERVATIONS_ENABLED=false

# VSI P5 APDS read-only correlation (P5B — default OFF; independent of WORKER_APD_SHADOW_ENABLED)
# VSI_P5_APDS_CORRELATION_ENABLED=false

# VSI P3A per-link provider catalog axes (default OFF — writer and resolver independent)
# VSI_P3A_PER_LINK_CATALOG_WRITE_ENABLED=false
# VSI_P3A_PER_LINK_CATALOG_RESOLVER_ENABLED=false

# Fleet connectivity episode recovery rollout (default: recovery on, reconciliation apply off)
# CONNECTIVITY_EPISODE_RECOVERY_ENABLED=true
# CONNECTIVITY_RECONCILIATION_APPLY_ENABLED=false
# REQUIRED in production before enabling automatic orphan reconciliation (PR #1267 deploy):
# Set to the actual rollout instant — do NOT set before deployment.
# CONNECTIVITY_LIFECYCLE_RECONCILE_AFTER=2026-08-26T14:30:00.000Z
# Non-production: when unset, uses deterministic dev default (see device-connection-webhook-inbox.config.ts).

# P2.5 physical-state cutover activation evidence (Ed25519 public keyring — verification only; private key NEVER in runtime)
# CONNECTIVITY_PHYSICAL_STATE_CUTOVER_EVIDENCE_PUBLIC_KEYS_JSON={"keys":[{"keyId":"ops-2026-09","algorithm":"Ed25519","publicKey":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"}]}
# CONNECTIVITY_PHYSICAL_STATE_CUTOVER_CAPABLE_BUILD_ID=
# SYNQDRIVE_BUILD_ID=
# SYNQDRIVE_REPLICA_PEER_BUILD_IDS=

# P2.5 STATEFUL_SHADOW pilot scope gate (fail-closed; absent/blank/[] => zero LEGACY pilot scopes)
# CONNECTIVITY_PHYSICAL_STATE_SHADOW_PILOT_SCOPES_JSON=[{"organizationId":"...","vehicleId":"...","provider":"DIMO"}]
# CONNECTIVITY_PHYSICAL_STATE_SHADOW_OBSERVATION_RETENTION_DAYS=90

# Stripe Integration
STRIPE_SECRET_KEY=
# Optional explicit guard: test | live — must match sk_test_* / sk_live_* prefix
STRIPE_ENVIRONMENT=
# Production only: set true to allow sk_test_* (non-prod sandboxes on prod NODE_ENV only)
STRIPE_ALLOW_TEST_IN_PRODUCTION=false
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Signature replay window in seconds (Stripe default: 300)
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_CURRENCY=eur
# Return URL after Stripe Customer Portal (falls back to APP_URL)
STRIPE_CUSTOMER_PORTAL_RETURN_URL=
# Optional: Stripe Price ID for per-vehicle subscription creation (Prompt 2+)
STRIPE_DEFAULT_PRICE_ID=
# End-customer Connect (modules/payments) — separate from billing webhooks
STRIPE_CONNECT_ACCOUNT_GENERATION=V1
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
# App base URL used for portal return URL validation fallback
# Billing notification emails (Resend outbox consumer billing.email)
BILLING_EMAIL_ENABLED=true
BILLING_EMAIL_SUPPORT=support@synqdrive.eu
BILLING_EMAIL_SETTINGS_PATH=/rental/settings?settingsTab=billing
BILLING_EMAIL_MAX_ATTEMPTS=5


# Worker Configuration
WORKER_SNAPSHOT_INTERVAL_MS=30000
# P1.2 activity-tier snapshot polling (rollback: WORKER_SNAPSHOT_LEGACY_FIXED_CADENCE=true)
WORKER_SNAPSHOT_ACTIVITY_TIER_POLLING_ENABLED=true
# P2.5 APD observe-only shadow (dual B2/B4 counterfactuals). Default OFF — no poll authority.
WORKER_APD_SHADOW_ENABLED=false
# Required when WORKER_APD_SHADOW_ENABLED=true (fail-closed). version P25_APD_LTE_R1_COHORT_V1; members: organizationId+vehicleId pairs only.
# WORKER_APD_SHADOW_COHORT_JSON={"version":"P25_APD_LTE_R1_COHORT_V1","members":[{"organizationId":"<org-uuid>","vehicleId":"<vehicle-uuid>"}]}
WORKER_SNAPSHOT_LEGACY_FIXED_CADENCE=false
WORKER_SNAPSHOT_TIER_ACTIVE_DRIVING_MS=30000
WORKER_SNAPSHOT_TIER_RECENTLY_ACTIVE_MS=60000
WORKER_SNAPSHOT_TIER_RESTING_STANDBY_MS=300000
WORKER_SNAPSHOT_TIER_LONG_IDLE_MS=1800000
WORKER_SNAPSHOT_ACTIVE_DRIVING_DEMOTION_HOLD_MS=90000
WORKER_SNAPSHOT_MOVEMENT_SPEED_KMH=3
WORKER_LIVEMAP_INTERVAL_MS=5000
WORKER_DIMO_SYNC_INTERVAL_MS=300000
WORKER_SNAPSHOT_CONCURRENCY=5
# P1.2 FINAL-4: optional per-tick enqueue safety cap (0 = unlimited)
# WORKER_SNAPSHOT_MAX_ENQUEUE_PER_TICK=0
# P1.2 FINAL-4: fast reconciliation cohort (excludes providerFetchedAt-only eligibility)
# WORKER_FAST_RECONCILIATION_RECENCY_MS=3600000
# WORKER_FAST_RECONCILIATION_MAX_VEHICLES_PER_RUN=0
WORKER_LIVEMAP_CONCURRENCY=10
WORKER_ANALYTICS_CONCURRENCY=3
WORKER_DIMO_SYNC_CONCURRENCY=2
WORKER_BATTERY_ENRICHMENT_CONCURRENCY=3
WORKER_BRAKE_ENRICHMENT_CONCURRENCY=3

# V2 Trip Detection — ACTIVE_TICK interval + end-detection tuning (env overrides worker.config defaults)
WORKER_TRIP_TRACKING_INTERVAL_MS=30000
# P1.2 FINAL-3: canonical partial-boundary extension (rollback: TRIP_PARTIAL_BOUNDARY_REPAIR_ENABLED=false)
TRIP_PARTIAL_BOUNDARY_REPAIR_ENABLED=true
# DI boundary admission durable recovery (Fable P0) — writer default OFF; requires explicit activation timestamp (never process start)
# Fleet-wide recovery uses TRIP_DI_BOUNDARY_ADMISSION_RECOVERY_GLOBAL_AUTHORIZED (not DI_V0_DS4_FLEET_MOTION_GLOBAL_ROLLOUT_AUTHORIZED).
# TRIP_DI_BOUNDARY_ADMISSION_RECOVERY_ACTIVATED_AT_UTC=
# TRIP_DI_BOUNDARY_ADMISSION_RECOVERY_GLOBAL_AUTHORIZED=false
# TRIP_DI_BOUNDARY_ADMISSION_RECOVERY_WRITER_ENABLED=false
# TRIP_DI_BOUNDARY_ADMISSION_RECOVERY_SHADOW_OBSERVE_ENABLED=true
# TRIP_DI_BOUNDARY_ADMISSION_RECOVERY_LOOKBACK_HOURS=48
# TRIP_DI_BOUNDARY_ADMISSION_RECOVERY_MAX_TRIPS_PER_VEHICLE=32
# TRIP_DI_BOUNDARY_ADMISSION_RECOVERY_GLOBAL_MAX_PER_PASS=64
# DI_V0_DS4_FLEET_MOTION_GLOBAL_ROLLOUT_AUTHORIZED=false
# LIVE_FSM split reconciliation auto-admission horizon (separate from durable recovery)
# TRIP_DI_BOUNDARY_ADMISSION_LIVE_FSM_AUTO_ACTIVATED_AT_UTC=
# Live POSSIBLE_START lookback ceiling (default derived: max poll tier + 3min confirm + 2min buffer)
# WORKER_TRIP_START_BOUNDARY_MAX_LOOKBACK_MS=2100000
# P1B — evidence-backed start boundary admission shadow (default OFF; non-authoritative)
# TRIP_START_BOUNDARY_ADMISSION_SHADOW_ENABLED=false
# TRIP_START_BOUNDARY_ADMISSION_SHADOW_ROUTE_FETCH_ENABLED=false
# P1B.5 — comma-separated canonical UUID allowlist (max 16 unique; any invalid entry invalidates entire list)
# TRIP_START_BOUNDARY_ADMISSION_SHADOW_VEHICLE_IDS=
WORKER_TRIP_END_TIMEOUT_MS=1800000
TRIP_END_STABILITY_WINDOW_MS=90000
TRIP_END_MIN_INACTIVITY_BEFORE_CUSUM_MS=120000
TRIP_END_VALIDATION_RETRY_MS=60000
TRIP_END_VALIDATION_MAX_ATTEMPTS=3
# P1B.9C: mid-gap telemetry-silence false-split hardening (default OFF; live FSM only)
# TRIP_MID_GAP_TELEMETRY_SILENCE_HARDENING_ENABLED=false
# Per-vehicle canary requires global true + non-empty UUID allowlist (fail-closed if empty)
# TRIP_MID_GAP_TELEMETRY_SILENCE_HARDENING_VEHICLE_IDS=

# ── P1.3 DIMO provider limiter (S2 shadow / S3 priority enforcement) ─────────
# Documented DIMO Core telemetry ceiling: 25 req/s per API service per client host.
# Internal safety budget defaults below that ceiling (20 req/s + burst 5).
# S3: enforce mode adds bounded admission wait + Retry-After cooldown — default remains shadow.
# S4: token_bucket smoothing (default) + deterministic canary enforce rollout.
DIMO_PROVIDER_LIMITER_ENABLED=true
DIMO_PROVIDER_LIMITER_MODE=shadow
DIMO_PROVIDER_RATE_ALGORITHM=token_bucket
DIMO_PROVIDER_RATE_LIMIT_PER_SECOND=20
DIMO_PROVIDER_RATE_BURST=5
DIMO_PROVIDER_MAX_IN_FLIGHT=40
DIMO_PROVIDER_INFLIGHT_LEASE_MS=45000
DIMO_PROVIDER_RESERVED_HIGH_PRIORITY_SLOTS=12
DIMO_PROVIDER_MAX_WAIT_MS=5000
# Canary enforce (global mode must remain shadow for safe rollout)
DIMO_PROVIDER_ENFORCE_CANARY_ENABLED=false
DIMO_PROVIDER_ENFORCE_CANARY_PERCENT=0
# DIMO_PROVIDER_ENFORCE_CANARY_ORG_IDS=org-uuid-1,org-uuid-2
# DIMO_PROVIDER_ENFORCE_CANARY_VEHICLE_IDS=vehicle-uuid-1,vehicle-uuid-2
# Legacy alias (merged with ENFORCE_CANARY_ORG_IDS): DIMO_PROVIDER_CANARY_ENFORCE_ORG_IDS=org-uuid-1
# Optional per-priority admission wait overrides (enforce mode, milliseconds)
# DIMO_PROVIDER_MAX_WAIT_MS_P0=10000
# DIMO_PROVIDER_MAX_WAIT_MS_P1=10000
# DIMO_PROVIDER_MAX_WAIT_MS_P2=5000
# DIMO_PROVIDER_MAX_WAIT_MS_P3=3750
# DIMO_PROVIDER_MAX_WAIT_MS_P4=2500
DIMO_PROVIDER_ADMISSION_POLL_MIN_MS=25
DIMO_PROVIDER_ADMISSION_POLL_MAX_MS=250
DIMO_PROVIDER_RETRY_AFTER_MAX_SECONDS=120

# Request Timeouts
DIMO_REQUEST_TIMEOUT_MS=10000
# P1.3 — Global DIMO provider budget (Redis-backed, multi-replica safe)
DIMO_GLOBAL_BUDGET_ENABLED=true
DIMO_GLOBAL_MAX_IN_FLIGHT=50
DIMO_GLOBAL_ACQUIRE_TIMEOUT_MS=15000
DIMO_GLOBAL_LEASE_MS=30000
DIMO_GLOBAL_RETRY_AFTER_MAX_MS=120000
DIMO_GLOBAL_MAX_RETRIES=3
DIMO_GLOBAL_RESERVED_HIGH_SLOTS=10
DIMO_GLOBAL_STARVATION_PROMOTION_MS=30000
DIMO_PROVIDER_COOLDOWN_429_THRESHOLD=5
DIMO_PROVIDER_COOLDOWN_MS=30000
DEFAULT_REQUEST_TIMEOUT_MS=15000

# P1.7 — Scheduler leader election (singleton @Cron/@Interval producers)
# Required before running multiple PM2 replicas. BullMQ workers remain multi-replica.
SCHEDULER_LEADER_ELECTION_ENABLED=true
SCHEDULER_LEADER_LEASE_MS=30000
SCHEDULER_LEADER_RENEW_INTERVAL_MS=10000
SCHEDULER_LEADER_ACQUIRE_INTERVAL_MS=5000

# P1.4 — Trip reconciliation execution mutex (per-vehicle mutation boundary)
# Complements P1.7 scheduler leader election. BullMQ workers remain multi-replica.
RECONCILIATION_EXECUTION_MUTEX_ENABLED=true
RECONCILIATION_EXECUTION_MUTEX_TTL_MS=120000
RECONCILIATION_EXECUTION_MUTEX_RENEW_ENABLED=true
RECONCILIATION_EXECUTION_MUTEX_RENEW_INTERVAL_MS=30000
RECONCILIATION_EXECUTION_MUTEX_ACQUIRE_TIMEOUT_MS=0

# Logging
# Comma-separated levels. If unset, defaults are env-aware:
#   production  -> error,warn,log   (debug/verbose suppressed)
#   development -> error,warn,log,debug,verbose
# Set explicitly to override, e.g. LOG_LEVEL=error,warn,log
LOG_LEVEL=debug
# Log successful (2xx/3xx) HTTP requests in production too (default: only 4xx/5xx).
HTTP_LOG_SUCCESS=false
# Throttle window (ms) for repeated 5xx stack traces with the same signature.
ERROR_STACK_THROTTLE_MS=60000

# ── HTTP body size limit ──────────────────────────────────────────────────────
# Must accommodate base64 image / signature endpoints (damages, exterior images,
# handover signatures). Applies to JSON and urlencoded bodies.
HTTP_BODY_LIMIT=12mb

# ── Battery Health V2 rollout flags (Prompt 3/78 — defaults safe) ─────────────
# Real CRANK_MIN assessment (OFF = legacy crank has no score/alert/readiness effect)
BATTERY_V2_LEGACY_CRANK_ASSESSMENT_ENABLED=false
# Collect start-window points for future START_DIP_PROXY analysis (diagnostic only)
BATTERY_V2_START_PROXY_ENABLED=false
# LV REST canonical pipeline (FSM + REST targets). Historically named "shadow".
# Stage 1 cutover: true with PUBLICATION=false (sessions/jobs active, measurements SHADOW).
BATTERY_V2_REST_SHADOW_ENABLED=false
# M3.2B — shadow shutdown evidence acquisition around trip end (observability only; default OFF).
BATTERY_V2_SHUTDOWN_EVIDENCE_SHADOW_ENABLED=false
# M3.3A: generalized LV evidence + rest sessions (shadow; default off — no authoritative behavior)
BATTERY_V2_GENERALIZED_EVIDENCE_ENABLED=false
# M3.3 B1.2Y — PROVIDER_OBSERVABILITY_GAP lifecycle (default OFF; no production behavior change until enabled)
BATTERY_V2_PROVIDER_OBSERVABILITY_GAP_ENABLED=false
# M3.3C — shadow rest-session retention/charge features (default OFF; C1 schema only)
BATTERY_V2_REST_SESSION_FEATURES_SHADOW_ENABLED=false
# M3.3F — longitudinal profile D3 materialization (default OFF; separate from C3)
BATTERY_V2_LONGITUDINAL_PROFILE_MATERIALIZATION_ENABLED=false
# M3.3F — optional D3 materialization session read limit (positive int; capped by D1 DB safety max 100)
# BATTERY_V2_LONGITUDINAL_MATERIALIZATION_SESSION_LIMIT=100
# Stage 2+: enable after LIVE_VOLTAGE ingestion fixed and canonical REST evidence verified.
BATTERY_V2_PUBLICATION_ENABLED=false
# Binding rental readiness from canonical Battery V2 (Stage 3 — after publication stable).
BATTERY_V2_READINESS_ENABLED=false
# Reconciliation scheduler (default ON when unset).
# BATTERY_V2_RECONCILIATION_ENABLED=true
# Optional DLQ replay during reconciliation ticks.
# BATTERY_V2_DLQ_REPLAY_ENABLED=false
# Legacy HV ΔEnergy/ΔSOC pairwise capacity assessment (OFF = no new capacity/SOH from snapshots)
BATTERY_V2_HV_LEGACY_PAIRWISE_CAPACITY_ENABLED=false

# ── Battery V2 Retention (BatteryV2RetentionScheduler, daily 04:00) ───────────
# Domain-aware retention with dry-run default. Does NOT run on deploy.
BATTERY_V2_RETENTION_ENABLED=false
BATTERY_V2_RETENTION_DRY_RUN=true
BATTERY_V2_RETENTION_BATCH_SIZE=1000
BATTERY_V2_RETENTION_MAX_BATCHES=200
RETENTION_BATTERY_LV_PROVIDER_SNAPSHOTS_DAYS=90
RETENTION_HV_PROVIDER_SNAPSHOTS_DAYS=365
RETENTION_BATTERY_MEASUREMENTS_LV_DAYS=730
RETENTION_BATTERY_MEASUREMENTS_HV_DAYS=1095
RETENTION_BATTERY_MEASUREMENT_SESSIONS_DAYS=1095
RETENTION_BATTERY_ASSESSMENTS_DAYS=365
RETENTION_HV_CHARGE_SESSIONS_DAYS=1095
RETENTION_HV_CAPACITY_OBSERVATIONS_DAYS=1095
RETENTION_BATTERY_EVIDENCE_SHADOW_DAYS=1095
RETENTION_BATTERY_CAPABILITY_CHANGES_DAYS=90
RETENTION_BATTERY_V2_DEAD_LETTERS_DAYS=90
RETENTION_BATTERY_PUBLICATIONS_DAYS=0
RETENTION_BATTERY_QUALIFIED_EVIDENCE_DAYS=0
RETENTION_BATTERY_RETENTION_AGGREGATES_DAYS=0

# ── Data Retention (DataRetentionScheduler, daily 03:30) ──────────────────────
# Prunes append-only telemetry/log tables. Age windows in DAYS; 0 = disabled.
DATA_RETENTION_ENABLED=true
DATA_RETENTION_BATCH_SIZE=5000
DATA_RETENTION_MAX_BATCHES=500
# Operational logs (sane defaults: enabled)
RETENTION_DIMO_POLL_LOGS_DAYS=30
RETENTION_TRIP_TRACKING_RUNS_DAYS=30
RETENTION_HM_STREAM_SYNC_LOGS_DAYS=14
RETENTION_HM_HEALTH_SYNC_LOGS_DAYS=30
RETENTION_TRIP_REPAIRS_DAYS=365
RETENTION_REFRESH_TOKENS_DAYS=30
# Product / audit / health data (default: disabled — opt in deliberately)
RETENTION_ACTIVITY_LOGS_DAYS=0
RETENTION_TRIP_WAYPOINTS_DAYS=0
RETENTION_TIRE_HEALTH_SNAPSHOTS_DAYS=0
RETENTION_TIRE_WEAR_DATA_POINTS_DAYS=0
RETENTION_BATTERY_EVIDENCE_DAYS=0
RETENTION_HV_BATTERY_SNAPSHOTS_DAYS=0

# ── File Storage ──────────────────────────────────────────────────────────────
# driver: local (disk, default) | s3 (S3-compatible object storage)
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
# Max base64 damage image size (bytes) stored in DB. Default 6 MB.
MAX_DAMAGE_IMAGE_BYTES=6291456
# S3 / S3-compatible (requires: npm i @aws-sdk/client-s3 when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=
# Per-organization storage quota in bytes (0 = disabled)
STORAGE_ORG_QUOTA_BYTES=0

# ── AI Document Upload / Extraction ───────────────────────────────────────────
# Separate, PRIVATE object storage for uploaded vehicle/rental documents
# and generated booking/legal PDFs (DocumentsModule DocumentStoragePort).
# NOT served as public static assets — distinct from STORAGE_DRIVER/S3_* above.
DOCUMENT_STORAGE_PROVIDER=local
# Production: set to s3 and configure DOCUMENT_PRIVATE_S3_* below.
# DOCUMENT_STORAGE_ALLOW_LOCAL_IN_PRODUCTION=false
LOCAL_DOCUMENT_STORAGE_DIR=./storage/documents
LOCAL_DOCUMENT_QUARANTINE_STORAGE_DIR=./storage/documents-quarantine
# Private S3-compatible bucket (production — requires npm i @aws-sdk/client-s3)
# DOCUMENT_PRIVATE_S3_BUCKET=synqdrive-private-documents
