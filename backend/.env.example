# TIRE_WEAR_V3_CUSTOMER_READ_ENABLED=false
# TIRE_WEAR_V3_CUSTOMER_READ_AUTHORITATIVE=false
# Shadow prior writer (P3A) — remains OFF unless explicitly enabled for offline simulation
# TIRE_WEAR_V3_PRIOR_SHADOW_WRITE_ENABLED=false
