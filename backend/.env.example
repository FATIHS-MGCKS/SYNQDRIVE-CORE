# TIRE_WEAR_V3_CALIBRATION_SHADOW_WRITE_ENABLED=false
# TIRE_WEAR_V3_CALIBRATION_SHADOW_BATCH_SIZE=25
# TIRE_WEAR_V3_CALIBRATION_SHADOW_INTERVAL_MS=900000

# Physical device inventory P1B.1 (identity verify + install writes; default OFF in production)
# PHYSICAL_DEVICE_INVENTORY_P1B1_WRITES_ENABLED=false
# PHYSICAL_DEVICE_INVENTORY_P1B2_WRITES_ENABLED=false
